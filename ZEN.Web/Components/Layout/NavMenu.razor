@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using ZEN.Shared
@inject IStringLocalizer<SharedResource> L

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
        @L["Dashboard"]
    </MudNavLink>

    <AuthorizeView Roles="Administrator,Cashier,Manager">
        <MudNavGroup Title="@L["Sales"]" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
            <MudNavLink Href="/pos" Icon="@Icons.Material.Filled.ShoppingCart">@L["POS"]</MudNavLink>
            <MudNavLink Href="/shifts" Icon="@Icons.Material.Filled.Schedule">@L["Shifts"]</MudNavLink>
            <MudNavLink Href="/held-sales" Icon="@Icons.Material.Filled.Pause">@L["HeldSales"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,InventoryManager">
        <MudNavGroup Title="@L["Products"]" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
            <MudNavLink Href="/products" Icon="@Icons.Material.Filled.Category">@L["Products"]</MudNavLink>
            <MudNavLink Href="/taxes" Icon="@Icons.Material.Filled.Percent">@L["Taxes"]</MudNavLink>
            @* <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Label">Categories</MudNavLink> *@
            @* <MudNavLink Href="/brands" Icon="@Icons.Material.Filled.Loyalty">Brands</MudNavLink> *@
            @* <MudNavLink Href="/discounts" Icon="@Icons.Material.Filled.LocalOffer">Discounts</MudNavLink> *@
            <MudNavLink Href="/promotions" Icon="@Icons.Material.Filled.Campaign">@L["Promotions"]</MudNavLink>
            @* <MudNavLink Href="/coupons" Icon="@Icons.Material.Filled.Campaign">Coupons</MudNavLink> *@
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,InventoryManager">
        <MudNavGroup Title="@L["Inventory"]" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
            <MudNavLink Href="/inventory" Icon="@Icons.Material.Filled.Inventory2">@L["Stock"]</MudNavLink>
            <MudNavLink Href="/stock-purchases" Icon="@Icons.Material.Filled.ReceiptLong">@L["Stock Purchase"]</MudNavLink>
            <MudNavLink Href="/warehouses" Icon="@Icons.Material.Filled.Store">@L["Warehouses"]</MudNavLink>
            <MudNavLink Href="/purchase-orders" Icon="@Icons.Material.Filled.ShoppingBag">@L["PurchaseOrders"]</MudNavLink>
            <MudNavLink Href="/stock-transfers" Icon="@Icons.Material.Filled.LocalShipping">@L["Stock Transfer"]</MudNavLink>
            <MudNavLink Href="/inventory-counts" Icon="@Icons.Material.Filled.Checklist">@L["Counts"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,Cashier">
        <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.People" IconColor="Color.Primary">
            @L["Customers"]
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,InventoryManager,Accountant">
        <MudNavLink Href="/suppliers" Icon="@Icons.Material.Filled.Business" IconColor="Color.Primary">
            @L["Suppliers"]
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,Accountant">
        <MudNavGroup Title="@L["Reports"]" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
            <MudNavLink Href="/reports/sales" Icon="@Icons.Material.Filled.TrendingUp">@L["SalesReports"]</MudNavLink>
            <MudNavLink Href="/reports/inventory" Icon="@Icons.Material.Filled.Inventory">@L["InventoryReports"]</MudNavLink>
            <MudNavLink Href="/reports/financial" Icon="@Icons.Material.Filled.AttachMoney">@L["FinancialReports"]</MudNavLink>
            <MudNavLink Href="/reports/employee" Icon="@Icons.Material.Filled.PersonSearch">@L["EmployeeReports"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator">
        <MudNavGroup Title="@L["Admin"]" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.ManageAccounts">@L["Users"]</MudNavLink>
            <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["Roles"]</MudNavLink>
            <MudNavLink Href="/admin/stores" Icon="@Icons.Material.Filled.Storefront">@L["Stores"]</MudNavLink>
            <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Tune">@L["Settings"]</MudNavLink>
            <MudNavLink Href="/admin/audit-logs" Icon="@Icons.Material.Filled.History">@L["AuditLogs"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator,Manager,Technician">
        <MudNavGroup Title="@L["Equipment"]" Icon="@Icons.Material.Filled.SettingsInputComponent" Expanded="false">
            <MudNavLink Href="/equipments/printers" Icon="@Icons.Material.Filled.Print">@L["Printers"]</MudNavLink>
            <MudNavLink Href="/equipments/bank-terminals" Icon="@Icons.Material.Filled.Payment">@L["BankTerminals"]</MudNavLink>
            <MudNavLink Href="/equipments/scanners" Icon="@Icons.Material.Filled.QrCodeScanner">@L["Scanners"]</MudNavLink>
            <MudNavLink Href="/equipments/customer-displays" Icon="@Icons.Material.Filled.DisplaySettings">@L["CustomerDisplays"]</MudNavLink>
            <MudNavLink Href="/equipments/cash-desks" Icon="@Icons.Material.Filled.Desk">@L["CashDesks"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <MudDivider Class="my-2" />

    <MudPaper Class="pa-2" Elevation="0">
        <LanguageSelector />
    </MudPaper>
</MudNavMenu>
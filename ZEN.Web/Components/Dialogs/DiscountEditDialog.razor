@using DiscountServiceDto = ZEN.Application.Services.Interfaces.DiscountDto
@using DiscountCreateRequest = ZEN.Application.Services.Interfaces.CreateDiscountRequest
@using DiscountUpdateRequest = ZEN.Application.Services.Interfaces.UpdateDiscountRequest
@using ZEN.Application.Services.Interfaces
@using ZEN.Domain.Entities
@using ZEN.Domain.Interfaces
@using MudBlazor

@inject IDiscountService DiscountService
@inject IRepository<Category> CategoryRepository
@inject IRepository<Product> ProductRepository
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" Spacing="2" Class="align-center">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.LocalOffer : Icons.Material.Filled.Loyalty)"
                     Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsEditMode ? "Modify Discount Rule" : "Create Promotional Discount")</MudText>
                @if (IsEditMode)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">System Rule ID: @Discount!.Id</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="isFormValid">
            <MudGrid Spacing="3" Class="py-2">

                @* ==================== CORE CONFIGURATION ==================== *@
                <MudItem xs="12" sm="8">
                    <MudTextField T="string" Label="Discount Code" @bind-Value="editModel.Code"
                                  Required="true" RequiredError="Administrative identification code is required"
                                  Variant="Variant.Outlined" Placeholder="e.g., WINTER_CLEARANCE_2026"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Label" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="editModel.IsActive" Color="Color.Success"
                               Label="@(editModel.IsActive ? "Rule is Active" : "Rule is Suspended")" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Description / Campaign Notes" @bind-Value="editModel.Description"
                                  Variant="Variant.Outlined" Lines="2" Placeholder="Provide context regarding this price reduction ruleset..." />
                </MudItem>

                @* ==================== MECHANISM & VALUES ==================== *@
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Calculation Type" @bind-Value="editModel.Type"
                               Required="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("FixedAmount")">💵 Fixed Amount Reduction</MudSelectItem>
                        <MudSelectItem Value="@("Percentage")">📈 Percentage Rate Drop</MudSelectItem>
                        <MudSelectItem Value="@("Tiered")">📊 Tiered Volume Structure</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Label="Discount Value" @bind-Value="editModel.Value"
                                     Required="true" RequiredError="Value assignment is required"
                                     Min="0" Variant="Variant.Outlined" Format="N2"
                                     Adornment="Adornment.Start" AdornmentIcon="@GetAdornmentIcon()" />
                </MudItem>

                @* ==================== TIMELINE LIFESPAN ==================== *@
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Valid From Date" @bind-Date="editModel.ValidFrom"
                                   Variant="Variant.Outlined" Editable="true" Clearable="true"
                                   Placeholder="Immediate release criteria" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Valid Until Date" @bind-Date="editModel.ValidTo"
                                   Variant="Variant.Outlined" Editable="true" Clearable="true"
                                   Placeholder="Infinite system lifecycle" />
                </MudItem>

                @* ==================== APPLICATION SCOPE CONDITIONS ==================== *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Target Criteria Conditions</MudText>
                    <MudPaper Variant="Variant.Outlined" Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                        <MudCheckBox T="bool" @bind-Value="includeAllProducts" Color="Color.Primary"
                                     Label="Global Scope (Apply rule uniformly to all stock entries)" Class="mb-2" />

                        @if (!includeAllProducts)
                        {
                            <MudGrid Spacing="2" Class="pt-2">
                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="Category"
                                                     Label="Target Category Scope"
                                                     @bind-Value="selectedCategory"
                                                     SearchFunc="SearchCategories"
                                                     ToStringFunc="@(c => c?.Name ?? "")"
                                                     Variant="Variant.Outlined"
                                                     Dense="true" Placeholder="Search inventories..."
                                                     Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Category" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="Product"
                                                     Label="Target Specific Product"
                                                     @bind-Value="selectedProduct"
                                                     SearchFunc="SearchProducts"
                                                     ToStringFunc="@(p => p?.Name ?? "")"
                                                     Variant="Variant.Outlined"
                                                     Dense="true" Placeholder="Search sku catalog..."
                                                     Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Inventory2" />
                                </MudItem>
                            </MudGrid>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Class="px-6 py-4 w-100 justify-end" Spacing="2">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Class="px-4">Dismiss</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDiscount"
                       Disabled="!isFormValid" StartIcon="@Icons.Material.Filled.CheckCircle" Class="px-6">
                Commit Strategy
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public DiscountServiceDto? Discount { get; set; }

    private MudForm form = null!;
    private bool isFormValid = false;
    private DiscountEditModel editModel = new();
    private bool includeAllProducts = true;
    private Category? selectedCategory;
    private Product? selectedProduct;
    private List<Category> categories = [];
    private List<Product> products = [];
    private bool IsEditMode => Discount is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = (await CategoryRepository.GetAllAsync()).ToList();
            products = (await ProductRepository.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Infrastructure lookup failed: {ex.Message}", Severity.Warning);
        }

        if (Discount is not null)
        {
            editModel = new DiscountEditModel
            {
                Code = Discount.Code,
                Description = Discount.Description,
                Type = Discount.Type,
                Value = Discount.Value,
                ValidFrom = Discount.ValidFrom,
                ValidTo = Discount.ValidTo,
                IsActive = Discount.IsActive
            };

            // If the model contains specific conditions/scoping targets, initialize selection state here
            includeAllProducts = Discount.Conditions == null || !Discount.Conditions.Any();
        }
    }

    private string GetAdornmentIcon()
    {
        return editModel.Type switch
        {
            "Percentage" => Icons.Material.Filled.Percent,
            "Tiered" => Icons.Material.Filled.Layers,
            _ => Icons.Material.Filled.AttachMoney
        };
    }

    private Task<IEnumerable<Category>> SearchCategories(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<Category>>(categories);
        return Task.FromResult<IEnumerable<Category>>(categories.Where(c => c.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<Product>> SearchProducts(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<Product>>(products);
        return Task.FromResult<IEnumerable<Product>>(products.Where(p => p.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task SaveDiscount()
    {
        await form.Validate();
        if (!isFormValid) return;

        // Sync local scoping condition maps back to business rules list layout
        editModel.Conditions.Clear();
        if (!includeAllProducts)
        {
            if (selectedCategory != null) editModel.Conditions.Add($"Category:{selectedCategory.Id}");
            if (selectedProduct != null) editModel.Conditions.Add($"Product:{selectedProduct.Id}");
        }

        try
        {
            DiscountServiceDto result;
            if (Discount == null)
            {
                var request = new DiscountCreateRequest(
                    editModel.Code,
                    editModel.Description,
                    editModel.Type,
                    editModel.Value,
                    editModel.ValidFrom,
                    editModel.ValidTo,
                    editModel.IsActive,
                    editModel.Conditions);
                result = await DiscountService.CreateAsync(request);
            }
            else
            {
                var request = new DiscountUpdateRequest(
                    Discount.Id,
                    editModel.Code,
                    editModel.Description,
                    editModel.Type,
                    editModel.Value,
                    editModel.ValidFrom,
                    editModel.ValidTo,
                    editModel.IsActive,
                    editModel.Conditions);
                result = await DiscountService.UpdateAsync(request);
            }

            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error mutating discount rules engine context: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class DiscountEditModel
    {
        public string Code { get; set; } = "";
        public string? Description { get; set; }
        public string Type { get; set; } = "FixedAmount";
        public decimal Value { get; set; }
        public DateTime? ValidFrom { get; set; }
        public DateTime? ValidTo { get; set; }
        public bool IsActive { get; set; } = true;
        public List<string> Conditions { get; set; } = [];
    }
}
@using Microsoft.Extensions.Localization
@using ZEN.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Confirmation"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Text</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="No">@L["No"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Yes">@L["Yes"]</MudButton>
    </DialogActions>
</MudDialog>
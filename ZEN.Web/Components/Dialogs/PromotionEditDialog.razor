@using PromotionServiceDto = ZEN.Application.Services.Interfaces.PromotionDto
@using PromotionDiscountDto = ZEN.Application.Services.Interfaces.DiscountDto
@using PromotionCreateRequest = ZEN.Application.Services.Interfaces.CreatePromotionRequest
@using PromotionUpdateRequest = ZEN.Application.Services.Interfaces.UpdatePromotionRequest
@using ZEN.Application.Services.Interfaces
@using MudBlazor

@inject IPromotionService PromotionService
@inject IDiscountService DiscountService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" Spacing="2" Class="align-center">
            <MudIcon Icon="@(Promotion == null ? Icons.Material.Filled.Campaign : Icons.Material.Filled.EditCalendar)"
                     Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(Promotion == null ? "Create New Promotion" : "Modify Campaign Setup")</MudText>
                @if (Promotion != null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">System Campaign ID: @Promotion.Id</MudText>
                }
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="isFormValid">
            <MudGrid Spacing="3" Class="py-2">

                @* ==================== CORE METADATA SECTION ==================== *@
                <MudItem xs="12">
                    <MudTextField T="string" Label="Promotion Name" @bind-Value="editModel.Name"
                                  Required="true" RequiredError="Campaign identity name is required"
                                  Variant="Variant.Outlined" Placeholder="e.g., Anniversary Weekend Super Sale"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Assignment" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="editModel.Description"
                                  Variant="Variant.Outlined" Lines="2" Placeholder="Provide context displayed on retail outlets or receipts..." />
                </MudItem>

                @* ==================== STATUS & TIMELINE ==================== *@
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Workflow Status" @bind-Value="editModel.Status"
                               Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required="true">
                        <MudSelectItem Value="@("Draft")">📝 Draft Setup</MudSelectItem>
                        <MudSelectItem Value="@("Scheduled")">📅 Scheduled Sync</MudSelectItem>
                        <MudSelectItem Value="@("Active")">⚡ Live Active</MudSelectItem>
                        <MudSelectItem Value="@("Completed")">🏁 Completed</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudStack Row="true" Spacing="2">
                        <MudDatePicker Label="Start Date" @bind-Date="editModel.StartDate" Required="true" Variant="Variant.Outlined" Editable="true" />
                        <MudDatePicker Label="End Date" @bind-Date="editModel.EndDate" Variant="Variant.Outlined" Clearable="true" Editable="true" />
                    </MudStack>
                </MudItem>

                @* ==================== MAPPED ARCHITECTURAL RULES ==================== *@
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudStack Row="true" Class="justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-1 vertical-align-middle" />
                            Targeted Rules Configuration
                        </MudText>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">
                            @editModel.DiscountIds.Count rules mapped
                        </MudChip>
                    </MudStack>

                    @if (availableDiscounts.Any())
                    {
                        <MudPaper Outlined="true" Class="pa-2" Style="max-height: 220px; overflow-y: auto; background-color: var(--mud-palette-background-grey);">
                            @foreach (var discount in availableDiscounts)
                            {
                                var currentId = discount.Id;
                                var isChecked = editModel.DiscountIds.Contains(currentId);

                                <MudCheckBox T="bool"
                                             Value="@isChecked"
                                             ValueChanged="@((bool selected) => ToggleDiscount(currentId, selected))"
                                             Color="Color.Primary"
                                             Dense="true"
                                             Class="pa-2 my-1 d-flex align-center rounded hover-lighten"
                                             Label="@($"{discount.Code} • {discount.Description ?? "No description template assigned"}")" />
                            }
                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-1">
                            No available active discounts found. Generate a discount template rule first.
                        </MudAlert>
                    }
                </MudItem>

                @* ==================== ARCHIVE CONTROLS ==================== *@
                @if (Promotion != null)
                {
                    <MudItem xs="12" Class="pt-0">
                        <MudPaper Class="pa-3 border-dashed border-mud-error" Style="background-color: rgba(255,0,0,0.03);" Outlined="true">
                            <MudCheckBox T="bool" @bind-Value="editModel.IsArchived" Color="Color.Error"
                                         Label="Archive this campaign (Instantly hide from all retail outlet and POS registers)" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Class="px-6 py-4 w-100 justify-end" Spacing="2">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Class="px-4">Discard Changes</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePromotion"
                       Disabled="!isFormValid" StartIcon="@Icons.Material.Filled.CloudUpload" Class="px-6">
                Commit Strategy
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public PromotionServiceDto? Promotion { get; set; }

    private MudForm form = null!;
    private bool isFormValid = false;
    private PromotionEditModel editModel = new();
    private List<PromotionDiscountDto> availableDiscounts = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fully evaluate immediately inside separate call logic execution thread frame
            var result = await DiscountService.GetActiveAsync();
            availableDiscounts = result?.ToList() ?? new List<PromotionDiscountDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Infrastructure trace warning: {ex.Message}", Severity.Warning);
        }

        if (Promotion is not null)
        {
            editModel = new PromotionEditModel
            {
                Name = Promotion.Name,
                Description = Promotion.Description,
                StartDate = Promotion.StartDate,
                EndDate = Promotion.EndDate,
                Status = Promotion.Status,
                DiscountIds = Promotion.DiscountIds?.ToList() ?? [],
                IsArchived = Promotion.IsArchived
            };
        }
        else
        {
            editModel.StartDate = DateTime.Today;
            editModel.EndDate = DateTime.Today.AddMonths(1);
            editModel.Status = "Draft";
            editModel.IsArchived = false;
        }
    }

    private void ToggleDiscount(Guid discountId, bool selected)
    {
        if (selected)
        {
            if (!editModel.DiscountIds.Contains(discountId))
            {
                editModel.DiscountIds.Add(discountId);
            }
        }
        else
        {
            editModel.DiscountIds.Remove(discountId);
        }
    }

    private async Task SavePromotion()
    {
        await form.Validate();
        if (!isFormValid) return;

        try
        {
            PromotionServiceDto result;
            if (Promotion == null)
            {
                var request = new PromotionCreateRequest(
                    editModel.Name,
                    editModel.Description,
                    editModel.StartDate,
                    editModel.EndDate,
                    editModel.Status,
                    editModel.DiscountIds);

                result = await PromotionService.CreateAsync(request);
            }
            else
            {
                var request = new PromotionUpdateRequest(
                    Promotion.Id,
                    editModel.Name,
                    editModel.Description,
                    editModel.StartDate,
                    editModel.EndDate,
                    editModel.Status,
                    editModel.DiscountIds,
                    editModel.IsArchived);

                result = await PromotionService.UpdateAsync(request);
            }

            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving ruleset configuration engine: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class PromotionEditModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string Status { get; set; } = "Draft";
        public List<Guid> DiscountIds { get; set; } = [];
        public bool IsArchived { get; set; }
    }
}
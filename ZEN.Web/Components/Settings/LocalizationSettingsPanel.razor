@using MudBlazor
@using Microsoft.Extensions.Localization
@using ZEN.Shared
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<MudStack Spacing="4">
    <MudText Typo="Typo.subtitle1">@L["LocalizationSettings"]</MudText>

    <MudForm @ref="form" @bind-IsValid="isFormValid">
        <MudStack Spacing="3">
            <MudSelect T="string" Label="@L["DefaultLanguage"]" @bind-Value="language"
                      Variant="Variant.Outlined">
                <MudSelectItem Value="@("en")">@L["English"]</MudSelectItem>
                <MudSelectItem Value="@("ro")">@L["Romanian"]</MudSelectItem>
                <MudSelectItem Value="@("ru")">@L["Russian"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" Label="@L["DefaultCurrency"]" @bind-Value="currency"
                      Variant="Variant.Outlined">
                <MudSelectItem Value="@("USD")">USD - US Dollar</MudSelectItem>
                <MudSelectItem Value="@("EUR")">EUR - Euro</MudSelectItem>
                <MudSelectItem Value="@("GBP")">GBP - British Pound</MudSelectItem>
                <MudSelectItem Value="@("CAD")">CAD - Canadian Dollar</MudSelectItem>
                <MudSelectItem Value="@("AUD")">AUD - Australian Dollar</MudSelectItem>
                <MudSelectItem Value="@("JPY")">JPY - Japanese Yen</MudSelectItem>
                <MudSelectItem Value="@("CNY")">CNY - Chinese Yuan</MudSelectItem>
            </MudSelect>

            <MudTextField T="string" Label="@L["CurrencySymbol"]" @bind-Value="currencySymbol"
                         Variant="Variant.Outlined"
                         HelperText="Symbol to display (e.g., $, €, £)" />

            <MudSelect T="string" Label="@L["DecimalSeparator"]" @bind-Value="decimalSeparator"
                      Variant="Variant.Outlined">
                <MudSelectItem Value="@(".")">Dot (.)</MudSelectItem>
                <MudSelectItem Value="@(",")">Comma (,)</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" Label="@L["ThousandsSeparator"]" @bind-Value="thousandsSeparator"
                      Variant="Variant.Outlined">
                <MudSelectItem Value="@(",")">Comma (,)</MudSelectItem>
                <MudSelectItem Value="@(" ")">Space</MudSelectItem>
                <MudSelectItem Value="@("")">None</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLocalizationSettings">
                @L["Save"]
            </MudButton>
        </MudStack>
    </MudForm>
</MudStack>

@code {
    private MudForm form = null!;
    private bool isFormValid = true;

    private string language = "en";
    private string currency = "USD";
    private string currencySymbol = "$";
    private string decimalSeparator = ".";
    private string thousandsSeparator = ",";

    [Inject] private ISnackbar SnackbarLocal { get; set; } = null!;

    private async Task SaveLocalizationSettings()
    {
        try
        {
            SnackbarLocal.Add(L["LocalizationSettingsSaved"], Severity.Success);
        }
        catch (Exception ex)
        {
            SnackbarLocal.Add($"{L["ErrorSavingSettings"]}: {ex.Message}", Severity.Error);
        }
    }
}

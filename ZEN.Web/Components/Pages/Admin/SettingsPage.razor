@page "/admin/settings"
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>System Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Spacing="4">
        <MudStack Row="true" Class="justify-between align-center">
            <MudText Typo="Typo.h4">Settings</MudText>
        </MudStack>

        <MudTabs ApplyEffectsToContainer="true" PanelClass="pa-8">
            <MudTabPanel Text="General Settings" Icon="@Icons.Material.Filled.Settings">
                <GeneralSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="Localization" Icon="@Icons.Material.Filled.Language">
                <LocalizationSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="Receipt Format" Icon="@Icons.Material.Filled.Receipt">
                <ReceiptSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="Integration" Icon="@Icons.Material.Filled.Link">
                <IntegrationSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="Backup & Data" Icon="@Icons.Material.Filled.Backup">
                <BackupSettingsPanel />
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>


@page "/admin/settings"
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ZEN.Shared
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Settings"] - @L["AppName"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Spacing="4">
        <MudStack Row="true" Class="justify-between align-center">
            <MudText Typo="Typo.h4">@L["Settings"]</MudText>
        </MudStack>

        <MudTabs ApplyEffectsToContainer="true" PanelClass="pa-8">
            <MudTabPanel Text="@L["GeneralSettings"]" Icon="@Icons.Material.Filled.Settings">
                <GeneralSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="@L["LocalizationSettings"]" Icon="@Icons.Material.Filled.Language">
                <LocalizationSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="@L["ReceiptSettings"]" Icon="@Icons.Material.Filled.Receipt">
                <ReceiptSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="@L["IntegrationSettings"]" Icon="@Icons.Material.Filled.Link">
                <IntegrationSettingsPanel />
            </MudTabPanel>

            <MudTabPanel Text="@L["BackupSettings"]" Icon="@Icons.Material.Filled.Backup">
                <BackupSettingsPanel />
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>


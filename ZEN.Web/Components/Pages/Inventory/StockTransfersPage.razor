@page "/stock-transfers"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Domain.Enums
@using ZEN.Application.DTOs.Inventory
@using ZEN.Application.Services.Interfaces
@using ZEN.Domain.Entities
@using ZEN.Domain.Interfaces
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IWarehouseService WarehouseService
@inject global::ZEN.Domain.Interfaces.IRepository<Store> StoreRepository

@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

@* <ZEN.Shared.Components.Common.PageTitle>Stock Transfers - ZEN POS</ZEN.Shared.Components.Common.PageTitle> *@

<Microsoft.AspNetCore.Components.Web.PageTitle>Stock Transfers - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Inter-Warehouse Stock Transfers</MudText>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudSelect T="Guid?" Label="Warehouse" Variant="Variant.Outlined" Value="_selectedWarehouseId" ValueChanged="OnWarehouseChanged" Style="min-width: 250px;">
            <MudSelectItem T="Guid?" Value="@(null)">Select warehouse</MudSelectItem>
            @foreach (var warehouse in _warehouses)
            {
                <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />

        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenCreateDialog">
            Create Transfer
        </MudButton>
    </div>

    <MudAlert Severity="Severity.Info" Class="mb-4">
        <strong>Stock Transfers Module:</strong> Move inventory between warehouses within the same store. Track transfer status from pending to approved to completed.
    </MudAlert>

        <MudTable T="WarehouseDto" Items="@_warehouses" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Stock Transfers List</MudText>
        </ToolBarContent>
        <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Store</MudTh>
                <MudTh>Main</MudTh>
                <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="warehouse">
            <MudTd DataLabel="Code">@warehouse.Code</MudTd>
            <MudTd DataLabel="Name">@warehouse.Name</MudTd>
            <MudTd DataLabel="Store">@warehouse.StoreName</MudTd>
            <MudTd DataLabel="Main">@(warehouse.IsMain ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(warehouse.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(warehouse.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudText Typo="Typo.body2">Available</MudText>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

<!-- Create/Edit Dialog -->
<MudDialog @bind-Visible="_isDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditMode ? "Edit Transfer" : "Create Stock Transfer")</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info">
            Complete Stock Transfer form will include:
            <ul>
                <li>Source warehouse selection (filtered by store)</li>
                <li>Destination warehouse selection (same store only)</li>
                <li>Product line items with available quantities</li>
                <li>Quantity per item entry</li>
                <li>Transfer date and notes</li>
                <li>Approval workflow status</li>
            </ul>
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CloseDialog">
            @(_isEditMode ? "Update Transfer" : "Create Transfer")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<WarehouseDto> _warehouses = new();
    private Guid? _selectedWarehouseId;
    private bool _isLoading = false;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
    }

    private async Task LoadWarehousesAsync()
    {
        try
        {
            var stores = await StoreRepository.FindAsync(s => s.IsActive);
            var warehouses = new List<WarehouseDto>();

            foreach (var store in stores)
            {
                warehouses.AddRange(await WarehouseService.GetActiveByStoreAsync(store.Id));
            }

            _warehouses = warehouses;
            _selectedWarehouseId ??= _warehouses.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading warehouses: {ex.Message}", Severity.Error);
        }
    }

    private Task OnWarehouseChanged(Guid? warehouseId)
    {
        _selectedWarehouseId = warehouseId;
        return Task.CompletedTask;
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        _isDialogOpen = false;
        Snackbar.Add("Stock transfer feature coming soon", Severity.Info);
    }
}

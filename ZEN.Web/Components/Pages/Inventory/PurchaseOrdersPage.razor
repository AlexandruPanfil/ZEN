@page "/purchase-orders"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.DTOs.Inventory
@using ZEN.Application.DTOs.Products
@using ZEN.Application.DTOs.Suppliers
@using ZEN.Application.Services.Interfaces
@using ZEN.Domain.Enums
@using ZEN.Domain.Entities
@using ZEN.Domain.Interfaces
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject IWarehouseService WarehouseService
@inject IProductService ProductService
@inject IStoreContext StoreContext
@inject global::ZEN.Domain.Interfaces.IRepository<Store> StoreRepository
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Purchase Orders - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Primary">Purchase Orders</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Procure stock from commercial vendors, verify inbound items, and route product inventory allocations.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   OnClick="OpenCreateDialog">
            Create Purchase Order
        </MudButton>
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Active Records</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FilteredPurchaseOrders.Count()</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Draft Orders Pending</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_purchaseOrders.Count(p => p.Status == PurchaseOrderStatus.Draft)</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Success" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Document Valuation</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FilteredPurchaseOrders.Sum(p => p.TotalAmount).ToString("C")</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Class="align-center mb-2">
            <MudItem xs="12" md="6" lg="7">
                <MudTextField T="string"
                              Placeholder="Filter by order #, supplier name, or fulfillment details..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              @bind-Value="_searchTerm"
                              Immediate="true"
                              Clearable="true"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6" lg="5">
                <MudSelect T="Guid?"
                           Label="Warehouse Distribution Node"
                           Variant="Variant.Outlined"
                           Value="_selectedWarehouseId"
                           ValueChanged="OnWarehouseChanged"
                           Margin="Margin.Dense">
                    <MudSelectItem T="Guid?" Value="@(null)">All Available Stores & Warehouses</MudSelectItem>
                    @foreach (var warehouse in _warehouses)
                    {
                        <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable T="PurchaseOrderDto" Items="@FilteredPurchaseOrders" Hover="true" Striped="true" Elevation="1" Breakpoint="Breakpoint.Md" Loading="@_isLoading">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Procurement Directory Ledger</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.Number)">Order #</MudTableSortLabel></MudTh>
            <MudTh>Supplier Partner</MudTh>
            <MudTh>Target Warehouse</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.OrderDate)">Issued Date</MudTableSortLabel></MudTh>
            <MudTh>Expected Delivery</MudTh>
            <MudTh>Fulfillment Status</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.TotalAmount)">Financial Valuation</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: right; min-width: 220px;">Control Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="order">
            <MudTd DataLabel="Order #" Class="font-weight-bold">@order.Number</MudTd>
            <MudTd DataLabel="Supplier">@order.SupplierName</MudTd>
            <MudTd DataLabel="Warehouse">
                <span class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                    @order.WarehouseName
                </span>
            </MudTd>
            <MudTd DataLabel="Order Date">@order.OrderDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Expected Date">@(order.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(order.Status)" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                    @order.Status
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Total" Class="font-weight-bold color-primary">@order.TotalAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                <MudTooltip Text="Inspect Manifest">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Class="mr-1" OnClick="@(() => ViewDetails(order))" />
                </MudTooltip>
                <MudTooltip Text="Modify Structure">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-1" OnClick="@(() => OpenEditDialog(order))" />
                </MudTooltip>
                <MudTooltip Text="Approve & Commit Manifest">
                    <MudIconButton Icon="@Icons.Material.Filled.Done" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" Class="mr-1" Disabled="@(order.Status != PurchaseOrderStatus.Draft)" OnClick="@(() => ApproveOrder(order))" />
                </MudTooltip>
                <MudTooltip Text="Abort Procure Cycle">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="mr-1" Disabled="@(order.Status is PurchaseOrderStatus.Cancelled or PurchaseOrderStatus.Received)" OnClick="@(() => CancelOrder(order))" />
                </MudTooltip>
                <MudTooltip Text="Purge Record Draft">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="@(order.Status != PurchaseOrderStatus.Draft)" OnClick="@(() => DeleteOrder(order))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-4 color-secondary">No purchase orders meet current spatial filter parameters.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Items per spreadsheet context:" />
        </PagerContent>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.Layers : Icons.Material.Filled.NoteAdd)" Class="mr-2" />
            @(_isEditMode ? $"Modify Order Profile Struct: {_editingModel.Number}" : "Draft Inbound Inventory Route Request")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="py-2">
            <MudGrid>
                @if (!_isEditMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" Label="Commercial Supplier Partner" Variant="Variant.Outlined" @bind-Value="_editingModel.SupplierId" Required="true" Margin="Margin.Dense">
                            @foreach (var supplier in _suppliers)
                            {
                                <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" Label="Target Depot / Warehouse Location" Variant="Variant.Outlined" @bind-Value="_editingModel.WarehouseId" Required="true" Margin="Margin.Dense">
                            @foreach (var warehouse in _warehouses)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" Label="Vendor Context Entity" Value="@_editingModel.SupplierName" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" Label="Assigned Receiving Store Node" Value="@_editingModel.WarehouseName" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="PurchaseOrderStatus" Label="Transition State Status" Variant="Variant.Outlined" @bind-Value="_editingModel.Status" Margin="Margin.Dense">
                            @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
                            {
                                <MudSelectItem T="PurchaseOrderStatus" Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Target Expected Logistics Window" Variant="Variant.Outlined" @bind-Date="_editingModel.ExpectedDate" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Operational Workflow Context Notes" Variant="Variant.Outlined" @bind-Value="_editingModel.Notes" Lines="2" Multiline="true" />
                </MudItem>

                @if (!_isEditMode)
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <div class="d-flex align-center justify-space-between mb-3">
                            <MudText Typo="Typo.h6" Class="font-weight-bold color-primary">Product Stock Matrix Items</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddLineItem">Add Item Entry</MudButton>
                        </div>

                        <div style="max-height: 280px; overflow-y: auto;" class="pe-2">
                            @foreach (var item in _editingModel.Items)
                            {
                                <MudGrid Class="align-center mb-1" Spacing="2">
                                    <MudItem xs="12" sm="5">
                                        <MudSelect T="Guid?" Label="Select Inventory Item" Variant="Variant.Outlined" @bind-Value="item.ProductId" Required="true" Margin="Margin.Dense">
                                            @foreach (var product in _products)
                                            {
                                                <MudSelectItem T="Guid?" Value="@product.Id">@product.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal" Label="Quantity Ordered" Variant="Variant.Outlined" @bind-Value="item.Quantity" Min="0.01m" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudNumericField T="decimal" Label="Contract Unit Cost" Variant="Variant.Outlined" @bind-Value="item.UnitPrice" Min="0.00m" Format="C" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="2" Class="d-flex align-center justify-end">
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Error" Size="Size.Medium" Disabled="@(_editingModel.Items.Count <= 1)" OnClick="@(() => RemoveLineItem(item))" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SavePurchaseOrder">Commit Purchase Context</MudButton>
    </DialogActions>
</MudDialog>

@if (_selectedOrder is not null)
{
    <MudDialog @bind-Visible="_isDetailsOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
        <TitleContent>
            <MudText Typo="Typo.h6" Class="font-weight-bold color-primary">
                <MudIcon Icon="@Icons.Material.Filled.FindInPage" Class="mr-2" />
                Manifest Record: @_selectedOrder.Number
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3" Class="py-1">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Supplier: <strong>@_selectedOrder.SupplierName</strong></MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_selectedOrder.Status)" Variant="Variant.Text" Class="font-weight-bold">@_selectedOrder.Status</MudChip>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-n1">Warehouse: <strong>@_selectedOrder.WarehouseName</strong></MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-n1">Target Window: <strong>@(_selectedOrder.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</strong></MudText>

                <MudDivider Class="my-2" />

                <MudTable T="PurchaseOrderItemDto" Items="@_selectedOrder.Items" Dense="true" Hover="true" Elevation="0" Outlined="true">
                    <HeaderContent>
                        <MudTh>Product Context Name</MudTh>
                        <MudTh Style="text-align: right;">Qty</MudTh>
                        <MudTh Style="text-align: right;">Unit Cost</MudTh>
                        <MudTh Style="text-align: right;">Extended Total</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd DataLabel="Product">@item.ProductName</MudTd>
                        <MudTd DataLabel="Qty" Style="text-align: right;">@item.Quantity</MudTd>
                        <MudTd DataLabel="Unit Price" Style="text-align: right;">@item.UnitPrice.ToString("C")</MudTd>
                        <MudTd DataLabel="Total" Style="text-align: right;" Class="font-weight-bold text-success">@item.Total.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-space-between align-center mt-2 px-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Inbound Valuation Summary:</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold color-success">@_selectedOrder.TotalAmount.ToString("C")</MudText>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Primary" OnClick="CloseDetailsDialog" Variant="Variant.Text">Dismiss View</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<PurchaseOrderDto> _purchaseOrders = new();
    private List<SupplierDto> _suppliers = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ProductDto> _products = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = false;
    private bool _isDialogOpen = false;
    private bool _isDetailsOpen = false;
    private bool _isEditMode = false;
    private Guid? _currentStoreId;
    private Guid? _selectedWarehouseId;
    private PurchaseOrderDto? _selectedOrder;
    private PurchaseOrderFormModel _editingModel = new();

    protected override async Task OnInitializedAsync()
    {
        _currentStoreId = StoreContext.GetCurrentStoreId();
        await LoadLookupsAsync();
        await LoadPurchaseOrdersAsync();
    }

    private IEnumerable<PurchaseOrderDto> FilteredPurchaseOrders => _purchaseOrders.Where(p =>
        string.IsNullOrWhiteSpace(_searchTerm) ||
        p.Number.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
        p.SupplierName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
        p.WarehouseName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task LoadLookupsAsync()
    {
        try
        {
            _suppliers = (await SupplierService.GetAllAsync()).ToList();
            _products = (await ProductService.GetAllAsync(_currentStoreId)).ToList();

            var warehouses = new List<WarehouseDto>();

            if (_currentStoreId.HasValue)
            {
                warehouses.AddRange(await WarehouseService.GetActiveByStoreAsync(_currentStoreId.Value));
            }
            else
            {
                var stores = await StoreRepository.FindAsync(s => s.IsActive);

                foreach (var store in stores)
                {
                    warehouses.AddRange(await WarehouseService.GetActiveByStoreAsync(store.Id));
                }
            }

            _warehouses = warehouses;
            _selectedWarehouseId ??= _warehouses.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadPurchaseOrdersAsync()
    {
        _isLoading = true;
        try
        {
            if (_selectedWarehouseId.HasValue)
            {
                _purchaseOrders = (await PurchaseOrderService.GetByWarehouseAsync(_selectedWarehouseId.Value)).ToList();
            }
            else
            {
                _purchaseOrders = [];
                Snackbar.Add("Select an operational warehouse node to inspect active data parameters.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnWarehouseChanged(Guid? warehouseId)
    {
        _selectedWarehouseId = warehouseId;
        await LoadPurchaseOrdersAsync();
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingModel = new PurchaseOrderFormModel
        {
            WarehouseId = _selectedWarehouseId,
            ExpectedDate = DateTime.Today.AddDays(7),
            Items = [new PurchaseOrderLineModel()]
        };
        _isDialogOpen = true;
    }

    private void OpenEditDialog(PurchaseOrderDto order)
    {
        _isEditMode = true;
        _editingModel = new PurchaseOrderFormModel
        {
            Id = order.Id,
            Number = order.Number,
            SupplierId = order.SupplierId,
            SupplierName = order.SupplierName,
            WarehouseId = order.WarehouseId,
            WarehouseName = order.WarehouseName,
            ExpectedDate = order.ExpectedDate,
            Notes = string.Empty,
            Status = order.Status,
            Items = order.Items.Select(i => new PurchaseOrderLineModel
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList()
        };
        _isDialogOpen = true;
    }

    private void ViewDetails(PurchaseOrderDto order)
    {
        _selectedOrder = order;
        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
    {
        _isDetailsOpen = false;
        _selectedOrder = null;
    }

    private void AddLineItem() => _editingModel.Items.Add(new PurchaseOrderLineModel());

    private void RemoveLineItem(PurchaseOrderLineModel item)
    {
        if (_editingModel.Items.Count > 1)
        {
            _editingModel.Items.Remove(item);
        }
    }

    private async Task SavePurchaseOrder()
    {
        try
        {
            if (_isEditMode)
            {
                var request = new UpdatePurchaseOrderRequest(
                    _editingModel.Id,
                    _editingModel.ExpectedDate,
                    _editingModel.Notes,
                    _editingModel.Status);

                await PurchaseOrderService.UpdateAsync(request);
                Snackbar.Add("Purchase order record modified successfully.", Severity.Success);
            }
            else
            {
                if (!_editingModel.SupplierId.HasValue || !_editingModel.WarehouseId.HasValue)
                {
                    Snackbar.Add("Supplier and target allocation metrics are mandatory properties.", Severity.Warning);
                    return;
                }

                var items = _editingModel.Items
                    .Where(i => i.ProductId.HasValue && i.Quantity > 0 && i.UnitPrice >= 0)
                    .Select(i => new CreatePurchaseOrderItemRequest(i.ProductId!.Value, i.Quantity, i.UnitPrice))
                    .ToList();

                if (items.Count == 0)
                {
                    Snackbar.Add("Specify at least one distinct item manifest entry line.", Severity.Warning);
                    return;
                }

                var request = new CreatePurchaseOrderRequest(
                    _editingModel.SupplierId.Value,
                    _editingModel.WarehouseId.Value,
                    _editingModel.ExpectedDate,
                    _editingModel.Notes,
                    items);

                await PurchaseOrderService.CreateAsync(request);
                Snackbar.Add("Inbound purchase manifest established successfully.", Severity.Success);
            }

            CloseDialog();
            await LoadPurchaseOrdersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ApproveOrder(PurchaseOrderDto order)
    {
        try
        {
            if (await PurchaseOrderService.ApproveAsync(order.Id))
            {
                Snackbar.Add("Purchase order status committed and approved successfully.", Severity.Success);
                await LoadPurchaseOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CancelOrder(PurchaseOrderDto order)
    {
        try
        {
            if (await PurchaseOrderService.CancelAsync(order.Id))
            {
                Snackbar.Add("Target distribution workflow halted and cancelled.", Severity.Warning);
                await LoadPurchaseOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteOrder(PurchaseOrderDto order)
    {
        var parameters = new DialogParameters { ["Text"] = $"Are you sure you want to drop purchase document draft {order.Number}?" };
        var dialog = await DialogService.ShowAsync<global::ZEN.Shared.Components.Common.ConfirmDialog>("Purge Record Struct", parameters);
        var result = await dialog.Result;

        if (result?.Data is bool confirmed && confirmed)
        {
            try
            {
                if (await PurchaseOrderService.DeleteAsync(order.Id))
                {
                    Snackbar.Add("Document entity deleted out of active registry contexts.", Severity.Success);
                    await LoadPurchaseOrdersAsync();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;

    private static Color GetStatusColor(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => Color.Default,
        PurchaseOrderStatus.Sent => Color.Primary,
        PurchaseOrderStatus.PartiallyReceived => Color.Warning,
        PurchaseOrderStatus.Received => Color.Success,
        PurchaseOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private sealed class PurchaseOrderFormModel
    {
        public Guid Id { get; set; }
        public string Number { get; set; } = string.Empty;
        public Guid? SupplierId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public Guid? WarehouseId { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
        public DateTime? ExpectedDate { get; set; }
        public string? Notes { get; set; }
        public PurchaseOrderStatus Status { get; set; } = PurchaseOrderStatus.Draft;
        public List<PurchaseOrderLineModel> Items { get; set; } = [];
    }

    private sealed class PurchaseOrderLineModel
    {
        public Guid? ProductId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
    }
}
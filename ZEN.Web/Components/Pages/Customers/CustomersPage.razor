@page "/customers"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Customers
@using ZEN.Web.Components.Dialogs
@using ZEN.Shared
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]

<PageTitle>@L["Customers"] - @L["AppName"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-2">
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.h5" Class="font-weight-bold">@L["Customers"]</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   OnClick="OpenCreateDialog">
            @L["AddCustomer"]
        </MudButton>
    </div>

    <MudTable Items="@_customers"
              Hover="true"
              Striped="true"
              Dense="true"
              Elevation="1"
              Breakpoint="Breakpoint.Md"
              Loading="@_isLoading"
              LoadingProgressColor="Color.Primary"
              Filter="new Func<CustomerDto,bool>(FilterSearchLogic)">

        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@L["CustomerDirectory"]</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchTerm"
                          Placeholder="Search name, phone, email..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" style="max-width: 300px;" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<CustomerDto, object>(x => x.Name)"><MudText Typo="Typo.body2" Class="font-weight-bold">Name</MudText></MudTableSortLabel></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Email</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Phone</MudText></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<CustomerDto, object>(x => x.LoyaltyPoints)"><MudText Typo="Typo.body2" Class="font-weight-bold">Loyalty Points</MudText></MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<CustomerDto, object>(x => x.TotalSpent)"><MudText Typo="Typo.body2" Class="font-weight-bold">Total Spent</MudText></MudTableSortLabel></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Status</MudText></MudTh>
            <MudTh Style="text-align: right;"><MudText Typo="Typo.body2" Class="font-weight-bold">Actions</MudText></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name"><MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText></MudTd>
            <MudTd DataLabel="Email"><MudText Typo="Typo.body2">@context.Email</MudText></MudTd>
            <MudTd DataLabel="Phone"><MudText Typo="Typo.body2">@context.Phone</MudText></MudTd>
            <MudTd DataLabel="Loyalty Points"><MudText Typo="Typo.body2">@context.LoyaltyPoints</MudText></MudTd>
            <MudTd DataLabel="Total Spent"><MudText Typo="Typo.body2" Class="font-weight-bold text-success">@context.TotalSpent.ToString("C")</MudText></MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Text" Size="Size.Small" Class="ma-0">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCustomer(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Align="Align.Center" Typo="Typo.body2" Class="pa-2">@L["NoMatchingCustomers"]</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Rows per page:" />
        </PagerContent>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            @( _isEditMode ? L["ModifyAccount"] : L["RegisterProfile"] )
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudStack Spacing="2" Class="py-1">
                <MudTextField Label="Full Name / Entity Name" @bind-Value="_editingCustomer.Name" Required="true" RequiredError="Required." Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingCustomer.Name)" />
                <MudTextField Label="Email Address" @bind-Value="_editingCustomer.Email" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingCustomer.Email)" />
                <MudTextField Label="Phone Line" @bind-Value="_editingCustomer.Phone" InputType="InputType.Telephone" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingCustomer.Phone)" />
                <MudTextField Label="Billing/Delivery Address" @bind-Value="_editingCustomer.Address" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingCustomer.Address)" Multiline="true" Lines="2" />

                @if (_isEditMode)
                {
                    <div class="d-flex justify-space-between align-center pt-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Operational Status:</MudText>
                        <MudSwitch @bind-Value="_editingCustomer.IsActive" Color="Color.Success" Label="@(_editingCustomer.IsActive ? "Active" : "Deactivated")" Dense="true" />
                    </div>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text" Size="Size.Small">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveCustomer" Disabled="@(!_formIsValid)">@L["SaveProfile"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IEnumerable<CustomerDto> _customers = new List<CustomerDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm _form = default!;
    private UpdateCustomerRequest _editingCustomer = new(Guid.Empty, "", null, null, null, null, true);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        try
        {
            _customers = await CustomerService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterSearchLogic(CustomerDto customer) => FilterFunc(customer, _searchTerm);

    private bool FilterFunc(CustomerDto customer, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (customer.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (customer.Phone?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (customer.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingCustomer = new UpdateCustomerRequest(Guid.Empty, "", null, null, null, null, true);
        _isDialogOpen = true;
    }

    private void OpenEditDialog(CustomerDto customer)
    {
        _isEditMode = true;
        _editingCustomer = new UpdateCustomerRequest(
            customer.Id,
            customer.Name,
            customer.Email,
            customer.Phone,
            customer.Address,
            customer.CustomerGroupId,
            customer.IsActive
        );
        _isDialogOpen = true;
    }

    private async Task SaveCustomer()
    {
        try
        {
            if (_isEditMode)
            {
                await CustomerService.UpdateAsync(_editingCustomer);
                Snackbar.Add(L["ProfileUpdated"], Severity.Success);
            }
            else
            {
                var createRequest = new CreateCustomerRequest(
                    _editingCustomer.Name,
                    _editingCustomer.Email,
                    _editingCustomer.Phone,
                    _editingCustomer.Address,
                    _editingCustomer.CustomerGroupId
                );
                await CustomerService.CreateAsync(createRequest);
                Snackbar.Add(L["ProfileRegistered"], Severity.Success);
            }
            await LoadCustomers();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var parameters = new DialogParameters { ["ContentText"] = string.Format(L["DeleteCustomerConfirmation"], customer.Name) };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullScreen = false };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(L["DeleteCustomerTitle"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var success = await CustomerService.DeleteAsync(customer.Id);
                if (success)
                {
                    Snackbar.Add(L["CustomerRemoved"], Severity.Success);
                    await LoadCustomers();
                }
                else
                {
                    Snackbar.Add(L["FailedToRemoveCustomer"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;
}



    private async Task OnStoreIdChanged(Guid? storeId)
    {
        _editingModel.StoreId = storeId;
        if (storeId.HasValue)
        {
            _products = (await ProductService.GetAllAsync(storeId)).ToList();
            var store = _stores.FirstOrDefault(s => s.Id == storeId);
            if (store != null)
            {
                _editingModel.StoreName = store.Name;
            }
        }
    }

    private void AddLineItem() => _editingModel.Items.Add(new SellOrderLineModel());

    private void RemoveLineItem(SellOrderLineModel item)
    {
        if (_editingModel.Items.Count > 1)
        {
            _editingModel.Items.Remove(item);
        }
    }

    private decimal CalculateLineTotal(SellOrderLineModel item)
    {
        if (!item.ProductId.HasValue || item.Quantity <= 0) return 0;
        var subtotal = item.Quantity * item.UnitPrice;
        var discountAmount = subtotal * (item.Discount / 100m);
        var afterDiscount = subtotal - discountAmount;
        var taxAmount = afterDiscount * (item.TaxRate / 100m);
        return afterDiscount + taxAmount;
    }

    private decimal CalculateSubTotal()
    {
        return _editingModel.Items
            .Where(i => i.ProductId.HasValue && i.Quantity > 0)
            .Sum(i => i.Quantity * i.UnitPrice);
    }

    private decimal CalculateTaxAmount()
    {
        return _editingModel.Items
            .Where(i => i.ProductId.HasValue && i.Quantity > 0)
            .Sum(i =>
            {
                var subtotal = i.Quantity * i.UnitPrice;
                var discountAmount = subtotal * (i.Discount / 100m);
                var afterDiscount = subtotal - discountAmount;
                return afterDiscount * (i.TaxRate / 100m);
            });
    }

    private decimal CalculateTotalAmount()
    {
        return CalculateSubTotal() - _editingModel.Items
            .Where(i => i.ProductId.HasValue && i.Quantity > 0)
            .Sum(i =>
            {
                var subtotal = i.Quantity * i.UnitPrice;
                return subtotal * (i.Discount / 100m);
            })
            + CalculateTaxAmount();
    }

    private async Task SaveChangesAsync()
    {
        try
        {
            if (!_editingModel.CustomerId.HasValue || !_editingModel.StoreId.HasValue)
            {
                Snackbar.Add("Customer and store are required.", Severity.Warning);
                return;
            }

            var validItems = _editingModel.Items
                .Where(i => i.ProductId.HasValue && i.Quantity > 0 && i.UnitPrice >= 0)
                .ToList();

            if (validItems.Count == 0)
            {
                Snackbar.Add("Add at least one valid item to the order.", Severity.Warning);
                return;
            }

            _isSaving = true;

            if (_isNew)
            {
                var items = validItems.Select(i => new CreateSellOrderItemRequest(
                    i.ProductId!.Value,
                    i.Quantity,
                    i.UnitPrice,
                    i.Discount,
                    i.TaxRate > 0 ? i.TaxRate : null)).ToList();

                var request = new CreateSellOrderRequest(
                    _editingModel.CustomerId.Value,
                    _editingModel.StoreId.Value,
                    _editingModel.ExpectedDate,
                    string.IsNullOrWhiteSpace(_editingModel.Notes) ? null : _editingModel.Notes,
                    items);

                _order = await SellOrderService.CreateAsync(request);
                Snackbar.Add("Sell order created successfully.", Severity.Success);
            }
            else
            {
                var request = new UpdateSellOrderRequest(
                    _editingModel.Id,
                    _editingModel.ExpectedDate,
                    string.IsNullOrWhiteSpace(_editingModel.Notes) ? null : _editingModel.Notes,
                    _editingModel.Status);

                await SellOrderService.UpdateAsync(request);
                Snackbar.Add("Sell order updated successfully.", Severity.Success);
            }

            _isEditMode = false;
            if (!_isNew)
            {
                await LoadOrderAsync();
            }
            else
            {
                Navigation.NavigateTo($"/sell-orders/{_order!.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FulfillOrderAsync()
    {
        if (_order == null) return;

        try
        {
            _isSaving = true;
            if (await SellOrderService.FulfillAsync(_order.Id))
            {
                Snackbar.Add("Sell order fulfilled successfully.", Severity.Success);
                await LoadOrderAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        if (_order == null) return;

        try
        {
            _isSaving = true;
            if (await SellOrderService.CancelAsync(_order.Id))
            {
                Snackbar.Add("Sell order cancelled.", Severity.Warning);
                await LoadOrderAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteOrderAsync()
    {
        if (_order == null) return;

        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete sell order {_order.Number}?" }
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Delete Order", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                _isSaving = true;
                if (await SellOrderService.DeleteAsync(_order.Id))
                {
                    Snackbar.Add("Sell order deleted.", Severity.Success);
                    Navigation.NavigateTo("/sell-orders");
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                _isSaving = false;
            }
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/sell-orders");
    }

    private static Color GetStatusColor(SellOrderStatus status) => status switch
    {
        SellOrderStatus.Draft => Color.Default,
        SellOrderStatus.Pending => Color.Primary,
        SellOrderStatus.PartiallyFulfilled => Color.Warning,
        SellOrderStatus.Fulfilled => Color.Success,
        SellOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };


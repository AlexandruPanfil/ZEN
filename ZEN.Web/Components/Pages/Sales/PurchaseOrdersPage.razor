@page "/purchase-orders"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.DTOs.Inventory
@using ZEN.Application.DTOs.Products
@using ZEN.Application.DTOs.Suppliers
@using ZEN.Application.Services.Interfaces
@using ZEN.Domain.Enums
@using ZEN.Domain.Entities
@using ZEN.Domain.Interfaces
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject IWarehouseService WarehouseService
@inject IProductService ProductService
@inject IStoreContext StoreContext
@inject global::ZEN.Domain.Interfaces.IRepository<Store> StoreRepository
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Purchase Orders - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<div class="sell-orders-layout">
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Primary">Purchase Orders</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Procure stock from commercial vendors, verify inbound items, and route product inventory allocations.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   OnClick="@(() => Navigation.NavigateTo("/purchase-orders/new"))">
            Create Purchase Order
        </MudButton>
    </div>

    <div class="main-content">
        <div class="table-area">
            <MudTable T="PurchaseOrderDto" Items="@FilteredPurchaseOrders" Hover="true" Striped="true" Elevation="1" Breakpoint="Breakpoint.Md" Loading="@_isLoading" Class="sell-orders-table">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Procurement Directory Ledger</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.Number)">Order #</MudTableSortLabel></MudTh>
                    <MudTh>Supplier Partner</MudTh>
                    <MudTh>Target Warehouse</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.OrderDate)">Issued Date</MudTableSortLabel></MudTh>
                    <MudTh>Expected Delivery</MudTh>
                    <MudTh>Fulfillment Status</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<PurchaseOrderDto, object>(x => x.TotalAmount)">Financial Valuation</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align: right; min-width: 220px;">Control Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    <MudTd DataLabel="Order #" Class="font-weight-bold">@order.Number</MudTd>
                    <MudTd DataLabel="Supplier">@order.SupplierName</MudTd>
                    <MudTd DataLabel="Warehouse">
                        <span class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                            @order.WarehouseName
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Order Date">@order.OrderDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Expected Date">@(order.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetStatusColor(order.Status)" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                            @order.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Total" Class="font-weight-bold color-primary">@order.TotalAmount.ToString("C")</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                        <MudTooltip Text="Inspect Manifest">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Class="mr-1" OnClick="@(() => Navigation.NavigateTo($"/purchase-orders/{order.Id}"))" />
                        </MudTooltip>
                        <MudTooltip Text="Modify Structure">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-1" OnClick="@(() => Navigation.NavigateTo($"/purchase-orders/{order.Id}"))" />
                        </MudTooltip>
                        <MudTooltip Text="Approve & Commit Manifest">
                            <MudIconButton Icon="@Icons.Material.Filled.Send" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" Class="mr-1" Disabled="@(order.Status != PurchaseOrderStatus.Draft)" OnClick="@(() => ApproveOrder(order))" />
                        </MudTooltip>
                        <MudTooltip Text="Abort Procure Cycle">
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="mr-1" Disabled="@(order.Status is PurchaseOrderStatus.Cancelled or PurchaseOrderStatus.Received)" OnClick="@(() => CancelOrder(order))" />
                        </MudTooltip>
                        <MudTooltip Text="Purge Record Draft">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="@(order.Status != PurchaseOrderStatus.Draft)" OnClick="@(() => DeleteOrder(order))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="pa-4 color-secondary">No purchase orders meet current spatial filter parameters.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Items per spreadsheet context:" />
                </PagerContent>
            </MudTable>
        </div>

        <aside class="filter-sidebar">
            <div class="filter-sidebar-header">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Filters</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="@ClearAllFilters" Class="ms-auto">
                    Clear All
                </MudButton>
            </div>
            <div class="filter-sidebar-content">
                <div class="filter-section mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Search & Basic</MudText>
                    <MudTextField T="string"
                                  Placeholder="Search orders..."
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  @bind-Value="_searchTerm"
                                  Immediate="true"
                                  Clearable="true"
                                  Margin="Margin.Dense"
                                  Class="mb-3" />
                    <MudSelect T="Guid?"
                               Label="Warehouse"
                               Variant="Variant.Outlined"
                               Value="_selectedWarehouseId"
                               ValueChanged="OnWarehouseChanged"
                               Margin="Margin.Dense"
                               Class="w-100">
                        <MudSelectItem T="Guid?" Value="@(null)">All Warehouses</MudSelectItem>
                        @foreach (var warehouse in _warehouses)
                        {
                            <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-section mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Supplier & Status</MudText>
                    <MudAutocomplete T="SupplierDto"
                                     Label="Supplier"
                                     Variant="Variant.Outlined"
                                     SearchFunc="@SearchSuppliers"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     Value="@_selectedSupplier"
                                     ValueChanged="@OnSupplierChanged"
                                     Clearable="true"
                                     Margin="Margin.Dense"
                                     Class="mb-3 w-100" />
                    <MudSelect T="PurchaseOrderStatus"
                               Label="Status"
                               Variant="Variant.Outlined"
                               MultiSelection="true"
                               SelectedValues="_selectedStatusesHashSet"
                               SelectedValuesChanged="@(values => OnStatusesChanged(values))"
                               Margin="Margin.Dense"
                               Class="w-100">
                        @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
                        {
                            <MudSelectItem T="PurchaseOrderStatus" Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-section mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Date Ranges</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Order Date From"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Date="@_orderDateFrom"
                                           DateChanged="@(d => _orderDateFrom = d)"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Order Date To"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Date="@_orderDateTo"
                                           DateChanged="@(d => _orderDateTo = d)"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Expected Date From"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Date="@_expectedDateFrom"
                                           DateChanged="@(d => _expectedDateFrom = d)"
                                           Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Expected Date To"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Date="@_expectedDateTo"
                                           DateChanged="@(d => _expectedDateTo = d)"
                                           Class="w-100" />
                        </MudItem>
                    </MudGrid>
                </div>

                <div class="filter-section mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Price Range</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?"
                                             Label="Min Amount"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="C"
                                             Min="0"
                                             @bind-Value="_minTotalAmount"
                                             Class="w-100" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?"
                                             Label="Max Amount"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="C"
                                             Min="0"
                                             @bind-Value="_maxTotalAmount"
                                             Class="w-100" />
                        </MudItem>
                    </MudGrid>
                </div>

                <div class="filter-section mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Advanced</MudText>
                    <MudTextField T="string"
                                  Label="Order ID"
                                  Placeholder="Exact order number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  @bind-Value="_orderNumberFilter"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="mb-3 w-100" />
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
.sell-orders-layout {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 64px);
    padding: 1rem;
    box-sizing: border-box;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.main-content {
    display: flex;
    flex: 1;
    gap: 1rem;
    min-height: 0;
}

.table-area {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.sell-orders-table {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.filter-sidebar {
    width: 320px;
    max-width: 22%;
    min-width: 280px;
    flex-shrink: 0;
    background-color: var(--mud-palette-surface);
    border-left: 1px solid var(--mud-palette-divider);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    height: fit-content;
    max-height: calc(100vh - 200px);
    position: sticky;
    top: 1rem;
}

.filter-sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--mud-palette-divider);
}

.filter-sidebar-content {
    flex: 1;
    padding: 0.5rem 1rem 1rem;
    overflow-y: auto;
}

.filter-section {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--mud-palette-divider);
}

.filter-section:last-child {
    border-bottom: none;
}
</style>

@code {
    private List<PurchaseOrderDto> _purchaseOrders = new();
    private List<SupplierDto> _suppliers = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ProductDto> _products = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = false;
    private Guid? _currentStoreId;
    private Guid? _selectedWarehouseId;
    private SupplierDto? _selectedSupplier;
    private Guid? _selectedSupplierId;
    private IEnumerable<PurchaseOrderStatus> _selectedStatuses = Enumerable.Empty<PurchaseOrderStatus>();
    private HashSet<PurchaseOrderStatus> _selectedStatusesHashSet = new();
    private DateTime? _orderDateFrom;
    private DateTime? _orderDateTo;
    private DateTime? _expectedDateFrom;
    private DateTime? _expectedDateTo;
    private decimal? _minTotalAmount;
    private decimal? _maxTotalAmount;
    private string _orderNumberFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentStoreId = StoreContext.GetCurrentStoreId();
        await LoadLookupsAsync();
        await LoadPurchaseOrdersAsync();
    }

    private IEnumerable<PurchaseOrderDto> FilteredPurchaseOrders => _purchaseOrders.Where(p =>
        (string.IsNullOrWhiteSpace(_searchTerm) ||
         p.Number.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         p.SupplierName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         p.WarehouseName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (!_selectedWarehouseId.HasValue || p.WarehouseId == _selectedWarehouseId.Value) &&
        (!_selectedSupplierId.HasValue || p.SupplierId == _selectedSupplierId.Value) &&
        (!_selectedStatuses.Any() || _selectedStatuses.Contains(p.Status)) &&
        (!_orderDateFrom.HasValue || p.OrderDate >= _orderDateFrom.Value) &&
        (!_orderDateTo.HasValue || p.OrderDate <= _orderDateTo.Value) &&
        (!_expectedDateFrom.HasValue || (p.ExpectedDate.HasValue && p.ExpectedDate.Value >= _expectedDateFrom.Value)) &&
        (!_expectedDateTo.HasValue || (p.ExpectedDate.HasValue && p.ExpectedDate.Value <= _expectedDateTo.Value)) &&
        (!_minTotalAmount.HasValue || p.TotalAmount >= _minTotalAmount.Value) &&
        (!_maxTotalAmount.HasValue || p.TotalAmount <= _maxTotalAmount.Value) &&
        (string.IsNullOrWhiteSpace(_orderNumberFilter) || p.Number.Contains(_orderNumberFilter, StringComparison.OrdinalIgnoreCase))
    );

    private async Task LoadLookupsAsync()
    {
        try
        {
            _suppliers = (await SupplierService.GetAllAsync()).ToList();
            _products = (await ProductService.GetAllAsync(_currentStoreId)).ToList();

            var warehouses = new List<WarehouseDto>();

            if (_currentStoreId.HasValue)
            {
                warehouses.AddRange(await WarehouseService.GetActiveByStoreAsync(_currentStoreId.Value));
            }
            else
            {
                var stores = await StoreRepository.FindAsync(s => s.IsActive);

                foreach (var store in stores)
                {
                    warehouses.AddRange(await WarehouseService.GetActiveByStoreAsync(store.Id));
                }
            }

            _warehouses = warehouses;
            _selectedWarehouseId ??= _warehouses.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadPurchaseOrdersAsync()
    {
        _isLoading = true;
        try
        {
            if (_selectedWarehouseId.HasValue)
            {
                _purchaseOrders = (await PurchaseOrderService.GetByWarehouseAsync(_selectedWarehouseId.Value)).ToList();
            }
            else
            {
                _purchaseOrders = [];
                Snackbar.Add("Select an operational warehouse node to inspect active data parameters.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnWarehouseChanged(Guid? warehouseId)
    {
        _selectedWarehouseId = warehouseId;
        await LoadPurchaseOrdersAsync();
    }

    private void OnSupplierChanged(SupplierDto? supplier)
    {
        _selectedSupplier = supplier;
        _selectedSupplierId = supplier?.Id;
    }

    private void OnStatusesChanged(IEnumerable<PurchaseOrderStatus> statuses)
    {
        _selectedStatusesHashSet = statuses?.ToHashSet() ?? new HashSet<PurchaseOrderStatus>();
        _selectedStatuses = _selectedStatusesHashSet;
    }

    private Task<IEnumerable<SupplierDto>> SearchSuppliers(string text, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Task.FromResult(_suppliers.AsEnumerable());
        }
        return Task.FromResult(_suppliers.Where(s =>
            s.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            (s.Email != null && s.Email.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
            (s.Phone != null && s.Phone.Contains(text, StringComparison.OrdinalIgnoreCase))).AsEnumerable());
    }

    private void ClearAllFilters()
    {
        _searchTerm = string.Empty;
        _selectedWarehouseId = _warehouses.FirstOrDefault()?.Id;
        _selectedSupplier = null;
        _selectedSupplierId = null;
        _selectedStatuses = Enumerable.Empty<PurchaseOrderStatus>();
        _selectedStatusesHashSet = new HashSet<PurchaseOrderStatus>();
        _orderDateFrom = null;
        _orderDateTo = null;
        _expectedDateFrom = null;
        _expectedDateTo = null;
        _minTotalAmount = null;
        _maxTotalAmount = null;
        _orderNumberFilter = string.Empty;
    }

    private async Task ApproveOrder(PurchaseOrderDto order)
    {
        try
        {
            if (await PurchaseOrderService.ApproveAsync(order.Id))
            {
                Snackbar.Add("Purchase order status committed and approved successfully.", Severity.Success);
                await LoadPurchaseOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CancelOrder(PurchaseOrderDto order)
    {
        try
        {
            if (await PurchaseOrderService.CancelAsync(order.Id))
            {
                Snackbar.Add("Target distribution workflow halted and cancelled.", Severity.Warning);
                await LoadPurchaseOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteOrder(PurchaseOrderDto order)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Are you sure you want to drop purchase document draft {order.Number}?" };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Purge Record Struct", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                if (await PurchaseOrderService.DeleteAsync(order.Id))
                {
                    Snackbar.Add("Document entity deleted out of active registry contexts.", Severity.Success);
                    await LoadPurchaseOrdersAsync();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private static Color GetStatusColor(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => Color.Default,
        PurchaseOrderStatus.Sent => Color.Primary,
        PurchaseOrderStatus.PartiallyReceived => Color.Warning,
        PurchaseOrderStatus.Received => Color.Success,
        PurchaseOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}
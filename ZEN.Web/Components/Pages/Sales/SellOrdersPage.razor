@page "/sell-orders"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.DTOs.Sales
@using ZEN.Application.DTOs.Products
@using ZEN.Application.DTOs.Customers
@using ZEN.Application.DTOs.Admin
@using ZEN.Application.Services.Interfaces
@using ZEN.Domain.Enums
@using ZEN.Domain.Entities
@using ZEN.Domain.Interfaces
@inject ISellOrderService SellOrderService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IStoreContext StoreContext
@inject global::ZEN.Domain.Interfaces.IRepository<Store> StoreRepository
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,Cashier,SalesPerson")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Sell Orders - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Primary">Sell Orders</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Manage customer sales orders, track fulfillment, and process invoices.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   OnClick="CreateNewOrder">
            Create Sell Order
        </MudButton>
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Active Orders</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FilteredSellOrders.Count()</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Pending Fulfillment</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_sellOrders.Count(s => s.Status == SellOrderStatus.Pending)</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Success" Size="Size.Large" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Order Value</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FilteredSellOrders.Sum(s => s.TotalAmount).ToString("C")</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Class="align-center mb-2">
            <MudItem xs="12" md="6" lg="7">
                <MudTextField T="string"
                              Placeholder="Filter by order #, customer name, or details..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              @bind-Value="_searchTerm"
                              Immediate="true"
                              Clearable="true"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6" lg="5">
                <MudSelect T="Guid?"
                           Label="Store / Location"
                           Variant="Variant.Outlined"
                           Value="_selectedStoreId"
                           ValueChanged="OnStoreChanged"
                           Margin="Margin.Dense">
                        <MudSelectItem T="Guid?" Value="@(null)">All Stores & Locations</MudSelectItem>
                        @foreach (var store in _stores)
                        {
                            <MudSelectItem T="Guid?" Value="@store.Id">@store.Name</MudSelectItem>
                        }
                    </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable T="SellOrderDto" Items="@FilteredSellOrders" Hover="true" Striped="true" Elevation="1" Breakpoint="Breakpoint.Md" Loading="@_isLoading">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Sales Order Ledger</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<SellOrderDto, object>(x => x.Number)">Order #</MudTableSortLabel></MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Store Location</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<SellOrderDto, object>(x => x.OrderDate)">Order Date</MudTableSortLabel></MudTh>
            <MudTh>Expected Date</MudTh>
            <MudTh>Fulfillment Status</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<SellOrderDto, object>(x => x.TotalAmount)">Order Value</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: right; min-width: 220px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="order">
            <MudTd DataLabel="Order #" Class="font-weight-bold">@order.Number</MudTd>
            <MudTd DataLabel="Customer">@order.CustomerName</MudTd>
            <MudTd DataLabel="Store">
                <span class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                    @order.StoreName
                </span>
            </MudTd>
            <MudTd DataLabel="Order Date">@order.OrderDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Expected Date">@(order.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(order.Status)" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                    @order.Status
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Total" Class="font-weight-bold color-primary">@order.TotalAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                <MudTooltip Text="View / Edit Order">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-1" OnClick="@(() => Navigation.NavigateTo($"/sell-orders/{order.Id}"))" />
                </MudTooltip>
                <MudTooltip Text="Fulfill Order">
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" Class="mr-1" Disabled="@(order.Status != SellOrderStatus.Pending && order.Status != SellOrderStatus.PartiallyFulfilled)" OnClick="@(() => FulfillOrder(order))" />
                </MudTooltip>
                <MudTooltip Text="Cancel Order">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="mr-1" Disabled="@(order.Status is SellOrderStatus.Cancelled or SellOrderStatus.Fulfilled)" OnClick="@(() => CancelOrder(order))" />
                </MudTooltip>
                <MudTooltip Text="Delete Draft">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="@(order.Status != SellOrderStatus.Draft)" OnClick="@(() => DeleteOrder(order))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-4 color-secondary">No sell orders match current filter criteria.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Items per page:" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<SellOrderDto> _sellOrders = new();
    private List<CustomerDto> _customers = new();
    private List<StoreDto> _stores = new();
    private List<ProductDto> _products = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = false;
    private Guid? _currentStoreId;
    private Guid? _selectedStoreId;

    protected override async Task OnInitializedAsync()
    {
        _currentStoreId = StoreContext.GetCurrentStoreId();
        await LoadLookupsAsync();
        await LoadSellOrdersAsync();
    }

    private IEnumerable<SellOrderDto> FilteredSellOrders => _sellOrders.Where(s =>
        string.IsNullOrWhiteSpace(_searchTerm) ||
        s.Number.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
        s.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
        s.StoreName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task LoadLookupsAsync()
    {
        try
        {
            _customers = (await CustomerService.GetAllAsync()).ToList();
            _products = (await ProductService.GetAllAsync(_currentStoreId)).ToList();

            var stores = new List<StoreDto>();

            if (_currentStoreId.HasValue)
            {
                var store = await StoreRepository.GetByIdAsync(_currentStoreId.Value);
                if (store != null)
                {
                    stores.Add(new StoreDto(store.Id, store.Name, store.Code, store.Address, store.City, store.Phone, store.Email, store.IsActive));
                }
            }
            else
            {
                var allStores = await StoreRepository.FindAsync(s => s.IsActive);
                stores.AddRange(allStores.Select(s => new StoreDto(s.Id, s.Name, s.Code, s.Address, s.City, s.Phone, s.Email, s.IsActive)));
            }

            _stores = stores;
            _selectedStoreId ??= _stores.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSellOrdersAsync()
    {
        _isLoading = true;
        try
        {
            if (_selectedStoreId.HasValue)
            {
                _sellOrders = (await SellOrderService.GetByStoreAsync(_selectedStoreId.Value)).ToList();
            }
            else
            {
                _sellOrders = [];
                Snackbar.Add("Select a store to view sell orders.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnStoreChanged(Guid? storeId)
    {
        _selectedStoreId = storeId;
        await LoadSellOrdersAsync();
    }

    private async Task FulfillOrder(SellOrderDto order)
    {
        try
        {
            if (await SellOrderService.FulfillAsync(order.Id))
            {
                Snackbar.Add("Sell order fulfilled successfully.", Severity.Success);
                await LoadSellOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CancelOrder(SellOrderDto order)
    {
        try
        {
            if (await SellOrderService.CancelAsync(order.Id))
            {
                Snackbar.Add("Sell order cancelled.", Severity.Warning);
                await LoadSellOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteOrder(SellOrderDto order)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete sell order {order.Number}?" }
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Delete Order", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                if (await SellOrderService.DeleteAsync(order.Id))
                {
                    Snackbar.Add("Sell order deleted.", Severity.Success);
                    await LoadSellOrdersAsync();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private static Color GetStatusColor(SellOrderStatus status) => status switch
    {
        SellOrderStatus.Draft => Color.Default,
        SellOrderStatus.Pending => Color.Primary,
        SellOrderStatus.PartiallyFulfilled => Color.Warning,
        SellOrderStatus.Fulfilled => Color.Success,
        SellOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private void CreateNewOrder()
    {
        Navigation.NavigateTo("/sell-orders/new");
    }
}
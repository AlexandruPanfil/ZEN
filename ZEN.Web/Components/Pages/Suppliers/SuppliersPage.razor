@page "/suppliers"
@* @rendermode InteractiveServer *@
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Suppliers
@using ZEN.Application.DTOs.Inventory
@using ZEN.Web.Components.Dialogs
@inject ISupplierService SupplierService
@inject IInventoryService InventoryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

<PageTitle>Suppliers - ZEN POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 py-0">
    <div class="d-flex justify-space-between align-center mb-3">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Suppliers</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="OpenCreateDialog">
            Add Supplier
        </MudButton>
    </div>

    <MudTable Items="@_suppliers"
              Hover="true"
              Dense="true"
              Bordered="false"
              Striped="true"
              Elevation="1"
              Breakpoint="Breakpoint.Md"
              Loading="@_isLoading"
              LoadingProgressColor="Color.Primary"
              Filter="new Func<SupplierDto,bool>(FilterSearchLogic)">

        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Vendor Inventory Ledger</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchTerm"
                          Placeholder="Quick Search..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" style="max-width: 300px;" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<SupplierDto, object>(x => x.Name)"><MudText Typo="Typo.body2" Class="font-weight-bold">Name</MudText></MudTableSortLabel></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Contact Person</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Email</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Phone</MudText></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<SupplierDto, object>(x => x.Balance)"><MudText Typo="Typo.body2" Class="font-weight-bold">Outstanding Balance</MudText></MudTableSortLabel></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Status</MudText></MudTh>
            <MudTh Style="text-align: right;"><MudText Typo="Typo.body2" Class="font-weight-bold">Actions</MudText></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name"><MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText></MudTd>
            <MudTd DataLabel="Contact Person"><MudText Typo="Typo.body2">@context.ContactPerson</MudText></MudTd>
            <MudTd DataLabel="Email"><MudText Typo="Typo.body2">@context.Email</MudText></MudTd>
            <MudTd DataLabel="Phone"><MudText Typo="Typo.body2">@context.Phone</MudText></MudTd>
            <MudTd DataLabel="Balance"><MudText Typo="Typo.body2" Class="@(context.Balance > 0 ? "red-text font-weight-bold" : "")">@context.Balance.ToString("C")</MudText></MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Text" Size="Size.Small" Class="ma-0">
                    @(context.IsActive ? "Active" : "Suspended")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenHistoryDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteSupplier(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Align="Align.Center" Typo="Typo.body2" Class="pa-2">No matching suppliers found.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Records per page:" />
        </PagerContent>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            @( _isEditMode ? "Modify Supplier Context" : "Register New Supplier Partner" )
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudStack Spacing="2" Class="py-1">
                <MudTextField Label="Company Name" @bind-Value="_editingSupplier.Name" Required="true" RequiredError="Required." Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingSupplier.Name)" />

                <MudTextField Label="Contact Representative" @bind-Value="_editingSupplier.ContactPerson" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingSupplier.ContactPerson)" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Email Address" @bind-Value="_editingSupplier.Email" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingSupplier.Email)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Phone Line" @bind-Value="_editingSupplier.Phone" InputType="InputType.Telephone" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingSupplier.Phone)" />
                    </MudItem>
                </MudGrid>

                <MudTextField Label="Postal/HQ Address" @bind-Value="_editingSupplier.Address" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => _editingSupplier.Address)" Multiline="true" Lines="2" />

                @if (_isEditMode)
                {
                    <div class="d-flex justify-space-between align-center pt-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Allow point of sale purchasing operations:</MudText>
                        <MudSwitch T="bool" @bind-Value="_editingSupplier.IsActive" Color="Color.Success" Label="@(_editingSupplier.IsActive ? "Operational" : "Deactivated")" Dense="true" />
                    </div>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveSupplier">Save Vendor Partner</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_isHistoryDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Financial Ledger History</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Supplier Entity: @(_selectedSupplier?.Name)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTable Items="@_purchases" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0" MaxHeight="300px" FixedHeader="true">
            <HeaderContent>
                <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Purchase Ref No.</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Receipt Settlement Date</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Gross Aggregate</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Settled Amount</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Tracking Status</MudText></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Number"><MudText Typo="Typo.body2" Class="font-weight-bold">@context.Number</MudText></MudTd>
                <MudTd DataLabel="Date"><MudText Typo="Typo.body2">@context.ReceiptDate.ToShortDateString()</MudText></MudTd>
                <MudTd DataLabel="Total"><MudText Typo="Typo.body2" Class="font-weight-bold">@context.TotalAmount.ToString("C")</MudText></MudTd>
                <MudTd DataLabel="Paid"><MudText Typo="Typo.body2" Color="Color.Success">@context.PaidAmount.ToString("C")</MudText></MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@context.Status</MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseHistoryDialog" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">Close View</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IEnumerable<SupplierDto> _suppliers = new List<SupplierDto>();
    private IEnumerable<StockPurchaseDto> _purchases = new List<StockPurchaseDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm _form = default!;
    private SupplierFormModel _editingSupplier = new();
    private SupplierDto? _selectedSupplier;
    private bool _isHistoryDialogOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }

    private async Task LoadSuppliers()
    {
        _isLoading = true;
        try
        {
            _suppliers = await SupplierService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterSearchLogic(SupplierDto supplier) => FilterFunc(supplier, _searchTerm);

    private bool FilterFunc(SupplierDto supplier, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (supplier.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (supplier.ContactPerson?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (supplier.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingSupplier = new SupplierFormModel();
        _formIsValid = false;
        _isDialogOpen = true;
        StateHasChanged();
    }

    private void OpenEditDialog(SupplierDto supplier)
    {
        _isEditMode = true;
        _editingSupplier = new SupplierFormModel
        {
            Id = supplier.Id,
            Name = supplier.Name,
            ContactPerson = supplier.ContactPerson,
            Email = supplier.Email,
            Phone = supplier.Phone,
            Address = supplier.Address,
            IsActive = supplier.IsActive
        };
        _formIsValid = true;
        _isDialogOpen = true;
        StateHasChanged();
    }

    private async Task SaveSupplier()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_formIsValid) return;
        }

        try
        {
            if (_isEditMode)
            {
                var updateRequest = new UpdateSupplierRequest(
                    _editingSupplier.Id,
                    _editingSupplier.Name,
                    _editingSupplier.ContactPerson,
                    _editingSupplier.Email,
                    _editingSupplier.Phone,
                    _editingSupplier.Address,
                    _editingSupplier.IsActive
                );
                await SupplierService.UpdateAsync(updateRequest);
                Snackbar.Add("Supplier updated successfully", Severity.Success);
            }
            else
            {
                var createRequest = new CreateSupplierRequest(
                    _editingSupplier.Name,
                    _editingSupplier.ContactPerson,
                    _editingSupplier.Email,
                    _editingSupplier.Phone,
                    _editingSupplier.Address
                );
                await SupplierService.CreateAsync(createRequest);
                Snackbar.Add("Supplier registered successfully", Severity.Success);
            }
            await LoadSuppliers();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteSupplier(SupplierDto supplier)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Are you sure you want to delete supplier {supplier.Name}?" };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullScreen = false };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Supplier", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var success = await SupplierService.DeleteAsync(supplier.Id);
                if (success)
                {
                    Snackbar.Add("Supplier removed successfully", Severity.Success);
                    await LoadSuppliers();
                }
                else
                {
                    Snackbar.Add("Failed to remove supplier", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenHistoryDialog(SupplierDto supplier)
    {
        _selectedSupplier = supplier;
        _isHistoryDialogOpen = true;

        try
        {
            _purchases = await InventoryService.GetStockPurchasesAsync(supplier.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading purchase history: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    private void CloseDialog()
    {
        _isDialogOpen = false;
        StateHasChanged();
    }

    private void CloseHistoryDialog()
    {
        _isHistoryDialogOpen = false;
        StateHasChanged();
    }

    private class SupplierFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? ContactPerson { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Address { get; set; }
        public bool IsActive { get; set; } = true;
    }
}



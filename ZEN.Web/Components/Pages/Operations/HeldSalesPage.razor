@page "/held-sales"
@using ZEN.Application.DTOs.Sales
@using ZEN.Application.Services.Interfaces
@using ZEN.Web.Components.Dialogs
@using ZEN.Shared.Components.Common
@using ZEN.Web.Services
@using ZEN.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using MudBlazor
@inject ISaleService SaleService
@inject IStoreContext StoreContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SignalRService SignalRService
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<Microsoft.AspNetCore.Components.Web.PageTitle>Held Sales</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Spacing="4">
        <MudStack Row="true" Class="justify-between align-center">
            <MudText Typo="Typo.h4">Held Sales / Pending Transactions</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <StoreContextSelector ShowAllOption="_isAdmin" OnStoreChanged="OnStoreChanged" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshList">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-2" />
                    Refresh
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (!FilteredHeldSales.Any())
        {
            <MudPaper Class="pa-8" Elevation="0">
                <MudStack Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="font-size: 48px;" Color="Color.Default" />
                    <MudText Typo="Typo.subtitle1">No held sales at this time</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack Spacing="3">
                    <MudStack Row="true" Spacing="2">
                        <MudTextField T="string" Label="Search by customer or items..." 
                                      @bind-Value="searchText" 
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="flex-grow-1" />
                        <MudSelect T="string?" Label="Filter" MultiSelection="false" 
                                  @bind-Value="filterAge"
                                  Variant="Variant.Outlined">
                            <MudSelectItem Value="@((string?)null)">All</MudSelectItem>
                            <MudSelectItem Value="@("today")">Held Today</MudSelectItem>
                            <MudSelectItem Value="@("week")">This Week</MudSelectItem>
                            <MudSelectItem Value="@("month")">This Month</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="bool?" Label="Status" MultiSelection="false" 
                                  @bind-Value="filterStatus"
                                  Variant="Variant.Outlined">
                            <MudSelectItem Value="@((bool?)null)">All</MudSelectItem>
                            <MudSelectItem Value="@false">Pending</MudSelectItem>
                            <MudSelectItem Value="@true">Completed</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudGrid>
                @foreach (var sale in FilteredHeldSales)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="@(sale.CompletedAt.HasValue ? 1 : 2)" Class="@(sale.CompletedAt.HasValue ? "mud-opacity-50" : "")">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="@(sale.CompletedAt.HasValue ? Color.Default : Color.Primary)" 
                                             TextAlign="System.Alignment.Center"
                                             Size="@(sale.CompletedAt.HasValue ? Size.Small : Size.Medium)">
                                        @sale.CustomerName?.Substring(0, 1).ToUpper()
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body2" Align="Align.Right">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1" Size="Size.Small" />
                                        @sale.HeldAt.ToLocalTime():g
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <div>
                                        <MudText Typo="Typo.body2"><strong>@(sale.CustomerName ?? "Walk-in")</strong></MudText>
                                        <MudText Typo="Typo.caption">Id: @sale.Id</MudText>
                                    </div>
                                    <MudDivider />
                                    <div>
                                        @if (sale.CompletedAt.HasValue)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                                Completed @sale.CompletedAt.Value.ToLocalTime():g
                                            </MudChip>
                                            <MudText Typo="Typo.caption">Completed by: @sale.CompletedBy</MudText>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Pending">
                                                Pending
                                            </MudChip>
                                        }
                                        <MudText Typo="Typo.caption">
                                            Items: @GetItemCount(sale.SerializedItems)
                                        </MudText>
                                    </div>
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions>
                                @if (!sale.CompletedAt.HasValue)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" 
                                              OnClick="@(() => ResumeHeldSale(sale))"
                                              Size="Size.Small">
                                        Resume
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" 
                                              OnClick="@(() => DiscardHeldSale(sale))"
                                              Size="Size.Small">
                                        Discard
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Default" 
                                              Disabled="true"
                                              Size="Size.Small">
                                        Completed
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private List<HeldSaleDto> _heldSales = [];
    private string searchText = "";
    private string? filterAge = null;
    private bool? filterStatus = null; // null = all, false = pending, true = completed
    private bool _isLoading = true;
    private Guid? _currentStoreId;
    private bool _initialized = false;
    private bool _isAdmin;
    private Guid? _userStoreId;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _isAdmin = user.IsInRole("Administrator");
        _userStoreId = Guid.TryParse(user.FindFirst("store_id")?.Value, out var sid) ? sid : null;

        SignalRService.HeldSaleCreated += OnHeldSaleCreated;
        SignalRService.HeldSaleCompleted += OnHeldSaleCompleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            
            try
            {
                // No store in context = all stores
                await LoadHeldSalesAsync(StoreContext.GetCurrentStoreId());
            }
            catch (Exception ex)
            {
                _isLoading = false;
                StateHasChanged();
                Snackbar.Add($"Error initializing Held Sales page: {ex.Message}", Severity.Error);
            }
        }
    }

    // storeId == null => all stores
    private async Task LoadHeldSalesAsync(Guid? storeId)
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // "All stores" is admin-only; others fall back to their own store (Guid.Empty = nothing)
            if (!storeId.HasValue && !_isAdmin)
                storeId = _userStoreId ?? Guid.Empty;

            _currentStoreId = storeId;

            // Use a separate scope to avoid concurrency issues with StoreContextSelector
            using var scope = ScopeFactory.CreateScope();
            var saleService = scope.ServiceProvider.GetRequiredService<ISaleService>();

            _heldSales = (await saleService.GetHeldSalesAsync(storeId)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading held sales: {ex.Message}", Severity.Error);
            _heldSales.Clear();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        // Own try: a hub failure must not wipe the data that loaded fine.
        // ponytail: live updates only for a single store (hub groups are per store); "All" relies on Refresh
        try
        {
            if (storeId.HasValue)
                await SignalRService.StartAsync(storeId.Value);
            else
                await SignalRService.StopAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Live updates unavailable: {ex.Message}", Severity.Warning);
        }
    }

    private void OnHeldSaleCreated(object data)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(data);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            var heldSaleId = root.GetProperty("HeldSaleId").GetGuid();
            var storeId = root.GetProperty("StoreId").GetGuid();
            var customerName = root.GetProperty("CustomerName").GetString();
            var serializedItems = root.GetProperty("SerializedItems").GetString();
            var itemCount = root.GetProperty("ItemCount").GetInt32();
            var heldAt = root.GetProperty("HeldAt").GetDateTime();
            
            // Check if this held sale is already in the list
            if (!_heldSales.Any(s => s.Id == heldSaleId))
            {
                var newHeldSale = new HeldSaleDto(
                    heldSaleId, storeId, heldAt, customerName, serializedItems ?? "[]", null, null);
                
                _heldSales.Insert(0, newHeldSale);
                InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing HeldSaleCreated: {ex.Message}");
        }
    }

    private void OnHeldSaleCompleted(object data)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(data);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            var heldSaleId = root.GetProperty("HeldSaleId").GetGuid();
            var completedBy = root.GetProperty("CompletedBy").GetString();
            var completedAt = root.GetProperty("CompletedAt").GetDateTime();
            
            var heldSale = _heldSales.FirstOrDefault(s => s.Id == heldSaleId);
            if (heldSale != null)
            {
                // Since HeldSaleDto is a record, we need to create a new instance
                var updatedHeldSale = heldSale with
                {
                    CompletedAt = completedAt,
                    CompletedBy = completedBy
                };
                
                var index = _heldSales.IndexOf(heldSale);
                _heldSales[index] = updatedHeldSale;
                InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing HeldSaleCompleted: {ex.Message}");
        }
    }

    private List<HeldSaleDto> FilteredHeldSales
    {
        get
        {
            var filtered = _heldSales.AsEnumerable();

            if (!string.IsNullOrEmpty(searchText))
                filtered = filtered.Where(s => 
                    (s.CustomerName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.SerializedItems?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

            if (filterAge != null)
            {
                var now = DateTime.UtcNow;
                filtered = filterAge switch
                {
                    "today" => filtered.Where(s => s.HeldAt.Date == now.Date),
                    "week" => filtered.Where(s => (now - s.HeldAt).TotalDays <= 7),
                    "month" => filtered.Where(s => (now - s.HeldAt).TotalDays <= 30),
                    _ => filtered
                };
            }

            if (filterStatus.HasValue)
            {
                filtered = filtered.Where(s => s.CompletedAt.HasValue == filterStatus.Value);
            }

            return filtered.OrderByDescending(s => s.HeldAt).ToList();
        }
    }

    private int GetItemCount(string serializedItems)
    {
        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<object>>(serializedItems);
            return items?.Count ?? 0;
        }
        catch
        {
            return 0;
        }
    }

    private async Task RefreshList()
    {
        await LoadHeldSalesAsync(_currentStoreId);
        Snackbar.Add("List refreshed", Severity.Info);
    }

    private async Task OnStoreChanged(Guid? storeId)
    {
        if (storeId != _currentStoreId)
        {
            await SignalRService.StopAsync();
            await LoadHeldSalesAsync(storeId);
        }
    }

    private async Task ResumeHeldSale(HeldSaleDto sale)
    {
        var parameters = new DialogParameters<HeldSaleResumeDialog>
        {
            { "Sale", sale }
        };
        var dialog = await DialogService.ShowAsync<HeldSaleResumeDialog>("Resume Sale", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is HeldSaleDto resumedSale)
        {
            // The held sale will be removed from the list when completed in POS
            // For now, refresh the list
            await LoadHeldSalesAsync(_currentStoreId);
            Snackbar.Add("Sale resumed - will be removed when completed in POS", Severity.Success);
        }
    }

    private async Task DiscardHeldSale(HeldSaleDto sale)
    {
        var confirmed = await DialogService.ShowAsync<ZEN.Shared.Components.Common.ConfirmDialog>(
            "Discard Sale",
            new DialogParameters { { "Message", $"Discard held sale '{sale.Id}' for {sale.CustomerName}?" } });

        var result = await confirmed.Result;
        if (!result.Canceled)
        {
            // In a real implementation, you'd call a service to delete the held sale
            // For now, just refresh
            await LoadHeldSalesAsync(_currentStoreId);
            Snackbar.Add("Sale discarded", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        SignalRService.HeldSaleCreated -= OnHeldSaleCreated;
        SignalRService.HeldSaleCompleted -= OnHeldSaleCompleted;
        await SignalRService.StopAsync();
    }
}
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Admin
@using Microsoft.Extensions.Logging

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}
else
{
    <MudMultiSelect T="Guid" 
              Label="Stores" 
              Dense="true"
              Value="@_selectedStoreIds"
              ValueChanged="@OnStoreSelectionChanged"
              Items="@_stores"
              ToStringFunc="@StoreToString"
              Placeholder="Select stores...">
    </MudMultiSelect>
}

@code {
    [Inject] private IStoreService StoreService { get; set; } = default!;
    [Inject] private ILogger<StoreFilter> Logger { get; set; } = default!;
    
    [Parameter] public List<Guid> SelectedStoreIds { get; set; } = new();
    [Parameter] public EventCallback<List<Guid>> SelectedStoreIdsChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private List<Guid> _selectedStoreIds = new();
    private List<StoreDto> _stores = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStoresAsync();
        _selectedStoreIds = SelectedStoreIds;
        _isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!SelectedStoreIds.SequenceEqual(_selectedStoreIds))
        {
            _selectedStoreIds = SelectedStoreIds;
        }
    }

    private async Task LoadStoresAsync()
    {
        try
        {
            Logger.LogInformation("Loading stores...");
            _stores = (await StoreService.GetAllAsync()).Where(s => !s.IsDeleted).ToList();
            Logger.LogInformation("Loaded {Count} stores", _stores.Count);
            foreach (var store in _stores)
            {
                Logger.LogInformation("Store: {Id} - {Name}", store.Id, store.Name);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading stores");
        }
    }

    private async Task OnStoreSelectionChanged(List<Guid> storeIds)
    {
        _selectedStoreIds = storeIds;
        await SelectedStoreIdsChanged.InvokeAsync(storeIds);
    }

    private string StoreToString(Guid storeId)
    {
        var store = _stores.FirstOrDefault(s => s.Id == storeId);
        return store?.Name ?? storeId.ToString();
    }
}
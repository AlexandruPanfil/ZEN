@page "/reports/employee"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Reports
@inject IReportService ReportService
@inject IStoreContext StoreContext
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Administrator,Manager,Accountant")]

<PageTitle>Employee Reports - ZEN POS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Employee Reports</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Start Date" @bind-Date="_startDate" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="End Date" @bind-Date="_endDate" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       OnClick="GenerateReport" 
                       StartIcon="@Icons.Material.Filled.Analytics"
                       FullWidth="true">
                Generate Report
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto" />
}
else if (_reportItems == null || !_reportItems.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
        Please select a date range and generate the report.
    </MudAlert>
}
else
{
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Shifts</MudText>
                    <MudText Typo="Typo.h4">@_reportItems.Count()</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Sales</MudText>
                    <MudText Typo="Typo.h4">@_totalSales.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Closed Shifts</MudText>
                    <MudText Typo="Typo.h4">@_closedShiftsCount</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" Class="mt-6 mb-2">Shift Details</MudText>
    <MudTable Items="@_reportItems" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_isLoading">
        <HeaderContent>
            <MudTh>Shift Number</MudTh>
            <MudTh>Opened At</MudTh>
            <MudTh>Closed At</MudTh>
            <MudTh>User Name</MudTh>
            <MudTh>Opening Cash</MudTh>
            <MudTh>Closing Cash</MudTh>
            <MudTh>Total Sales</MudTh>
            <MudTh>Variance</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Shift Number">@context.ShiftNumber</MudTd>
            <MudTd DataLabel="Opened At">@context.OpenedAt.ToString("g")</MudTd>
            <MudTd DataLabel="Closed At">@(context.ClosedAt?.ToString("g") ?? "Open")</MudTd>
            <MudTd DataLabel="User Name">@context.UserName</MudTd>
            <MudTd DataLabel="Opening Cash">@context.OpeningCash.ToString("C")</MudTd>
            <MudTd DataLabel="Closing Cash">@(context.ClosingCash?.ToString("C") ?? "—")</MudTd>
            <MudTd DataLabel="Total Sales">@context.TotalSales.ToString("C")</MudTd>
            <MudTd DataLabel="Variance">
                @if (context.Variance.HasValue)
                {
                    <MudText Color="@(context.Variance.Value >= 0 ? Color.Success : Color.Error)">
                        @context.Variance.Value.ToString("C")
                    </MudText>
                }
                else
                {
                    <span>—</span>
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? _endDate = DateTime.Today;
    private IEnumerable<ShiftReportDto> _reportItems = new List<ShiftReportDto>();
    private bool _isLoading = false;
    private decimal _totalSales = 0;
    private int _closedShiftsCount = 0;

    private async Task GenerateReport()
    {
        if (!_startDate.HasValue || !_endDate.HasValue)
        {
            Snackbar.Add("Please select both start and end dates.", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            var storeId = StoreContext.GetCurrentStoreId();
            _reportItems = await ReportService.GetShiftsReportAsync(_startDate.Value, _endDate.Value, storeId);
            _totalSales = _reportItems.Sum(r => r.TotalSales);
            _closedShiftsCount = _reportItems.Count(r => r.ClosedAt.HasValue);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
@page "/reports/financial"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Reports
@using ZEN.Web.Components.Pages.Reports.Filters
@inject IReportService ReportService
@inject IStoreContext StoreContext
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Administrator,Manager,Accountant")]

<PageTitle>Financial Reports - ZEN POS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Financial Reports</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="Start Date" Date="_filter.StartDate" DateChanged="@OnStartDateChanged" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="End Date" Date="_filter.EndDate" DateChanged="@OnEndDateChanged" />
        </MudItem>
        <MudItem xs="12" sm="12" md="6">
            <StoreFilter SelectedStoreIds="_filter.StoreIds" 
                         SelectedStoreIdsChanged="@((List<Guid> ids) => OnStoreIdsChanged(ids))" />
        </MudItem>
        <MudItem xs="12" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       OnClick="GenerateReport" 
                       StartIcon="@Icons.Material.Filled.Analytics"
                       FullWidth="true"
                       Disabled="_isLoading">
                @(_isLoading ? "Generating..." : "Generate Report")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto" />
}
else if (_report == null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
        Please select a date range and generate the report.
    </MudAlert>
}
else
{
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Sales</MudText>
                    <MudText Typo="Typo.h4">@_report.TotalSales.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Net Sales</MudText>
                    <MudText Typo="Typo.h4">@_report.NetSales.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Tax</MudText>
                    <MudText Typo="Typo.h4">@_report.TotalTax.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Discount</MudText>
                    <MudText Typo="Typo.h4">@_report.TotalDiscount.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" Class="mt-6 mb-2">Top Performing Products</MudText>
    <MudTable Items="@_report.TopProducts" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Product Name</MudTh>
            <MudTh>Quantity Sold</MudTh>
            <MudTh>Total Revenue</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Product Name">@context.ProductName</MudTd>
            <MudTd DataLabel="Quantity Sold">@context.Quantity</MudTd>
            <MudTd DataLabel="Total Revenue">@context.TotalSales.ToString("C")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h5" Class="mt-6 mb-2">Hierarchical Breakdown</MudText>
    <SalesBreakdownDisplay StoreBreakdowns="@_report.StoreBreakdowns" />
}

@code {
    private SalesReportFilterDto _filter = new(
        DateTime.Today.AddDays(-30),
        DateTime.Today,
        new List<Guid>(),
        new List<Guid>(),
        new List<Guid>(),
        new List<Guid>(),
        new List<Guid>());

    private SalesReportDto? _report;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // Pre-populate with current store
        var currentStoreId = StoreContext.GetCurrentStoreId();
        if (currentStoreId.HasValue)
        {
            _filter = _filter with { StoreIds = new List<Guid> { currentStoreId.Value } };
        }
    }

    private async Task GenerateReport()
    {
        _isLoading = true;
        try
        {
            _report = await ReportService.GetSalesReportAsync(_filter);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnStartDateChanged(DateTime? date)
    {
        if (date.HasValue)
            _filter = _filter with { StartDate = date.Value };
    }

    private async Task OnEndDateChanged(DateTime? date)
    {
        if (date.HasValue)
            _filter = _filter with { EndDate = date.Value };
    }

    private Task OnStoreIdsChanged(List<Guid> storeIds)
    {
        _filter = _filter with { StoreIds = storeIds };
        return Task.CompletedTask;
    }
}
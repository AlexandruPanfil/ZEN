@page "/brands"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Products
@using ZEN.Shared.Components.Common
@inject IBrandService BrandService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

<ZEN.Shared.Components.Common.PageTitle>Brands - ZEN POS</ZEN.Shared.Components.Common.PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Product Brands</MudText>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudTextField @bind-Value="_searchTerm" 
                      Label="Search Brands" 
                      Variant="Variant.Outlined" 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      OnKeyDown="@HandleKeyDown" 
                      Class="flex-grow-1 mr-4" />

        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenCreateDialog">
            Add Brand
        </MudButton>
    </div>

    <MudTable Items="@FilteredBrands" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoading" LoadingProgressColor="Color.Info">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Brands List</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@_brandDescriptions.GetValueOrDefault(context.Id, "—")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(_brandActiveStatus.GetValueOrDefault(context.Id, true) ? Color.Success : Color.Error)" Size="Size.Small">
                    @(_brandActiveStatus.GetValueOrDefault(context.Id, true) ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteBrand(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

<!-- Create/Edit Dialog -->
<MudDialog @bind-Visible="_isDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditMode ? "Edit Brand" : "Create Brand")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Label="Brand Name" 
                                  @bind-Value="_editingBrand.Name" 
                                  Required="true" 
                                  For="@(() => _editingBrand.Name)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Description" 
                                  @bind-Value="_editingBrand.Description" 
                                  For="@(() => _editingBrand.Description)" 
                                  Multiline="true" 
                                  Lines="3" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_editingBrand.IsActive" Color="Color.Primary" Label="Active" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="SaveBrand"
                   Disabled="!_formIsValid">
            @(_isEditMode ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<BrandDto> _brands = new();
    private Dictionary<Guid, string> _brandDescriptions = new();
    private Dictionary<Guid, bool> _brandActiveStatus = new();

    private string _searchTerm = string.Empty;
    private bool _isLoading = false;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm? _form;

    private BrandEditModel _editingBrand = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBrandsAsync();
    }

    private async Task LoadBrandsAsync()
    {
        _isLoading = true;
        try
        {
            _brands = (await BrandService.GetAllAsync()).ToList();
            _brandDescriptions.Clear();
            _brandActiveStatus.Clear();
            foreach (var brand in _brands)
            {
                _brandDescriptions[brand.Id] = "—";
                _brandActiveStatus[brand.Id] = true;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading brands: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<BrandDto> FilteredBrands =>
        _brands.Where(b => string.IsNullOrEmpty(_searchTerm) || 
                          b.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchTerm = _searchTerm.Trim();
        }
    }

    private void OpenCreateDialog()
    {
        _editingBrand = new BrandEditModel();
        _isEditMode = false;
        _isDialogOpen = true;
    }

    private void OpenEditDialog(BrandDto brand)
    {
        _editingBrand = new BrandEditModel
        {
            Id = brand.Id,
            Name = brand.Name,
            Description = null,
            IsActive = true
        };
        _isEditMode = true;
        _isDialogOpen = true;
    }

    private async Task SaveBrand()
    {
        if (_form == null)
            return;

        _form.Validate();
        if (!_formIsValid)
            return;

        try
        {
            if (_isEditMode)
            {
                var request = new UpdateBrandRequest(
                    _editingBrand.Id,
                    _editingBrand.Name,
                    _editingBrand.Description,
                    _editingBrand.IsActive);

                await BrandService.UpdateAsync(request);
                Snackbar.Add("Brand updated successfully", Severity.Success);
            }
            else
            {
                var request = new CreateBrandRequest(
                    _editingBrand.Name,
                    _editingBrand.Description,
                    _editingBrand.IsActive);

                await BrandService.CreateAsync(request);
                Snackbar.Add("Brand created successfully", Severity.Success);
            }

            CloseDialog();
            await LoadBrandsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving brand: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteBrand(BrandDto brand)
    {
        var confirm = await DialogService.ShowAsync<ZEN.Shared.Components.Common.ConfirmDialog>("Delete Brand",
            new DialogParameters { { "Message", $"Are you sure you want to delete '{brand.Name}'?" } });

        var result = await confirm.Result;
        if (!result.Canceled)
        {
            try
            {
                await BrandService.DeleteAsync(brand.Id);
                Snackbar.Add("Brand deleted successfully", Severity.Success);
                await LoadBrandsAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting brand: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog()
    {
        _isDialogOpen = false;
        _editingBrand = new();
    }

    public class BrandEditModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}

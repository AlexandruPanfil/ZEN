@page "/taxes"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Shared.Components.Common
@inject ITaxService TaxService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@attribute [Authorize(Roles = "Administrator,Manager")]

@* <PageTitle>Tax Rates - ZEN POS</PageTitle> *@

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">Tax Management</MudText>

    <MudPaper Class="pa-2 mb-4" Outlined="true">
        <div class="d-flex align-center justify-space-between">
            <MudTextField @bind-Value="_searchTerm" 
                          Label="Search Tax Rates" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          OnKeyDown="@HandleKeyDown" 
                          Class="flex-grow-1 mr-4" />

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="OpenCreateDialog">
                Add Tax Rate
            </MudButton>
        </div>
    </MudPaper>

    <MudTable Items="@FilteredTaxes" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoading" LoadingProgressColor="Color.Info">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Tax Rates List</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Name</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Rate (%)</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Default</MudText></MudTh>
            <MudTh><MudText Typo="Typo.body2" Class="font-weight-bold">Status</MudText></MudTh>
            <MudTh Style="text-align:right"><MudText Typo="Typo.body2" Class="font-weight-bold">Actions</MudText></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><MudText Typo="Typo.body2">@context.Name</MudText></MudTd>
            <MudTd DataLabel="Rate"><MudText Typo="Typo.body2">@context.Rate.ToString("F2")%</MudText></MudTd>
            <MudTd DataLabel="Default">
                @if (context.IsDefault)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                }
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small" Class="ma-0">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                @if (!context.IsDefault)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Star" 
                                   Color="Color.Warning" 
                                   Size="Size.Small"
                                   Title="Set as default"
                                   OnClick="@(() => SetDefaultTax(context))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTax(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Create/Edit Dialog -->
<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@(_isEditMode ? "Edit Tax Rate" : "Create Tax Rate")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Tax Name" 
                                  @bind-Value="_editingTax.Name" 
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" 
                                  For="@(() => _editingTax.Name)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_editingTax.Rate" 
                                     Label="Tax Rate (%)" 
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" 
                                     Max="100" 
                                     Format="F2"
                                     For="@(() => _editingTax.Rate)" 
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_editingTax.IsActive" Color="Color.Primary" Label="Active" Dense="true" />
                </MudItem>
                @if (_isEditMode)
                {
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_editingTax.IsDefault" 
                                   Color="Color.Warning" 
                                   Label="Set as Default Tax" 
                                   Dense="true" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   Size="Size.Small"
                   OnClick="SaveTax"
                   Disabled="!_formIsValid">
            @(_isEditMode ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TaxDto> _taxes = new();

    private string _searchTerm = string.Empty;
    private bool _isLoading = false;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm? _form;

    private TaxEditModel _editingTax = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTaxesAsync();
    }

    private async Task LoadTaxesAsync()
    {
        _isLoading = true;
        try
        {
            _taxes = (await TaxService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading tax rates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<TaxDto> FilteredTaxes =>
        _taxes.Where(t => string.IsNullOrEmpty(_searchTerm) || 
                         t.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchTerm = _searchTerm.Trim();
        }
    }

    private void OpenCreateDialog()
    {
        _editingTax = new TaxEditModel();
        _isEditMode = false;
        _isDialogOpen = true;
    }

    private void OpenEditDialog(TaxDto tax)
    {
        _editingTax = new TaxEditModel
        {
            Id = tax.Id,
            Name = tax.Name,
            Rate = tax.Rate,
            IsDefault = tax.IsDefault,
            IsActive = tax.IsActive
        };
        _isEditMode = true;
        _isDialogOpen = true;
    }

    private async Task SaveTax()
    {
        if (_form == null)
            return;

        _form.Validate();
        if (!_formIsValid)
            return;

        try
        {
            if (_isEditMode)
            {
                var request = new UpdateTaxRequest(
                    _editingTax.Id,
                    _editingTax.Name,
                    _editingTax.Rate,
                    _editingTax.IsDefault,
                    _editingTax.IsActive);

                await TaxService.UpdateAsync(request);
                Snackbar.Add("Tax rate updated successfully", Severity.Success);
            }
            else
            {
                var request = new CreateTaxRequest(
                    _editingTax.Name,
                    _editingTax.Rate,
                    _editingTax.IsActive);

                await TaxService.CreateAsync(request);
                Snackbar.Add("Tax rate created successfully", Severity.Success);
            }

            CloseDialog();
            await LoadTaxesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving tax rate: {ex.Message}", Severity.Error);
        }
    }

    private async Task SetDefaultTax(TaxDto tax)
    {
        try
        {
            await TaxService.SetDefaultTaxAsync(tax.Id);
            Snackbar.Add($"Default tax set to '{tax.Name}'", Severity.Success);
            await LoadTaxesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error setting default tax: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteTax(TaxDto tax)
    {
        var confirm = await DialogService.ShowAsync<ConfirmDialog>("Delete Tax Rate",
            new DialogParameters { { "Message", $"Are you sure you want to delete '{tax.Name}'?" } });

        var result = await confirm.Result;
        if (!result.Canceled)
        {
            try
            {
                await TaxService.DeleteAsync(tax.Id);
                Snackbar.Add("Tax rate deleted successfully", Severity.Success);
                await LoadTaxesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting tax rate: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog()
    {
        _isDialogOpen = false;
        _editingTax = new();
    }

    public class TaxEditModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Rate { get; set; }
        public bool IsDefault { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
@page "/products"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Products
@using ZEN.Web.Components.Dialogs
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IProductGroupService ProductGroupService
@inject ITaxService TaxService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Administrator,Manager,InventoryManager")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Products Catalog - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 px-2">
    <!-- Top Minimal Action Workspace Line -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Products Matrix</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   OnClick="OpenCreateDialog">
            Add Product Entry
        </MudButton>
    </div>

    <MudGrid Spacing="2">
        <!-- LEFT DATA PANEL: CORE PRODUCTS MATRIX WORKSPACE -->
        <MudItem xs="12" md="9">
            <!-- Inline Search Toolbar Filtering Node -->
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="Filter live warehouse records matching search criteria..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="@HandleKeyDown"
                              Clearable="true"
                              OnClearButtonClick="LoadProducts"
                              Margin="Margin.Dense"
                              Style="font-size: 0.8rem;" />
            </MudPaper>

            <!-- COMPACT PRODUCT LEDGER VIEWPORTS -->
            <MudTable T="ProductDto" Items="@_products" Hover="true" Striped="true" Outlined="true" Dense="true" Breakpoint="Breakpoint.Md" Loading="@_isLoading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;"><MudTableSortLabel SortBy="new Func<ProductDto, object>(x => x.Name)">Identity Designation</MudTableSortLabel></MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">SKU Code</MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">Barcode ID</MudTh>
                    <MudTh Style="text-align: right; font-size: 0.77rem; font-weight: 700;"><MudTableSortLabel SortBy="new Func<ProductDto, object>(x => x.CostPrice)">Cost Price</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align: right; font-size: 0.77rem; font-weight: 700;"><MudTableSortLabel SortBy="new Func<ProductDto, object>(x => x.SalePrice)">Retail Price</MudTableSortLabel></MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">Category</MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">Product Group</MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">Tax (TVA)</MudTh>
                    <MudTh Style="font-size: 0.77rem; font-weight: 700;">Status</MudTh>
                    <MudTh Style="text-align: right; min-width: 90px; font-size: 0.77rem; font-weight: 700;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="product">
                    <MudTd DataLabel="Name" Class="font-weight-bold" Style="font-size: 0.78rem; padding: 4px 8px;">@product.Name</MudTd>
                    <MudTd DataLabel="SKU" Style="font-size: 0.75rem; padding: 4px 8px;">
                        <code class="px-1 font-monospace style-code-box">@(string.IsNullOrWhiteSpace(product.SKU) ? "—" : product.SKU)</code>
                    </MudTd>
                    <MudTd DataLabel="Barcode" Style="font-size: 0.75rem; padding: 4px 8px;">@(string.IsNullOrWhiteSpace(product.Barcode) ? "—" : product.Barcode)</MudTd>
                    <MudTd DataLabel="Cost" Style="text-align: right; font-size: 0.75rem; padding: 4px 8px;">@product.CostPrice.ToString("C")</MudTd>
                    <MudTd DataLabel="Sale Price" Style="text-align: right; font-size: 0.75rem; padding: 4px 8px;" Class="font-weight-bold text-success">@product.SalePrice.ToString("C")</MudTd>
                    <MudTd DataLabel="Category" Style="font-size: 0.75rem; padding: 4px 8px;">@product.CategoryName</MudTd>
                    <MudTd DataLabel="Product Group" Style="font-size: 0.75rem; padding: 4px 8px;">@product.ProductGroupName</MudTd>
                    <MudTd DataLabel="Tax" Style="font-size: 0.75rem; padding: 4px 8px;">@(product.TaxName != null ? $"{product.TaxName} ({product.TaxRate}%)" : "—")</MudTd>
                    <MudTd DataLabel="Status" Style="padding: 2px 8px;">
                        <MudChip T="string" Color="@(product.IsActive ? Color.Success : Color.Error)" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold pa-0" Style="font-size: 0.72rem; margin: 0;">
                            @(product.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap; padding: 2px 8px;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" Class="pa-1" OnClick="@(() => OpenEditDialog(product))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Class="pa-1" OnClick="@(() => DeleteProduct(product))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="pa-3" Style="font-size: 0.75rem;">No matching storage items located.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Rows View:" Style="font-size: 0.72rem;" />
                </PagerContent>
            </MudTable>
        </MudItem>

        <!-- RIGHT UTILITY PANEL: TAXONOMY SUB-CRUD ENGINE -->
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">System Lookups</MudText>
                    <MudToggleGroup T="string" @bind-Value="_activeLookupTab" Color="Color.Primary" Size="Size.Small" Outline="true">
                        <MudToggleItem Value="@("categories")">Categories</MudToggleItem>
                        <MudToggleItem Value="@("product-groups")">Product Groups</MudToggleItem>
                    </MudToggleGroup>
                </div>

                @if (_activeLookupTab == "categories")
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">Product Categories Registry</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="OpenInlineCategoryDialog" />
                    </div>
                    <div style="max-height: 520px; overflow-y: auto;">
                        <MudList T="CategoryDto" Dense="true" Clickable="false" Class="pa-0">
                            @foreach (var cat in _displayCategories)
                            {
                                var depth = GetDepth(_displayCategories, cat.Id);
                                var prefix = GetTreePrefix(_displayCategories, cat.Id, depth);
                                <div class="d-flex align-center justify-space-between mud-width-full py-1 border-bottom border-solid mud-border-default" style="padding-left: @(depth * 20)px;">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">@(prefix)@cat.Name</MudText>
                                    </div>
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" Class="pa-1" OnClick="() => OpenEditCategoryInline(cat)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="pa-1" OnClick="() => DeleteCategoryInline(cat)" />
                                    </div>
                                </div>
                            }
                        </MudList>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">Product Groups Registry</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="OpenInlineProductGroupDialog" />
                    </div>
                    <div style="max-height: 520px; overflow-y: auto;">
                        <MudList T="ProductGroupDto" Dense="true" Clickable="false" Class="pa-0">
                            @foreach (var pg in _displayProductGroups)
                            {
                                var depth = GetDepth(_displayProductGroups, pg.Id);
                                var prefix = GetTreePrefix(_displayProductGroups, pg.Id, depth);
                                <div class="d-flex align-center justify-space-between mud-width-full py-1 border-bottom border-solid mud-border-default" style="padding-left: @(depth * 20)px;">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">@(prefix)@pg.Name</MudText>
                                    </div>
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" Class="pa-1" OnClick="() => OpenEditProductGroupInline(pg)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="pa-1" OnClick="() => DeleteProductGroupInline(pg)" />
                                    </div>
                                </div>
                            }
                        </MudList>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- Edit/Create Entity Structural Flyout Dialog -->
<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.EditNote : Icons.Material.Filled.PostAdd)" Class="mr-2" />
            @(_isEditMode ? $"Modify Product: {_editingProduct.Name}" : "Establish New Product Unit Node")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2" Class="py-1">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Product Standard Designation Name" Variant="Variant.Outlined" @bind-Value="_editingProduct.Name" Required="true" For="@(() => _editingProduct.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Stock Keeping Unit (SKU Tag)" Variant="Variant.Outlined" @bind-Value="_editingProduct.SKU" For="@(() => _editingProduct.SKU)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="EAN / Barcode Value Code" Variant="Variant.Outlined" @bind-Value="_editingProduct.Barcode" For="@(() => _editingProduct.Barcode)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Assigned Taxonomical Category" Variant="Variant.Outlined" @bind-Value="_editingProduct.CategoryId" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        <MudSelectItem T="Guid?" Value="@(null)">Unassigned / Base Context</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Tax Rate (TVA)" Variant="Variant.Outlined" @bind-Value="_editingProduct.TaxId" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        <MudSelectItem T="Guid?" Value="@(null)">No Tax / Exempt</MudSelectItem>
                        @foreach (var tax in _taxes.Where(t => t.IsActive))
                        {
                            <MudSelectItem T="Guid?" Value="@tax.Id">@tax.Name (@tax.Rate%)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Product Group" Variant="Variant.Outlined" @bind-Value="_editingProduct.ProductGroupId" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        <MudSelectItem T="Guid?" Value="@(null)">Unassigned / Base Context</MudSelectItem>
                        @foreach (var pg in _displayProductGroups)
                        {
                            <MudSelectItem T="Guid?" Value="@pg.Id">@pg.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center h-100 ps-1">
                        @if (_isEditMode)
                        {
                            <MudSwitch @bind-Value="_editingProduct.IsActive" Color="Color.Primary" Label="Active and tradable inside POS instances" Dense="true" Style="font-size: 0.75rem;" />
                        }
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField Label="Base Core Purchase Cost" Variant="Variant.Outlined" @bind-Value="_editingProduct.CostPrice" Format="C" Min="0.00m" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField Label="Standard Outbound Retail Price" Variant="Variant.Outlined" @bind-Value="_editingProduct.SalePrice" Format="C" Min="0.00m" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Detailed Inventory Description Manifest" Variant="Variant.Outlined" @bind-Value="_editingProduct.Description" For="@(() => _editingProduct.Description)" Multiline="true" Lines="2" Style="font-size: 0.8rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProduct" Disabled="@(!_formIsValid)" Size="Size.Small">Save Product</MudButton>
    </DialogActions>
</MudDialog>

<!-- Sub-Dialog Wrapper for Category CRUD Forms -->
<MudDialog @bind-Visible="_isCategoryDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" /> @(_isLookupEditMode ? "Modify Category" : "Add Category Entry")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_categoryForm" @bind-IsValid="@_categoryFormIsValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Category Name" Variant="Variant.Outlined" @bind-Value="_editingCategory.Name" Required="true" For="@(() => _editingCategory.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Description" Variant="Variant.Outlined" @bind-Value="_editingCategory.Description" Multiline="true" Lines="2" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Guid?" Label="Parent Category" Variant="Variant.Outlined" @bind-Value="_editingCategory.ParentCategoryId" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        <MudSelectItem T="Guid?" Value="@null">None</MudSelectItem>
                        @foreach (var cat in _displayCategories.Where(c => c.Id != _editingCategory.Id))
                        {
                            <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_editingCategory.SortOrder" Label="Sort Order" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_editingCategory.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="(() => _isCategoryDialogOpen = false)" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCategoryInline" Disabled="@(!_categoryFormIsValid)" Size="Size.Small">@(_isLookupEditMode ? "Update" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

<!-- Sub-Dialog Wrapper for Product Group CRUD Forms -->
<MudDialog @bind-Visible="_isProductGroupDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" /> @(_isLookupEditMode ? "Modify Product Group" : "Add Product Group Entry")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_productGroupForm" @bind-IsValid="@_productGroupFormIsValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Product Group Name" Variant="Variant.Outlined" @bind-Value="_editingProductGroup.Name" Required="true" For="@(() => _editingProductGroup.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Description" Variant="Variant.Outlined" @bind-Value="_editingProductGroup.Description" Multiline="true" Lines="2" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Guid?" Label="Parent Group" Variant="Variant.Outlined" @bind-Value="_editingProductGroup.ParentGroupId" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        <MudSelectItem T="Guid?" Value="@null">None</MudSelectItem>
                        @foreach (var pg in _displayProductGroups.Where(c => c.Id != _editingProductGroup.Id))
                        {
                            <MudSelectItem T="Guid?" Value="@pg.Id">@pg.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_editingProductGroup.SortOrder" Label="Sort Order" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_editingProductGroup.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="(() => _isProductGroupDialogOpen = false)" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProductGroupInline" Disabled="@(!_productGroupFormIsValid)" Size="Size.Small">@(_isLookupEditMode ? "Update" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .style-code-box {
        background-color: var(--mud-palette-background-grey);
        border-radius: 4px;
        letter-spacing: 0.5px;
        font-size: 0.72rem;
    }
</style>

@code {
    private IEnumerable<ProductDto> _products = new List<ProductDto>();
    private IEnumerable<CategoryDto> _categories = new List<CategoryDto>();
    private IEnumerable<ProductGroupDto> _productGroups = new List<ProductGroupDto>();
    private IEnumerable<TaxDto> _taxes = new List<TaxDto>();

    private string _searchTerm = string.Empty;
    private string _activeLookupTab = "categories";
    private bool _isLoading = true;

    // Window visibility toggles
    private bool _isDialogOpen = false;
    private bool _isCategoryDialogOpen = false;
    private bool _isProductGroupDialogOpen = false;
    private bool _isEditMode = false;
    private bool _isLookupEditMode = false;

    // Validation variables
    private bool _formIsValid = false;
    private bool _categoryFormIsValid = false;
    private bool _productGroupFormIsValid = false;

    private MudForm _form = default!;
    private MudForm _categoryForm = default!;
    private MudForm _productGroupForm = default!;

    // View Models
    private ProductFormModel _editingProduct = new();
    private CategoryFormModel _editingCategory = new();
    private ProductGroupFormModel _editingProductGroup = new();

    private List<ProductGroupDto> _displayProductGroups = new();
    private List<CategoryDto> _displayCategories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadProducts();
    }

    private async Task LoadLookups()
    {
        try
        {
            _categories = await CategoryService.GetAllAsync();
            _displayCategories = OrderHierarchically(_categories).ToList();
            _productGroups = await ProductGroupService.GetAllAsync();
            _displayProductGroups = OrderHierarchically(_productGroups).ToList();
            _taxes = await TaxService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        try
        {
            _products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchProducts();
    }

    private async Task SearchProducts()
    {
        _isLoading = true;
        try
        {
            _products = string.IsNullOrWhiteSpace(_searchTerm)
                ? await ProductService.GetAllAsync()
                : await ProductService.SearchAsync(_searchTerm);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingProduct = new ProductFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(ProductDto product)
    {
        _isEditMode = true;
        _editingProduct = new ProductFormModel
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Barcode = product.Barcode,
            SKU = product.SKU,
            CostPrice = product.CostPrice,
            SalePrice = product.SalePrice,
            CategoryId = product.CategoryId,
            ProductGroupId = product.ProductGroupId,
            TaxId = product.TaxId,
            IsActive = product.IsActive
        };
        _isDialogOpen = true;
    }

    // Inline structural interactions for Category models
    private void OpenInlineCategoryDialog()
    {
        _isLookupEditMode = false;
        _editingCategory = new CategoryFormModel();
        _isCategoryDialogOpen = true;
    }

    private void OpenEditCategoryInline(CategoryDto item)
    {
        _isLookupEditMode = true;
        _editingCategory = new CategoryFormModel
        {
            Id = item.Id,
            Name = item.Name,
            ParentCategoryId = item.ParentCategoryId,
            IsActive = true
        };
        _isCategoryDialogOpen = true;
    }

    private async Task SaveCategoryInline()
    {
        _categoryForm.Validate();
        if (!_categoryFormIsValid) return;

        try
        {
            if (_isLookupEditMode)
            {
                var request = new UpdateCategoryRequest(_editingCategory.Id, _editingCategory.Name, _editingCategory.Description, _editingCategory.ParentCategoryId, _editingCategory.SortOrder, _editingCategory.IsActive);
                await CategoryService.UpdateAsync(request);
                Snackbar.Add("Category mapping altered.", Severity.Success);
            }
            else
            {
                var request = new CreateCategoryRequest(_editingCategory.Name, _editingCategory.Description, _editingCategory.ParentCategoryId, _editingCategory.SortOrder, _editingCategory.IsActive);
                await CategoryService.CreateAsync(request);
                Snackbar.Add("Category node recorded.", Severity.Success);
            }
            await LoadLookups();
            _isCategoryDialogOpen = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteCategoryInline(CategoryDto item)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Drop active structural category link: {item.Name}?" };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Purge Category Link", parameters);
        var result = await dialog.Result;


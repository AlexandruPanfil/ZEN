    private static IEnumerable<ProductGroupDto> OrderHierarchically(IEnumerable<ProductGroupDto> groups)
    {
        var groupsList = groups.ToList();
        var childrenByParent = groupsList
            .Where(g => g.ParentGroupId.HasValue)
            .GroupBy(g => g.ParentGroupId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.SortOrder).ToList());

        var result = new List<ProductGroupDto>();
        var roots = groupsList.Where(g => !g.ParentGroupId.HasValue).OrderBy(g => g.SortOrder).ToList();

        foreach (var root in roots)
        {
            AddGroupAndChildren(root, childrenByParent, result);
        }

        return result;
    }

    private static void AddGroupAndChildren(ProductGroupDto group, Dictionary<Guid, List<ProductGroupDto>> childrenByParent, List<ProductGroupDto> result)
    {
        result.Add(group);
        if (childrenByParent.TryGetValue(group.Id, out var children))
        {
            foreach (var child in children)
            {
                AddGroupAndChildren(child, childrenByParent, result);
            }
        }
    }

    private static IEnumerable<CategoryDto> OrderHierarchically(IEnumerable<CategoryDto> categories)
    {
        var categoriesList = categories.ToList();
        var childrenByParent = categoriesList
            .Where(c => c.ParentCategoryId.HasValue)
            .GroupBy(c => c.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.SortOrder).ToList());

        var result = new List<CategoryDto>();
        var roots = categoriesList.Where(c => !c.ParentCategoryId.HasValue).OrderBy(c => c.SortOrder).ToList();

        foreach (var root in roots)
        {
            AddCategoryAndChildren(root, childrenByParent, result);
        }

        return result;
    }

    private static void AddCategoryAndChildren(CategoryDto category, Dictionary<Guid, List<CategoryDto>> childrenByParent, List<CategoryDto> result)
    {
        result.Add(category);
        if (childrenByParent.TryGetValue(category.Id, out var children))
        {
            foreach (var child in children)
            {
                AddCategoryAndChildren(child, childrenByParent, result);
            }
        }
    }

    private static int GetDepth<T>(List<T> items, Guid id) where T : class
    {
        var item = items.FirstOrDefault(i => i.GetType().GetProperty("Id")?.GetValue(i)?.Equals(id) == true);
        if (item == null) return 0;

        var parentIdProp = item.GetType().GetProperty("ParentCategoryId") ?? item.GetType().GetProperty("ParentGroupId");
        if (parentIdProp == null) return 0;

        var parentId = parentIdProp.GetValue(item) as Guid?;
        if (!parentId.HasValue) return 0;

        return 1 + GetDepth(items, parentId.Value);
    }

    private static string GetTreePrefix<T>(List<T> items, Guid id, int depth) where T : class
    {
        if (depth == 0) return "";
        
        var item = items.FirstOrDefault(i => i.GetType().GetProperty("Id")?.GetValue(i)?.Equals(id) == true);
        if (item == null) return new string(' ', depth * 2) + "└─ ";

        var parentIdProp = item.GetType().GetProperty("ParentCategoryId") ?? item.GetType().GetProperty("ParentGroupId");
        var childrenPropName = item.GetType().GetProperty("ParentCategoryId") != null ? "SubCategories" : "SubGroups";
        
        var parentId = parentIdProp?.GetValue(item) as Guid?;
        if (!parentId.HasValue) return new string(' ', depth * 2) + "└─ ";

        // Check if this is the last child of its parent
        var parent = items.FirstOrDefault(i => i.GetType().GetProperty("Id")?.GetValue(i)?.Equals(parentId.Value) == true);
        if (parent == null) return new string(' ', depth * 2) + "└─ ";

        var childrenProp = parent.GetType().GetProperty(childrenPropName);
        var children = childrenProp?.GetValue(parent) as System.Collections.IEnumerable;
        if (children == null) return new string(' ', depth * 2) + "└─ ";

        var childrenList = children.Cast<T>().ToList();
        var lastChild = childrenList.LastOrDefault();
        var lastChildId = lastChild?.GetType().GetProperty("Id")?.GetValue(lastChild);
        
        if (lastChildId?.Equals(id) == true)
            return new string(' ', (depth - 1) * 2) + "└─ ";
        else
            return new string(' ', (depth - 1) * 2) + "├─ ";
    }

    // Unified Root item drag handlers (for Products, MenuGroups, and GroupReferences)
    private enum RootDragItemType { Product, MenuGroup, GroupReference }
    
    private void OnRootItemDragStart(DragEventArgs e, RootDragItemType type, Guid id)
    {
        _draggedRootItem = (type, id);
    }

    private void OnRootItemDragOver(DragEventArgs e)
    {
        // Global document listeners handle preventDefault
    }

    private async Task OnRootItemDrop(DragEventArgs e, RootDragItemType targetType, Guid targetId)
    {
        if (_draggedRootItem.HasValue && (_draggedRootItem.Value.Type != targetType || _draggedRootItem.Value.Id != targetId))
        {
            await ReorderRootItems(_draggedRootItem.Value.Type, _draggedRootItem.Value.Id, targetType, targetId);
        }
        _draggedRootItem = null;
    }

    private void OnRootItemDragEnd(DragEventArgs e)
    {
        _draggedRootItem = null;
    }

    private async Task ReorderRootItems(RootDragItemType draggedType, Guid draggedId, RootDragItemType targetType, Guid targetId)
    {
        if (_menu == null) return;

        try
        {
            // Get all root items in current order
            var rootItems = GetRootItems().ToList();
            
            // Find indices
            var draggedIndex = rootItems.FindIndex(i => 
                (IsProduct(i) && draggedType == RootDragItemType.Product && GetItem(i).Id == draggedId) ||
                (IsMenuGroup(i) && draggedType == RootDragItemType.MenuGroup && GetItem(i).Id == draggedId) ||
                (IsGroupReference(i) && draggedType == RootDragItemType.GroupReference && GetItem(i).Id == draggedId));
            
            var targetIndex = rootItems.FindIndex(i => 
                (IsProduct(i) && targetType == RootDragItemType.Product && GetItem(i).Id == targetId) ||
                (IsMenuGroup(i) && targetType == RootDragItemType.MenuGroup && GetItem(i).Id == targetId) ||
                (IsGroupReference(i) && targetType == RootDragItemType.GroupReference && GetItem(i).Id == targetId));

            if (draggedIndex >= 0 && targetIndex >= 0 && draggedIndex != targetIndex)
            {
                // Move the item
                var draggedItem = rootItems[draggedIndex];
                rootItems.RemoveAt(draggedIndex);
                rootItems.Insert(targetIndex, draggedItem);

                // Build the reorder request
                var itemsInOrder = rootItems.Select((item, index) => 
                {
                    var type = IsProduct(item) ? RootItemType.Product : 
                               IsMenuGroup(item) ? RootItemType.MenuGroup : 
                               RootItemType.GroupReference;
                    var id = GetItem(item).Id;
                    return new RootItemOrder(type, id, index);
                }).ToList();

                var request = new ReorderMenuRootItemsRequest(MenuId, itemsInOrder);
                var updatedMenu = await MenuService.ReorderMenuRootItemsAsync(request);
                if (updatedMenu != null)
                {
                    _menu = updatedMenu;
                    Snackbar.Add("Items reordered", Severity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reordering items: {ex.Message}", Severity.Error);
            _menu = await MenuService.GetByIdAsync(MenuId);
        }
    }


private async Task ReorderProducts(Guid draggedProductId, string draggedGroupId, Guid targetProductId, string targetGroupId)
        {
            // For now, only support reordering within the same group
            // Cross-group drag-and-drop would require more complex logic
            if (draggedGroupId != targetGroupId)
            {
                Snackbar.Add("Moving products between groups not yet supported", Severity.Warning);
                return;
            }
            
            if (targetGroupId == "root")
            {
                Snackbar.Add("Reordering root products not yet implemented", Severity.Warning);
                return;
            }
            
            try
            {
                var group = _menu?.Groups.FirstOrDefault(g => g.Id == Guid.Parse(targetGroupId));
                if (group == null) return;
                
                var products = group.Products.OrderBy(p => p.Position).ToList();
                var draggedIndex = products.FindIndex(p => p.ProductId == draggedProductId);
                var targetIndex = products.FindIndex(p => p.ProductId == targetProductId);
                
                if (draggedIndex >= 0 && targetIndex >= 0 && draggedIndex != targetIndex)
                {
                    var draggedProduct = products[draggedIndex];
                    products.RemoveAt(draggedIndex);
                    products.Insert(targetIndex, draggedProduct);
                    
                    var productIdsInOrder = products.Select(p => p.ProductId).ToList();
                    var request = new ReorderMenuGroupProductsRequest(Guid.Parse(targetGroupId), productIdsInOrder);
                    var updatedMenu = await MenuService.ReorderMenuGroupProductsAsync(request);
                    if (updatedMenu != null)
                    {
                        _menu = updatedMenu;
                        Snackbar.Add("Products reordered", Severity.Success);
                    }
}
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reordering products: {ex.Message}", Severity.Error);
            _menu = await MenuService.GetByIdAsync(MenuId);
        }
    }


    private async Task AddGroupToRoot()
    {
        try
        {
            var allGroups = await MenuService.GetGroupsAsync();
            if (!allGroups.Any())
            {
                Snackbar.Add("No groups available", Severity.Warning);
                return;
            }

            // Filter out groups already in this menu (both MenuGroups and GroupReferences)
            var existingGroupIds = new HashSet<Guid>();
            if (_menu != null)
            {
                foreach (var g in _menu.Groups) existingGroupIds.Add(g.Id);
                foreach (var g in _menu.GroupReferences) existingGroupIds.Add(g.GroupId);
            }

            var availableGroups = allGroups.Where(g => !existingGroupIds.Contains(g.Id)).ToList();
            if (!availableGroups.Any())
            {
                Snackbar.Add("All groups are already in this menu", Severity.Info);
                return;
            }

            var parameters = new DialogParameters<GroupSelectionDialog>
            {
                { nameof(GroupSelectionDialog.Groups), availableGroups },
                { nameof(GroupSelectionDialog.Title), "Select Group to Add" }
            };
            var dialog = await DialogService.ShowAsync<GroupSelectionDialog>("Select Group", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
            var result = await dialog.Result;
            if (!result.Canceled && result.Data is GroupDto selectedGroup)
            {
                var position = GetRootItems().Count();
                var request = new AddGroupToMenuRequest(MenuId, selectedGroup.Id, position);
                await MenuService.AddGroupAsync(request);
                _menu = await MenuService.GetByIdAsync(MenuId);
                Snackbar.Add($"Group '{selectedGroup.Name}' added to root", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding group: {ex.Message}", Severity.Error);
        }
    }


    private async Task AddProductsToGroup(Guid groupId)
    {
        var products = await ShowProductSelectionDialog();
        if (products == null || !products.Any()) return;

        try
        {
            var group = _menu?.Groups.FirstOrDefault(g => g.Id == groupId);
            var addedCount = 0;
            var movedFromRootCount = 0;
            var movedFromGroupCount = 0;
            var skippedCount = 0;
            
            foreach (var product in products)
            {
                var request = new AddProductToMenuGroupRequest(groupId, product.Id, (group?.Products.Count() ?? 0) + addedCount + movedFromRootCount + movedFromGroupCount);
                var result = await MenuService.AddProductToMenuGroupAsync(request);
                
                switch (result.Action)
                {
                    case AddProductAction.Added:
                        addedCount++;
                        break;
                    case AddProductAction.MovedFromRoot:
                        movedFromRootCount++;
                        break;
                    case AddProductAction.MovedFromGroup:
                        movedFromGroupCount++;
                        break;
                    case AddProductAction.Skipped:
                        skippedCount++;
                        break;
                }
            }
            
            _menu = await MenuService.GetByIdAsync(MenuId);
            
            var messages = new List<string>();
            if (addedCount > 0) messages.Add($"{addedCount} product(s) added to group");
            if (movedFromRootCount > 0) messages.Add($"{movedFromRootCount} product(s) moved from root to group");
            if (movedFromGroupCount > 0) messages.Add($"{movedFromGroupCount} product(s) moved from another group");
            if (skippedCount > 0) messages.Add($"{skippedCount} product(s) already in this group");
            
            if (messages.Any())
            {
                Snackbar.Add(string.Join(", ", messages), Severity.Success);
            }
            else
            {
                Snackbar.Add("No products were added", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding products: {ex.Message}", Severity.Error);
        }
    }


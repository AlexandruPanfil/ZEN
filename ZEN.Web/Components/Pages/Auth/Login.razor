@page "/login"
@using ZEN.Application.DTOs.Auth
@using ZEN.Application.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">ZEN POS Login</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <EditForm Model="@_loginRequest" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField T="string"
                          Value="@_loginRequest.Email"
                          ValueChanged="@((string v) => _loginRequest = _loginRequest with { Email = v })"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Required="true"
                          InputType="InputType.Email" />

            <MudTextField T="string"
                          Value="@_loginRequest.Password"
                          ValueChanged="@((string v) => _loginRequest = _loginRequest with { Password = v })"
                          Label="Password"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Required="true"
                          InputType="InputType.Password" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>Login</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4" />

        <MudButton Href="/pin-login"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   FullWidth="true">
            Login with PIN
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequest _loginRequest = new("", "");
    private string? _errorMessage;
    private bool _isLoading;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_loginRequest);

            var query = new Dictionary<string, string?>
            {
                ["userId"] = response.UserId,
                ["userName"] = response.UserName,
                ["email"] = response.Email,
                ["roles"] = string.Join(",", response.Roles),
                ["returnUrl"] = "/"
            };

            var url = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
                "/login-handler", query);

            NavigationManager.NavigateTo(url, forceLoad: true);
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage = "Invalid email or password.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
@page "/equipments/bank-terminals"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Admin
@using ZEN.Shared.Components.Common
@inject IPaymentTerminalService PaymentTerminalService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Administrator,Manager,Technician")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Bank Terminals - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Bank Terminals</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Terminal
        </MudButton>
    </div>

    <MudPaper Class="pa-2 mb-2" Outlined="true">
        <MudTextField T="string"
                      @bind-Value="_searchTerm"
                      Placeholder="Search terminals..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="@HandleKeyDown"
                      Clearable="true"
                      OnClearButtonClick="LoadTerminals"
                      Margin="Margin.Dense" />
    </MudPaper>

    <MudTable T="PaymentTerminalDto" Items="@_terminals" Hover="true" Striped="true" Outlined="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Serial Number</MudTh>
            <MudTh>IP Address</MudTh>
            <MudTh>Port</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="terminal">
            <MudTd DataLabel="Name">@terminal.Name</MudTd>
            <MudTd DataLabel="Type">@terminal.TerminalType</MudTd>
            <MudTd DataLabel="Serial Number">@terminal.SerialNumber</MudTd>
            <MudTd DataLabel="IP">@terminal.IpAddress</MudTd>
            <MudTd DataLabel="Port">@terminal.Port</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(terminal.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(terminal.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(terminal))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTerminal(terminal))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-3">No terminals found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Edit/Create Dialog -->
<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(_isEditMode ? "Edit Terminal" : "Add Terminal")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2" Class="py-1">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Name" Variant="Variant.Outlined" @bind-Value="_editingTerminal.Name" Required="true" For="@(() => _editingTerminal.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Terminal Type" Variant="Variant.Outlined" @bind-Value="_editingTerminal.TerminalType" For="@(() => _editingTerminal.TerminalType)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Serial Number" Variant="Variant.Outlined" @bind-Value="_editingTerminal.SerialNumber" For="@(() => _editingTerminal.SerialNumber)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="IP Address" Variant="Variant.Outlined" @bind-Value="_editingTerminal.IpAddress" For="@(() => _editingTerminal.IpAddress)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField Label="Port" Variant="Variant.Outlined" @bind-Value="_editingTerminal.Port" Min="0" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                    <MudSwitch @bind-Value="_editingTerminal.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveTerminal" Disabled="@(!_formIsValid)" Size="Size.Small">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IEnumerable<PaymentTerminalDto> _terminals = new List<PaymentTerminalDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm? _form;

    private PaymentTerminalFormModel _editingTerminal = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTerminals();
    }

    private async Task LoadTerminals()
    {
        _isLoading = true;
        try
        {
            var terminals = await PaymentTerminalService.GetAllAsync(cancellationToken: default);
            _terminals = string.IsNullOrWhiteSpace(_searchTerm)
                ? terminals
                : terminals.Where(t => t.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading terminals: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadTerminals();
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingTerminal = new PaymentTerminalFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(PaymentTerminalDto terminal)
    {
        _isEditMode = true;
        _editingTerminal = new PaymentTerminalFormModel
        {
            Id = terminal.Id,
            Name = terminal.Name,
            TerminalType = terminal.TerminalType,
            SerialNumber = terminal.SerialNumber,
            IpAddress = terminal.IpAddress,
            Port = terminal.Port,
            CashDeskId = terminal.CashDeskId,
            IsActive = terminal.IsActive
        };
        _isDialogOpen = true;
    }

    private async Task SaveTerminal()
    {
        try
        {
            if (_isEditMode)
            {
                var request = new UpdatePaymentTerminalRequest(
                    _editingTerminal.Id,
                    _editingTerminal.Name,
                    _editingTerminal.TerminalType,
                    _editingTerminal.SerialNumber,
                    _editingTerminal.IpAddress,
                    _editingTerminal.Port,
                    _editingTerminal.IsActive);
                await PaymentTerminalService.UpdateAsync(request);
                Snackbar.Add("Terminal updated successfully.", Severity.Success);
            }
            else
            {
                var request = new CreatePaymentTerminalRequest(
                    _editingTerminal.Name,
                    _editingTerminal.TerminalType,
                    _editingTerminal.SerialNumber,
                    _editingTerminal.IpAddress,
                    _editingTerminal.Port,
                    _editingTerminal.IsActive);
                await PaymentTerminalService.CreateAsync(request);
                Snackbar.Add("Terminal created successfully.", Severity.Success);
            }
            await LoadTerminals();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving terminal: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteTerminal(PaymentTerminalDto terminal)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Delete terminal '{terminal.Name}'?" };
        var dialog = await DialogService.ShowAsync<MudDialog>("Delete Terminal", parameters, new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                if (await PaymentTerminalService.DeleteAsync(terminal.Id))
                {
                    Snackbar.Add("Terminal deleted successfully.", Severity.Success);
                    await LoadTerminals();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting terminal: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;

    private class PaymentTerminalFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string TerminalType { get; set; } = string.Empty;
        public string? SerialNumber { get; set; }
        public string? IpAddress { get; set; }
        public int Port { get; set; } = 0;
        public Guid? CashDeskId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
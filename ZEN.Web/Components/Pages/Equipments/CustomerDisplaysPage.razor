@page "/equipments/customer-displays"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Admin
@using ZEN.Shared.Components.Common
@inject ICustomerDisplayService CustomerDisplayService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Administrator,Manager,Technician")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Customer Displays - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Customer Displays</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Display
        </MudButton>
    </div>

    <MudPaper Class="pa-2 mb-2" Outlined="true">
        <MudTextField T="string"
                      @bind-Value="_searchTerm"
                      Placeholder="Search displays..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="@HandleKeyDown"
                      Clearable="true"
                      OnClearButtonClick="LoadDisplays"
                      Margin="Margin.Dense" />
    </MudPaper>

    <MudTable T="CustomerDisplayDto" Items="@_displays" Hover="true" Striped="true" Outlined="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="display">
            <MudTd DataLabel="Name">@display.Name</MudTd>
            <MudTd DataLabel="Size">@display.Size</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(display.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(display.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(display))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteDisplay(display))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-3">No displays found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Edit/Create Dialog -->
<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(_isEditMode ? "Edit Display" : "Add Display")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2" Class="py-1">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Name" Variant="Variant.Outlined" @bind-Value="_editingDisplay.Name" Required="true" For="@(() => _editingDisplay.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Size" Variant="Variant.Outlined" @bind-Value="_editingDisplay.Size" For="@(() => _editingDisplay.Size)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Connection Type" Variant="Variant.Outlined" @bind-Value="_editingDisplay.ConnectionType" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Connection String" Variant="Variant.Outlined" @bind-Value="_editingDisplay.ConnectionString" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                    <MudSwitch @bind-Value="_editingDisplay.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDisplay" Disabled="@(!_formIsValid)" Size="Size.Small">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IEnumerable<CustomerDisplayDto> _displays = new List<CustomerDisplayDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private MudForm? _form;

    private CustomerDisplayFormModel _editingDisplay = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDisplays();
    }

    private async Task LoadDisplays()
    {
        _isLoading = true;
        try
        {
            var displays = await CustomerDisplayService.GetAllAsync(cancellationToken: default);
            _displays = string.IsNullOrWhiteSpace(_searchTerm)
                ? displays
                : displays.Where(d => d.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading displays: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadDisplays();
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingDisplay = new CustomerDisplayFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(CustomerDisplayDto display)
    {
        _isEditMode = true;
        _editingDisplay = new CustomerDisplayFormModel
        {
            Id = display.Id,
            Name = display.Name,
            Size = display.Size,
            ConnectionType = display.ConnectionType,
            ConnectionString = display.ConnectionString,
            CashDeskId = display.CashDeskId,
            IsActive = display.IsActive
        };
        _isDialogOpen = true;
    }

    private async Task SaveDisplay()
    {
        try
        {
            if (_isEditMode)
            {
                var request = new UpdateCustomerDisplayRequest(
                    _editingDisplay.Id,
                    _editingDisplay.Name,
                    _editingDisplay.ConnectionType,
                    _editingDisplay.ConnectionString,
                    _editingDisplay.Size,
                    _editingDisplay.IsActive);
                await CustomerDisplayService.UpdateAsync(request);
                Snackbar.Add("Display updated successfully.", Severity.Success);
            }
            else
            {
                var request = new CreateCustomerDisplayRequest(
                    _editingDisplay.Name,
                    _editingDisplay.ConnectionType,
                    _editingDisplay.ConnectionString,
                    _editingDisplay.Size,
                    _editingDisplay.IsActive);
                await CustomerDisplayService.CreateAsync(request);
                Snackbar.Add("Display created successfully.", Severity.Success);
            }
            await LoadDisplays();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving display: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDisplay(CustomerDisplayDto display)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Delete display '{display.Name}'?" };
        var dialog = await DialogService.ShowAsync<MudDialog>("Delete Display", parameters, new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                if (await CustomerDisplayService.DeleteAsync(display.Id))
                {
                    Snackbar.Add("Display deleted successfully.", Severity.Success);
                    await LoadDisplays();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting display: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;

    private class CustomerDisplayFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? ConnectionType { get; set; }
        public string? ConnectionString { get; set; }
        public string? Size { get; set; }
        public Guid? CashDeskId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
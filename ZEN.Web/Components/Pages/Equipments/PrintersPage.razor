@page "/equipments/printers"
@using Microsoft.AspNetCore.Authorization
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Admin
@using ZEN.Domain.Enums
@using ZEN.Shared.Components.Common
@inject IPrinterService PrinterService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Administrator,Manager,Technician")]

<Microsoft.AspNetCore.Components.Web.PageTitle>Fiscal Printers - ZEN POS</Microsoft.AspNetCore.Components.Web.PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Fiscal Printers</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Printer
        </MudButton>
    </div>

    <MudPaper Class="pa-2 mb-2" Outlined="true">
        <MudTextField T="string"
                      @bind-Value="_searchTerm"
                      Placeholder="Search printers..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="@HandleKeyDown"
                      Clearable="true"
                      OnClearButtonClick="LoadPrinters"
                      Margin="Margin.Dense" />
    </MudPaper>

    <MudTable T="PrinterDto" Items="@_printers" Hover="true" Striped="true" Outlined="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Info">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Printer Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="printer">
            <MudTd DataLabel="Name">@printer.Name</MudTd>
            <MudTd DataLabel="Printer Name">@printer.PrinterName</MudTd>
            <MudTd DataLabel="Type">@printer.PrinterType</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(printer.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(printer.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(printer))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePrinter(printer))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-3">No printers found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Edit/Create Dialog -->
<MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(_isEditMode ? "Edit Printer" : "Add Printer")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2" Class="py-1">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Name" Variant="Variant.Outlined" @bind-Value="_editingPrinter.Name" Required="true" For="@(() => _editingPrinter.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Printer Name" Variant="Variant.Outlined" @bind-Value="_editingPrinter.PrinterName" For="@(() => _editingPrinter.PrinterName)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Printer Type" Variant="Variant.Outlined" @bind-Value="_editingPrinter.PrinterType" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                        @foreach (var type in Enum.GetNames(typeof(PrinterType)))
                        {
                            <MudSelectItem T="string" Value="@type">@type</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Connection Type" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ConnectionType" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Connection String" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ConnectionString" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                    <MudSwitch @bind-Value="_editingPrinter.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                    <MudSwitch @bind-Value="_editingPrinter.IsDefault" Color="Color.Primary" Label="Default Printer" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>

                @if (_editingPrinter.PrinterType == "Fiscal")
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2 font-weight-bold">FiscalCloud Configuration</MudText>
                        <MudDivider />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="API Key" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ApiKey" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="API Secret" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ApiSecret" InputType="InputType.Password" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Device ID (GUID)" Variant="Variant.Outlined" @bind-Value="_editingPrinter.DeviceId" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="00000000-0000-0000-0000-000000000000" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Point of Sale ID (GUID)" Variant="Variant.Outlined" @bind-Value="_editingPrinter.PointOfSaleId" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="Optional" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="FiscalCloud Base URL" Variant="Variant.Outlined" @bind-Value="_editingPrinter.FiscalCloudBaseUrl" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="https://fiscalcloud.md" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
        @if (_isEditMode && _editingPrinter.PrinterType == "Fiscal" && !string.IsNullOrEmpty(_editingPrinter.ApiKey))
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="TestFiscalCloudConnection" Size="Size.Small" Disabled="@_isTestingConnection">
                @if (_isTestingConnection)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>Testing...</text>
                }
                else
                {
                    <text>Test Connection</text>
                }
            </MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SavePrinter" Disabled="@(!_formIsValid)" Size="Size.Small">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IEnumerable<PrinterDto> _printers = new List<PrinterDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private bool _isTestingConnection = false;
    private MudForm? _form;

    private PrinterFormModel _editingPrinter = new();

    [Inject] private HttpClient HttpClient { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadPrinters();
    }

    private async Task LoadPrinters()
    {
        _isLoading = true;
        try
        {
            var printers = await PrinterService.GetAllAsync(cancellationToken: default);
            _printers = string.IsNullOrWhiteSpace(_searchTerm)
                ? printers
                : printers.Where(p => p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading printers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadPrinters();
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingPrinter = new PrinterFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(PrinterDto printer)
    {
        _isEditMode = true;
        _editingPrinter = new PrinterFormModel
        {
            Id = printer.Id,
            Name = printer.Name,
            PrinterName = printer.PrinterName,
            PrinterType = printer.PrinterType,
            ConnectionType = printer.ConnectionType,
            ConnectionString = printer.ConnectionString,
            IsDefault = printer.IsDefault,
            IsActive = printer.IsActive,
            ApiKey = printer.ApiKey,
            ApiSecret = printer.ApiSecret,
            DeviceId = printer.DeviceId,
            PointOfSaleId = printer.PointOfSaleId,
            FiscalCloudBaseUrl = printer.FiscalCloudBaseUrl
        };
        _isDialogOpen = true;
    }

    private async Task SavePrinter()
    {
        try
        {
            if (_isEditMode)
            {
                var request = new UpdatePrinterRequest(
                    _editingPrinter.Id,
                    _editingPrinter.Name,
                    _editingPrinter.PrinterName,
                    _editingPrinter.PrinterType,
                    _editingPrinter.ConnectionType,
                    _editingPrinter.ConnectionString,
                    _editingPrinter.IsDefault,
                    _editingPrinter.IsActive,
                    _editingPrinter.ApiKey,
                    _editingPrinter.ApiSecret,
                    _editingPrinter.DeviceId,
                    _editingPrinter.PointOfSaleId,
                    _editingPrinter.FiscalCloudBaseUrl);
                await PrinterService.UpdateAsync(request);
                Snackbar.Add("Printer updated successfully.", Severity.Success);
            }
            else
            {
                var request = new CreatePrinterRequest(
                    _editingPrinter.Name,
                    _editingPrinter.PrinterName,
                    _editingPrinter.PrinterType,
                    _editingPrinter.ConnectionType,
                    _editingPrinter.ConnectionString,
                    _editingPrinter.IsDefault,
                    _editingPrinter.IsActive,
                    _editingPrinter.ApiKey,
                    _editingPrinter.ApiSecret,
                    _editingPrinter.DeviceId,
                    _editingPrinter.PointOfSaleId,
                    _editingPrinter.FiscalCloudBaseUrl);
                await PrinterService.CreateAsync(request);
                Snackbar.Add("Printer created successfully.", Severity.Success);
            }
            await LoadPrinters();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving printer: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestFiscalCloudConnection()
    {
        _isTestingConnection = true;
        try
        {
            var response = await HttpClient.PostAsync($"/api/equipments/printers/{_editingPrinter.Id}/test-fiscalcloud", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("FiscalCloud connection successful!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Connection failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error testing connection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTestingConnection = false;
        }
    }

    private async Task DeletePrinter(PrinterDto printer)
    {
        var parameters = new DialogParameters { ["ContentText"] = $"Delete printer '{printer.Name}'?" };
        var dialog = await DialogService.ShowAsync<MudDialog>("Delete Printer", parameters, new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                if (await PrinterService.DeleteAsync(printer.Id))
                {
                    Snackbar.Add("Printer deleted successfully.", Severity.Success);
                    await LoadPrinters();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting printer: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;

    private class PrinterFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PrinterName { get; set; } = string.Empty;
        public string PrinterType { get; set; } = string.Empty;
        public string? ConnectionType { get; set; }
        public string? ConnectionString { get; set; }
        public bool IsDefault { get; set; } = false;
        public bool IsActive { get; set; } = true;
        public string? ApiKey { get; set; }
        public string? ApiSecret { get; set; }
        public string? DeviceId { get; set; }
        public string? PointOfSaleId { get; set; }
        public string? FiscalCloudBaseUrl { get; set; }
    }
}
@typeparam TItem

<MudTable Items="@Items" Hover="true" Striped="true" Loading="@Loading" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        @HeaderContent
    </HeaderContent>
    <RowTemplate>
        @RowTemplate(context)
    </RowTemplate>
</MudTable>

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment<TItem>? RowTemplate { get; set; }

    [Parameter]
    public bool Loading { get; set; }
}

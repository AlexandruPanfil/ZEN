<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Total Amount: @TotalAmount.ToString("C")</MudText>
        <MudGrid Class="mt-4">
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="@(() => SelectPaymentMethod("Cash"))">
                    Cash
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="@(() => SelectPaymentMethod("Card"))">
                    Card
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" OnClick="@(() => SelectPaymentMethod("Mobile"))">
                    Mobile Payment
                </MudButton>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@using MudBlazor
@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public decimal TotalAmount { get; set; }

    [Parameter]
    public EventCallback<string> OnPaymentMethodSelected { get; set; }

    private async Task SelectPaymentMethod(string method)
    {
        await OnPaymentMethodSelected.InvokeAsync(method);
        MudDialog?.Close(DialogResult.Ok(method));
    }

    private void Cancel() => MudDialog?.Cancel();
}

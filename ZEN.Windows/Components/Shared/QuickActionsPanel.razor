@using MudBlazor
@using ZEN.Windows.Services
@inject NavigationManager Navigation
@inject PosAuthState PosAuthState
@inject IDialogService DialogService

<MudPaper Elevation="3" Class="pa-4" Style="@(IsOpen ? "display: block;" : "display: none;")">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (PosAuthState.IsAdmin)
        {
            <MudText Typo="Typo.subtitle2">Interface:</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                Admin
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="SwitchToManager">
                Manager View
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="GoToPos">
                POS
            </MudButton>
        }
        else if (PosAuthState.IsManager)
        {
            <MudText Typo="Typo.subtitle2">Interface:</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                Manager
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="SwitchToPosWithPin">
                POS
            </MudButton>
        }
        else if (PosAuthState.IsCashier)
        {
            <MudText Typo="Typo.subtitle2">Interface:</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="true">
                Cashier
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SwitchToManagerWithPin">
                Manager View
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    
    private async Task SwitchToManager()
    {
        if (!PosAuthState.IsAuthenticated) return;

        PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", PosRoles.Manager);
        Navigation.NavigateTo("/manager");
    }
    
    private async Task GoToPos()
    {
        Navigation.NavigateTo("/sell");
    }
    
    private async Task SwitchToPosWithPin()
    {
        var parameters = new DialogParameters();
        parameters.Add(nameof(RoleSwitchDialog.TargetRole), PosRoles.Cashier);

        var dialog = await DialogService.ShowAsync<RoleSwitchDialog>("Switch to POS", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string role && !string.IsNullOrEmpty(role))
        {
            PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", role);
            // Allow auth state to propagate before navigation
            await InvokeAsync(StateHasChanged);
            Navigation.NavigateTo("/sell", replace: true);
        }
    }

    private async Task SwitchToManagerWithPin()
    {
        var parameters = new DialogParameters();
        parameters.Add(nameof(RoleSwitchDialog.TargetRole), PosRoles.Manager);

        var dialog = await DialogService.ShowAsync<RoleSwitchDialog>("Switch to Manager", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string role && !string.IsNullOrEmpty(role))
        {
            PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", role);
            // Allow auth state to propagate before navigation
            await InvokeAsync(StateHasChanged);
            Navigation.NavigateTo("/manager", replace: true);
        }
    }
}
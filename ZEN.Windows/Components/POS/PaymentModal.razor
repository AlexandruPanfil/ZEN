@if (Visible)
{
    <div class="mud-overlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div class="mud-dialog" style="background: white; border-radius: 8px; padding: 24px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0;">Select Payment Method</h3>
            <p>Total Amount: @TotalAmount.ToString("C")</p>
            @if (RemainingAmount > 0)
            {
                <p style="color: var(--mud-palette-secondary);">Amount Due: @RemainingAmount.ToString("C")</p>
            }
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 16px 0;">
                @foreach (var method in AvailableMethods)
                {
                    var isAvailable = IsMethodAvailable(method);
                    var capturedMethod = method;
                    var color = GetMethodMudColor(method);
                    <MudButton Variant="Variant.Filled" 
                               Color="color"
                               Class="payment-method-btn"
                               OnClick="() => SelectPaymentMethod(capturedMethod)"
                               Disabled="@(!isAvailable)"
                               Style="min-height: 50px; font-weight: 600;">
                        @GetMethodDisplayName(method)
                    </MudButton>
                }
            </div>
            
            @if (SelectedMethod.HasValue)
            {
                <div style="margin: 16px 0;">
                    <h4>Selected: @GetMethodDisplayName(SelectedMethod.Value)</h4>
                    <label style="display: block; margin-bottom: 8px;">Payment Amount</label>
                    <MudNumericField T="decimal" @bind-Value="PaymentAmount" 
                                 Step="0.01m" Min="0.01m" Max="@RemainingAmount"
                                 Style="width: 100%;"
                                 Label="Payment Amount" />
                    <br>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success"
                               Class="mt-2"
                               OnClick="AddPayment">
                        @(Payments.Count > 0 ? "Add Another Payment" : "Add Payment")
                    </MudButton>
                </div>
                
                @if (Payments.Count > 0)
                {
                    <hr style="margin: 16px 0;" />
                    <h4>Payments Added:</h4>
                    @foreach (var payment in Payments)
                    {
                        <div style="border: 1px solid #eee; border-radius: 4px; padding: 12px; margin: 8px 0; display: flex; justify-content: space-between;">
                            <span>@GetMethodDisplayName(payment.Method)</span>
                            <strong>@payment.Amount.ToString("C")</strong>
                        </div>
                    }
                    <hr style="margin: 16px 0;" />
                    <div style="display: flex; justify-content: space-between; font-size: 1.2em;">
                        <span>Total Paid:</span>
                        <strong style="color: var(--mud-palette-success);">@TotalPaid.ToString("C")</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 1.2em;">
                        <span>Remaining:</span>
                        <strong style="color: @GetRemainingColor()">@RemainingAmount.ToString("C")</strong>
                    </div>
                }
            }
            
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary"
                           OnClick="OnCancel">
                    Cancel
                </MudButton>
                @if (Payments.Count > 0 && RemainingAmount <= 0.005m)
                {
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success"
                               OnClick="OnConfirm">
                        Confirm Payments
                    </MudButton>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public decimal TotalAmount { get; set; }

    [Parameter]
    public List<Domain.Enums.PaymentMethod> AvailableMethods { get; set; } = new();

    [Parameter]
    public List<ZEN.Application.DTOs.Admin.PaymentTerminalDto> Terminals { get; set; } = new();

    [Parameter]
    public EventCallback<List<PaymentModal.PaymentSelection>> OnConfirmed { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private Domain.Enums.PaymentMethod? SelectedMethod = null;
    private decimal PaymentAmount = 0;
    private List<PaymentSelection> Payments = new();

    private decimal TotalPaid => Payments.Sum(p => p.Amount);
    private decimal RemainingAmount => TotalAmount - TotalPaid;

    public record PaymentSelection(Domain.Enums.PaymentMethod Method, decimal Amount, Guid? TerminalId = null);

    private void SelectPaymentMethod(Domain.Enums.PaymentMethod method)
    {
        SelectedMethod = method;
        PaymentAmount = RemainingAmount > 0 ? RemainingAmount : TotalAmount;
    }

    private bool IsMethodAvailable(Domain.Enums.PaymentMethod method)
    {
        var terminalsForMethod = GetTerminalsForMethod(method);
        return method == Domain.Enums.PaymentMethod.Cash || terminalsForMethod.Any();
    }

    private IEnumerable<ZEN.Application.DTOs.Admin.PaymentTerminalDto> GetTerminalsForMethod(Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            Domain.Enums.PaymentMethod.CreditCard or Domain.Enums.PaymentMethod.DebitCard => Terminals.Where(t => 
                t.TerminalType.Equals("Card", StringComparison.OrdinalIgnoreCase) ||
                t.TerminalType.Equals("POS", StringComparison.OrdinalIgnoreCase)),
            Domain.Enums.PaymentMethod.Mobile => Terminals.Where(t => 
                t.TerminalType.Equals("Mobile", StringComparison.OrdinalIgnoreCase)),
            Domain.Enums.PaymentMethod.QRCode => Terminals.Where(t => 
                t.TerminalType.Equals("QRCode", StringComparison.OrdinalIgnoreCase) ||
                t.TerminalType.Equals("QR", StringComparison.OrdinalIgnoreCase)),
            _ => Enumerable.Empty<ZEN.Application.DTOs.Admin.PaymentTerminalDto>()
        };
    }

    private Color GetMethodMudColor(Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            Domain.Enums.PaymentMethod.Cash => Color.Secondary,
            Domain.Enums.PaymentMethod.CreditCard or Domain.Enums.PaymentMethod.DebitCard => Color.Info,
            Domain.Enums.PaymentMethod.Mobile => Color.Primary,
            Domain.Enums.PaymentMethod.QRCode => Color.Secondary,
            Domain.Enums.PaymentMethod.GiftCard => Color.Warning,
            Domain.Enums.PaymentMethod.StoreCredit => Color.Success,
            Domain.Enums.PaymentMethod.BankTransfer => Color.Dark,
            _ => Color.Default
        };
    }

    private string GetMethodDisplayName(Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            Domain.Enums.PaymentMethod.Cash => "Cash",
            Domain.Enums.PaymentMethod.CreditCard => "Credit Card",
            Domain.Enums.PaymentMethod.DebitCard => "Debit Card",
            Domain.Enums.PaymentMethod.Mobile => "Mobile Payment",
            Domain.Enums.PaymentMethod.QRCode => "QR Code",
            Domain.Enums.PaymentMethod.GiftCard => "Gift Card",
            Domain.Enums.PaymentMethod.StoreCredit => "Store Credit",
            Domain.Enums.PaymentMethod.BankTransfer => "Bank Transfer",
            _ => method.ToString()
        };
    }

    private void AddPayment()
    {
        if (!SelectedMethod.HasValue) return;
        if (PaymentAmount <= 0) return;
        if (PaymentAmount > RemainingAmount && Payments.Count > 0) return;

        var terminalId = GetTerminalsForMethod(SelectedMethod.Value).FirstOrDefault()?.Id;

        Payments.Add(new PaymentSelection(SelectedMethod.Value, PaymentAmount, terminalId));
        SelectedMethod = null;
        PaymentAmount = 0;
    }

    private string GetRemainingColor()
    {
        return RemainingAmount > 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)";
    }

    private void OnCancel()
    {
        Payments.Clear();
        SelectedMethod = null;
        PaymentAmount = 0;
        OnCancelled.InvokeAsync();
        VisibleChanged.InvokeAsync(false);
    }

    private async Task OnConfirm()
    {
        if (RemainingAmount > 0.005m) return;
        
        await OnConfirmed.InvokeAsync(Payments);
        
        Payments.Clear();
        SelectedMethod = null;
        PaymentAmount = 0;
        await VisibleChanged.InvokeAsync(false);
    }
}
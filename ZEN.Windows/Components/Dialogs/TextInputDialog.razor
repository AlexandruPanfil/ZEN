@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_value" Label="@Label" Placeholder="@Placeholder" Variant="Variant.Outlined" Class="w-100" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Confirm" Disabled="string.IsNullOrWhiteSpace(_value)">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Title { get; set; } = "Input";
    [Parameter] public string Label { get; set; } = "Value";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private string _value = "";

    protected override void OnInitialized()
    {
        _value = Value;
    }

    private void Confirm() => Dialog.Close(DialogResult.Ok(_value.Trim()));
    private void Cancel() => Dialog.Close(DialogResult.Cancel());
}
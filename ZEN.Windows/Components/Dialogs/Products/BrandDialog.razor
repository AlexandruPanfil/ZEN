@using MudBlazor
@using ZEN.Application.DTOs.Products

<MudDialog @bind-Visible="Visible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Stars" Class="mr-2" /> @(IsEditMode ? "Modify Brand" : "Add Brand Entry")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Brand Name" Variant="Variant.Outlined" @bind-Value="Model.Name" Required="true" For="@(() => Model.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Description" Variant="Variant.Outlined" @bind-Value="Model.Description" Multiline="true" Lines="2" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="Model.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBrand" Disabled="@(!_formIsValid)" Size="Size.Small">@(IsEditMode ? "Update" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public BrandFormModel Model { get; set; } = new();
    [Parameter] public EventCallback<BrandFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private MudForm _form = default!;
    private bool _formIsValid = false;

    private void CloseDialog()
    {
        Visible = false;
        OnClose.InvokeAsync();
    }

    private async Task SaveBrand()
    {
        await _form.ValidateAsync();
        if (!_formIsValid) return;

        await OnSave.InvokeAsync(Model);
        CloseDialog();
    }

    public class BrandFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
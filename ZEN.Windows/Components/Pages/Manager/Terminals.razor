@page "/manager/equipments/terminals"
@using ZEN.Application.DTOs.Admin
@using ZEN.Windows.Services
@using MudBlazor
@inject IPaymentTerminalService TerminalService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PosAuthState PosAuthState

<PageTitle>Payment Terminals - ZEN POS</PageTitle>

@if (!PosAuthState.IsManager && !PosAuthState.IsAdmin)
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h5" GutterBottom="true">Manager access required.</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Cashiers can elevate to Manager by entering a Manager or Admin PIN.</MudText>
        
        <MudTextField @bind-Value="_pin"
                     Label="Enter Manager/Admin PIN"
                     InputType="InputType.Password"
                     MaxLength="6"
                     Variant="Variant.Filled"
                     Class="mb-2"
                     @onkeypress="HandlePinKeyPress" />
        
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ValidatePin" Disabled="_isProcessing" Class="mt-3">
            @if (_isProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Validating...</span>
            }
            else
            {
                <span>Confirm</span>
            }
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h5" GutterBottom=true>Payment Terminals</MudText>

        @if (!_dataLoaded)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_terminals == null || !_terminals.Any())
        {
            <MudAlert Severity="Severity.Info">No terminals found.</MudAlert>
        }
        else
        {
            <MudTable T="PaymentTerminalDto" Items="_terminals" Hover="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Serial Number</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate Context="terminal">
                    <MudTd DataLabel="Name">@terminal.Name</MudTd>
                    <MudTd DataLabel="Type">@terminal.TerminalType</MudTd>
                    <MudTd DataLabel="Serial Number">@(terminal.SerialNumber ?? "-")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(terminal.IsActive ? Color.Success : Color.Error)">
                            @(terminal.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    private List<PaymentTerminalDto>? _terminals;
    private bool _dataLoaded = false;
    private string _pin = string.Empty;
    private string? _error;
    private bool _isProcessing = false;

    protected override async Task OnParametersSetAsync()
    {
        if ((PosAuthState.IsManager || PosAuthState.IsAdmin) && !_dataLoaded)
        {
            await LoadTerminalsAsync();
            _dataLoaded = true;
        }
    }
    
    private async Task LoadTerminalsAsync()
    {
        try
        {
            var terminals = await TerminalService.GetAllAsync();
            _terminals = terminals.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading terminals: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandlePinKeyPress(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ValidatePin();
    }

    private async Task ValidatePin()
    {
        if (_isProcessing) return;

        _error = null;
        _isProcessing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (_pin == "3333" || _pin == "1234")
            {
                var role = _pin == "3333" ? PosRoles.Manager : PosRoles.Administrator;
                PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", role);
                await LoadTerminalsAsync();
                _dataLoaded = true;
            }
            else
            {
                _error = "Invalid PIN. Enter Manager PIN (3333) or Admin PIN (1234).";
            }
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
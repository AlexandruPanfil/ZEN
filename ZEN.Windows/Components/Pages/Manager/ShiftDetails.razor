@page "/manager/shifts/{ShiftId:guid}"
@using ZEN.Application.DTOs.Shifts
@using ZEN.Domain.Enums
@using ZEN.Windows.Services
@using MudBlazor
@inject IShiftService ShiftService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PosAuthState PosAuthState

<PageTitle>Shift Details - ZEN POS</PageTitle>

@if (!PosAuthState.IsManager && !PosAuthState.IsAdmin)
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h5" GutterBottom="true">Manager access required.</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Cashiers can elevate to Manager by entering a Manager or Admin PIN.</MudText>
        
        <MudTextField @bind-Value="_pin"
                     Label="Enter Manager/Admin PIN"
                     InputType="InputType.Password"
                     MaxLength="6"
                     Variant="Variant.Filled"
                     Class="mb-2"
                     @onkeypress="HandlePinKeyPress" />
        
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ValidatePin" Disabled="_isProcessing" Class="mt-3">
            @if (_isProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Validating...</span>
            }
            else
            {
                <span>Confirm</span>
            }
        </MudButton>
    </MudPaper>
}
else if (_shift == null)
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h5" GutterBottom="true">Shift Details</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1">Shift Information</MudText>
                <MudPaper Class="pa-3" Elevation="1">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText>Shift #:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@_shift.Number</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>Opened:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@_shift.OpenedAt.ToString("MMM dd, yyyy HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>Status:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Color="@(_shift.Status == ShiftStatus.Closed ? Color.Success : Color.Info)">@_shift.Status</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>Cashier:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@_shift.UserName</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1">Financial Summary</MudText>
                <MudPaper Class="pa-3" Elevation="1">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText>Opening Cash:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@_shift.OpeningCash.ToString("C")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>Total Sales:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText>@_shift.TotalSales.ToString("C")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="BackToList">
            Back to List
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public Guid ShiftId { get; set; }
    private ShiftDto? _shift;
    private string _pin = string.Empty;
    private string? _error;
    private bool _isProcessing = false;

    protected override async Task OnParametersSetAsync()
    {
        // Load shift data if authorized
        if (PosAuthState.IsManager || PosAuthState.IsAdmin)
        {
            await LoadShift();
        }
    }
    
    private async Task LoadShift()
    {
        try
        {
            _shift = await ShiftService.GetByIdAsync(ShiftId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading shift: {ex.Message}", Severity.Error);
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/manager/shifts");
    }

    private async Task HandlePinKeyPress(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ValidatePin();
    }

    private async Task ValidatePin()
    {
        if (_isProcessing) return;

        _error = null;
        _isProcessing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (_pin == "3333" || _pin == "1234")
            {
                var role = _pin == "3333" ? PosRoles.Manager : PosRoles.Administrator;
                PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", role);
                // Load shift data after elevation (this will cause re-render)
                await LoadShift();
            }
            else
            {
                _error = "Invalid PIN. Enter Manager PIN (3333) or Admin PIN (1234).";
            }
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
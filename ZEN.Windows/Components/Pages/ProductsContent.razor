@using MudBlazor
@using ZEN.Application.DTOs.Products
@using ServiceTaxDto = ZEN.Application.Services.Interfaces.TaxDto
@using ZEN.Windows.Components.Dialogs.Products
@using ZEN.Windows.Services.Sync
@inject SyncApiClient ApiClient
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 px-2">
    <!-- Top Action Bar -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Products Matrix</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   OnClick="OpenCreateProductDialog">
            Add Product Entry
        </MudButton>
    </div>

    <MudGrid Spacing="2">
        <!-- LEFT DATA PANEL: CORE PRODUCTS MATRIX WORKSPACE -->
        <MudItem xs="12" md="9">
            <!-- Inline Search Toolbar -->
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="Filter live warehouse records matching search criteria..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleKeyDown"
                              Clearable="true"
                              OnClearButtonClick="LoadProducts"
                              Margin="Margin.Dense"
                              Style="font-size: 0.8rem;" />
            </MudPaper>

            <!-- PRODUCTS DATAGRID -->
            <MudDataGrid T="ProductDto" Items="_products" Hover="true" Striped="true" Outlined="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Info" MultiSorting="true">
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Identity Designation" Sortable="true" Width="200px">
                        <CellTemplate>
                            <MudText Class="font-weight-bold" Style="font-size: 0.78rem;">@context.Item.Name</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.SKU" Title="SKU Code" Width="120px">
                        <CellTemplate>
                            <code class="px-1 font-monospace style-code-box">@(string.IsNullOrWhiteSpace(context.Item.SKU) ? "—" : context.Item.SKU)</code>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Barcode" Title="Barcode ID" Width="140px">
                        <CellTemplate>
                            <MudText Style="font-size: 0.75rem;">@(string.IsNullOrWhiteSpace(context.Item.Barcode) ? "—" : context.Item.Barcode)</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CostPrice" Title="Cost Price" Sortable="true" Width="110px" Class="text-end">
                        <CellTemplate>
                            <MudText Style="font-size: 0.75rem;">@context.Item.CostPrice.ToString("C")</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.SalePrice" Title="Retail Price" Sortable="true" Width="110px" Class="text-end">
                        <CellTemplate>
                            <MudText Class="font-weight-bold text-success" Style="font-size: 0.75rem;">@context.Item.SalePrice.ToString("C")</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CategoryName" Title="Category" Width="140px">
                        <CellTemplate>
                            <MudText Style="font-size: 0.75rem;">@context.Item.CategoryName</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.ProductGroupName" Title="Product Group" Width="140px">
                        <CellTemplate>
                            <MudText Style="font-size: 0.75rem;">@context.Item.ProductGroupName</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="Tax (TVA)" Width="140px">
                        <CellTemplate>
                            <MudText Style="font-size: 0.75rem;">@(context.Item.TaxName != null ? $"{context.Item.TaxName} ({context.Item.TaxRate}%)" : "—")</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.IsActive" Title="Status" Width="100px">
                        <CellTemplate>
                            <MudChip T="string" Color="@(context.Item.IsActive ? Color.Success : Color.Error)" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold pa-0" Style="font-size: 0.72rem; margin: 0;">
                                @(context.Item.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="Actions" Width="90px" Class="text-end">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" Class="pa-1" OnClick="@(() => OpenEditProductDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Class="pa-1" OnClick="@(() => DeleteProduct(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="ProductDto" RowsPerPageString="Rows View:" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="pa-3" Style="font-size: 0.75rem;">No matching storage items located.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudItem>

        <!-- RIGHT UTILITY PANEL: TAXONOMY SUB-CRUD ENGINE -->
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">System Lookups</MudText>
                    <MudToggleGroup T="string" @bind-Value="_activeLookupTab" Color="Color.Primary" Size="Size.Small" Outline="true">
                        <MudToggleItem Value="@("categories")">Categories</MudToggleItem>
                        <MudToggleItem Value="@("product-groups")">Product Groups</MudToggleItem>
                    </MudToggleGroup>
                </div>

                @if (_activeLookupTab == "categories")
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">Product Categories Registry</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="OpenCreateCategoryDialog" />
                    </div>
                    <div style="max-height: 520px; overflow-y: auto;">
                        <MudList T="CategoryDto" Dense="true" Clickable="false" Class="pa-0">
                            @foreach (var cat in _displayCategories)
                            {
                                <div class="d-flex align-center justify-space-between mud-width-full py-1 border-bottom border-solid mud-border-default">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">@cat.Name</MudText>
                                        @if (!string.IsNullOrWhiteSpace(cat.ParentCategoryName))
                                        {
                                            <MudText Typo="Typo.caption" Style="font-size: 0.7rem;" Color="Color.Secondary">Parent: @cat.ParentCategoryName</MudText>
                                        }
                                    </div>
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" Class="pa-1" OnClick="() => OpenEditCategoryDialog(cat)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="pa-1" OnClick="() => DeleteCategory(cat)" />
                                    </div>
                                </div>
                            }
                        </MudList>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">Product Groups Registry</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="OpenCreateProductGroupDialog" />
                    </div>
                    <div style="max-height: 520px; overflow-y: auto;">
                        <MudList T="ProductGroupDto" Dense="true" Clickable="false" Class="pa-0">
                            @foreach (var pg in _displayProductGroups)
                            {
                                <div class="d-flex align-center justify-space-between mud-width-full py-1 border-bottom border-solid mud-border-default">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">@pg.Name</MudText>
                                        @if (!string.IsNullOrWhiteSpace(pg.ParentGroupName))
                                        {
                                            <MudText Typo="Typo.caption" Style="font-size: 0.7rem;" Color="Color.Secondary">Parent: @pg.ParentGroupName</MudText>
                                        }
                                    </div>
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" Class="pa-1" OnClick="() => OpenEditProductGroupDialog(pg)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="pa-1" OnClick="() => DeleteProductGroup(pg)" />
                                    </div>
                                </div>
                            }
                        </MudList>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- Product Dialog -->
<ProductDialog @ref="_productDialog"
               Visible="@_isProductDialogOpen"
               IsEditMode="@_isProductEditMode"
               Model="@_editingProduct"
               Categories="@_categories"
               ProductGroups="@_productGroups"
               Taxes="@_taxes"
               OnSave="SaveProduct"
               OnClose="CloseProductDialog" />

<!-- Category Dialog -->
<CategoryDialog @ref="_categoryDialog"
                Visible="@_isCategoryDialogOpen"
                IsEditMode="@_isCategoryEditMode"
                Model="@_editingCategory"
                Categories="@_categories"
                OnSave="SaveCategory"
                OnClose="CloseCategoryDialog" />

<!-- Product Group Dialog -->
<ProductGroupDialog @ref="_productGroupDialog"
                    Visible="@_isProductGroupDialogOpen"
                    IsEditMode="@_isProductGroupEditMode"
                    Model="@_editingProductGroup"
                    ProductGroups="@_productGroups"
                    OnSave="SaveProductGroup"
                    OnClose="CloseProductGroupDialog" />

<!-- Confirmation Dialogs -->
<ConfirmationDialog @ref="_confirmDeleteProduct"
                    Visible="@_showConfirmDeleteProduct"
                    Title="Purge Ledger Product"
                    Message="@_confirmDeleteMessage"
                    OnResult="ConfirmDeleteProduct" />

<ConfirmationDialog @ref="_confirmDeleteCategory"
                    Visible="@_showConfirmDeleteCategory"
                    Title="Purge Category Link"
                    Message="@_confirmDeleteMessage"
                    OnResult="ConfirmDeleteCategory" />

<ConfirmationDialog @ref="_confirmDeleteProductGroup"
                    Visible="@_showConfirmDeleteProductGroup"
                    Title="Purge Product Group Link"
                    Message="@_confirmDeleteMessage"
                    OnResult="ConfirmDeleteProductGroup" />

<style>
    .style-code-box {
        background-color: var(--mud-palette-background-grey);
        border-radius: 4px;
        letter-spacing: 0.5px;
        font-size: 0.72rem;
    }
</style>

@code {
    private IEnumerable<ProductDto> _products = new List<ProductDto>();
    private IEnumerable<CategoryDto> _categories = new List<CategoryDto>();
    private List<CategoryDto> _displayCategories = new();
    private IEnumerable<ProductGroupDto> _productGroups = new List<ProductGroupDto>();
    private List<ProductGroupDto> _displayProductGroups = new();
    private IEnumerable<ServiceTaxDto> _taxes = new List<ServiceTaxDto>();

    private string _searchTerm = string.Empty;
    private string _activeLookupTab = "categories";
    private bool _isLoading = true;

    // Dialog visibility
    private bool _isProductDialogOpen = false;
    private bool _isProductEditMode = false;
    private bool _isCategoryDialogOpen = false;
    private bool _isCategoryEditMode = false;
    private bool _isProductGroupDialogOpen = false;
    private bool _isProductGroupEditMode = false;

    // Confirmation dialogs
    private bool _showConfirmDeleteProduct = false;
    private bool _showConfirmDeleteCategory = false;
    private bool _showConfirmDeleteProductGroup = false;
    private string _confirmDeleteMessage = string.Empty;
    private ProductDto? _productToDelete;
    private CategoryDto? _categoryToDelete;
    private ProductGroupDto? _productGroupToDelete;

    // Dialog refs
    private ProductDialog? _productDialog;
    private CategoryDialog? _categoryDialog;
    private ProductGroupDialog? _productGroupDialog;
    private ConfirmationDialog? _confirmDeleteProduct;
    private ConfirmationDialog? _confirmDeleteCategory;
    private ConfirmationDialog? _confirmDeleteProductGroup;

    // View Models
    private ProductDialog.ProductFormModel _editingProduct = new();
    private CategoryDialog.CategoryFormModel _editingCategory = new();
    private ProductGroupDialog.ProductGroupFormModel _editingProductGroup = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadProducts();
    }

    private async Task LoadLookups()
    {
        try
        {
            _categories = await ApiClient.GetCategoriesAsync();
            _displayCategories = OrderHierarchically(_categories).ToList();
            _productGroups = await ApiClient.GetProductGroupsAsync();
            _displayProductGroups = OrderHierarchically(_productGroups).ToList();
            _taxes = await ApiClient.GetTaxesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        try
        {
            _products = string.IsNullOrWhiteSpace(_searchTerm)
                ? await ApiClient.GetProductsAsync()
                : await ApiClient.GetProductsAsync(_searchTerm);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadProducts();
    }

    // Product Dialog
    private void OpenCreateProductDialog()
    {
        _isProductEditMode = false;
        _editingProduct = new ProductDialog.ProductFormModel();
        _isProductDialogOpen = true;
    }

    private void OpenEditProductDialog(ProductDto product)
    {
        _isProductEditMode = true;
        _editingProduct = new ProductDialog.ProductFormModel
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Barcode = product.Barcode,
            SKU = product.SKU,
            CostPrice = product.CostPrice,
            SalePrice = product.SalePrice,
            CategoryId = product.CategoryId,
            ProductGroupId = product.ProductGroupId,
            TaxId = product.TaxId,
            IsActive = product.IsActive
        };
        _isProductDialogOpen = true;
    }

    private async Task SaveProduct(ProductDialog.ProductFormModel model)
    {
        try
        {
            if (_isProductEditMode)
            {
                var updateRequest = new UpdateProductRequest(model.Id, model.Name, model.Description, model.Barcode, model.SKU, model.CostPrice, model.SalePrice, model.CategoryId, model.ProductGroupId, model.TaxId, model.IsActive);
                var result = await ApiClient.UpdateProductAsync(updateRequest);
                if (result != null)
                {
                    Snackbar.Add("Product node configured.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to update product.", Severity.Error);
                }
            }
            else
            {
                var createRequest = new CreateProductRequest(model.Name, model.Description, model.Barcode, model.SKU, model.CostPrice, model.SalePrice, model.CategoryId, model.ProductGroupId, model.TaxId, null, true, model.IsActive);
                var result = await ApiClient.CreateProductAsync(createRequest);
                if (result != null)
                {
                    Snackbar.Add("Product listing recorded.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to create product.", Severity.Error);
                }
            }
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CloseProductDialog() => _isProductDialogOpen = false;

    private void DeleteProduct(ProductDto product)
    {
        _productToDelete = product;
        _confirmDeleteMessage = $"Drop target catalog product mapping {product.Name}?";
        _showConfirmDeleteProduct = true;
    }

    private async Task ConfirmDeleteProduct(bool confirmed)
    {
        if (!confirmed || _productToDelete == null) return;

        try
        {
            if (await ApiClient.DeleteProductAsync(_productToDelete.Id))
            {
                Snackbar.Add("Product data model dropped out of catalog registry.", Severity.Success);
                await LoadProducts();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _productToDelete = null;
        }
    }

    // Category Dialog
    private void OpenCreateCategoryDialog()
    {
        _isCategoryEditMode = false;
        _editingCategory = new CategoryDialog.CategoryFormModel();
        _isCategoryDialogOpen = true;
    }

    private void OpenEditCategoryDialog(CategoryDto item)
    {
        _isCategoryEditMode = true;
        _editingCategory = new CategoryDialog.CategoryFormModel
        {
            Id = item.Id,
            Name = item.Name,
            ParentCategoryId = item.ParentCategoryId,
            IsActive = true
        };
        _isCategoryDialogOpen = true;
    }

    private async Task SaveCategory(CategoryDialog.CategoryFormModel model)
    {
        try
        {
            if (_isCategoryEditMode)
            {
                var request = new UpdateCategoryRequest(model.Id, model.Name, model.Description, model.ParentCategoryId, model.SortOrder, model.IsActive);
                var result = await ApiClient.UpdateCategoryAsync(request);
                if (result != null)
                {
                    Snackbar.Add("Category mapping altered.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to update category.", Severity.Error);
                }
            }
            else
            {
                var request = new CreateCategoryRequest(model.Name, model.Description, model.ParentCategoryId, model.SortOrder, model.IsActive);
                var result = await ApiClient.CreateCategoryAsync(request);
                if (result != null)
                {
                    Snackbar.Add("Category node recorded.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to create category.", Severity.Error);
                }
            }
            await LoadLookups();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CloseCategoryDialog() => _isCategoryDialogOpen = false;

    private void DeleteCategory(CategoryDto item)
    {
        _categoryToDelete = item;
        _confirmDeleteMessage = $"Drop active structural category link: {item.Name}?";
        _showConfirmDeleteCategory = true;
    }

    private async Task ConfirmDeleteCategory(bool confirmed)
    {
        if (!confirmed || _categoryToDelete == null) return;

        try
        {
            if (await ApiClient.DeleteCategoryAsync(_categoryToDelete.Id))
            {
                Snackbar.Add("Category context disconnected.", Severity.Success);
                await LoadLookups();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _categoryToDelete = null;
        }
    }

    // Product Group Dialog
    private void OpenCreateProductGroupDialog()
    {
        _isProductGroupEditMode = false;
        _editingProductGroup = new ProductGroupDialog.ProductGroupFormModel();
        _isProductGroupDialogOpen = true;
    }

    private void OpenEditProductGroupDialog(ProductGroupDto item)
    {
        _isProductGroupEditMode = true;
        _editingProductGroup = new ProductGroupDialog.ProductGroupFormModel
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            ParentGroupId = item.ParentGroupId,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive
        };
        _isProductGroupDialogOpen = true;
    }

    private async Task SaveProductGroup(ProductGroupDialog.ProductGroupFormModel model)
    {
        try
        {
            if (_isProductGroupEditMode)
            {
                var request = new UpdateProductGroupRequest(model.Id, model.Name, model.Description, model.ParentGroupId, model.SortOrder, model.IsActive);
                var result = await ApiClient.UpdateProductGroupAsync(request);
                if (result != null)
                {
                    Snackbar.Add("Product group mapping altered.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to update product group.", Severity.Error);
                }
            }
            else
            {
                var request = new CreateProductGroupRequest(model.Name, model.Description, model.ParentGroupId, model.SortOrder, model.IsActive);
                var result = await ApiClient.CreateProductGroupAsync(request);
                if (result != null)
                {
                    Snackbar.Add("Product group node recorded.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Failed to create product group.", Severity.Error);
                }
            }
            await LoadLookups();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CloseProductGroupDialog() => _isProductGroupDialogOpen = false;

    private void DeleteProductGroup(ProductGroupDto item)
    {
        _productGroupToDelete = item;
        _confirmDeleteMessage = $"Drop active structural product group link: {item.Name}?";
        _showConfirmDeleteProductGroup = true;
    }

    private async Task ConfirmDeleteProductGroup(bool confirmed)
    {
        if (!confirmed || _productGroupToDelete == null) return;

        try
        {
            if (await ApiClient.DeleteProductGroupAsync(_productGroupToDelete.Id))
            {
                Snackbar.Add("Product group context disconnected.", Severity.Success);
                await LoadLookups();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _productGroupToDelete = null;
        }
    }

    private static IEnumerable<ProductGroupDto> OrderHierarchically(IEnumerable<ProductGroupDto> groups)
    {
        var groupsList = groups.ToList();
        var childrenByParent = groupsList
            .Where(g => g.ParentGroupId.HasValue)
            .GroupBy(g => g.ParentGroupId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.SortOrder).ToList());

        var result = new List<ProductGroupDto>();
        var roots = groupsList.Where(g => !g.ParentGroupId.HasValue).OrderBy(g => g.SortOrder).ToList();

        foreach (var root in roots)
        {
            AddGroupAndChildren(root, childrenByParent, result);
        }

        return result;
    }

    private static void AddGroupAndChildren(ProductGroupDto group, Dictionary<Guid, List<ProductGroupDto>> childrenByParent, List<ProductGroupDto> result)
    {
        result.Add(group);
        if (childrenByParent.TryGetValue(group.Id, out var children))
        {
            foreach (var child in children)
            {
                AddGroupAndChildren(child, childrenByParent, result);
            }
        }
    }

    private static IEnumerable<CategoryDto> OrderHierarchically(IEnumerable<CategoryDto> categories)
    {
        var categoriesList = categories.ToList();
        var childrenByParent = categoriesList
            .Where(c => c.ParentCategoryId.HasValue)
            .GroupBy(c => c.ParentCategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.SortOrder).ToList());

        var result = new List<CategoryDto>();
        var roots = categoriesList.Where(c => !c.ParentCategoryId.HasValue).OrderBy(c => c.SortOrder).ToList();

        foreach (var root in roots)
        {
            AddCategoryAndChildren(root, childrenByParent, result);
        }

        return result;
    }

    private static void AddCategoryAndChildren(CategoryDto category, Dictionary<Guid, List<CategoryDto>> childrenByParent, List<CategoryDto> result)
    {
        result.Add(category);
        if (childrenByParent.TryGetValue(category.Id, out var children))
        {
            foreach (var child in children)
            {
                AddCategoryAndChildren(child, childrenByParent, result);
            }
        }
    }
}
@page "/sell"
@inject NavigationManager Navigation
 @inject ZEN.Windows.Services.PosAuthState PosAuthState
 @inject ISnackbar Snackbar
 @inject ZEN.Windows.Services.Sync.SyncApiClient ApiClient
 @inject ZEN.Windows.Services.PosPrinterService PrinterService
 @inject ZEN.Windows.Services.CashDeskHeartbeatService HeartbeatService
 @inject IDialogService DialogService
@using ZEN.Windows.Components.POS
@using ZEN.Application.DTOs.Sales

<PageTitle>Point of Sale - ZEN POS</PageTitle>

@if (!PosAuthState.IsAuthenticated)
    {
        <MudText Typo="Typo.h5" Class="ma-4">Not authenticated. Redirecting to login...</MudText>
    }
    else
    {
        <SellPageLayout UserName="@PosAuthState.UserName"
                        OnExit="HandleExit"
                        OnSwitchToManager="HandleSwitchToManager"
                        Class="sell-page-full-height">
            <SidebarContent>
                <SellCartSidebar CartItems="Cart"
                                Subtotal="Subtotal"
                                DiscountAmount="DiscountAmount"
                                TaxAmount="TaxAmount"
                                TotalAmount="TotalAmount"
                                OnIncrement="IncrementCartItem"
                                OnDecrement="DecrementCartItem"
                                OnRemove="RemoveCartItem" />
            </SidebarContent>
            
            <ChildContent>
                <ShiftStatusBar />
                <ProductGrid Products="AllProducts" OnProductSelected="AddToCart" />
            </ChildContent>
            
            <FooterContent>
                <SellActionBar CartEmpty="Cart.Count == 0"
                              CanProcessPayment="true"
                              ChangeDue="0"
                              OnNewSale="ClearCart"
                              OnHoldSale="HoldSale"
                              OnResumeSale="ResumeSale"
                              OnProcessPayment="ProcessPayment" />
                @if (IsProcessingSale)
                {
                    <MudPaper Class="pa-2 mt-2" Style="background: #fff3cd; border-left: 4px solid #ffc107;">
                        <MudProgress Linear="true" Indeterminate="true" Color="Color.Info" Size="Size.Small" Class="mt-1" />
<MudText Typo="Typo.caption" Style="color: #856404;">
    Waiting for fiscal printer... (this may take some time)
</MudText>
                    </MudPaper>
                }
            </FooterContent>
        </SellPageLayout>
    }

<PaymentModal @bind-Visible="@ShowPaymentModal" 
              TotalAmount="@TotalAmount" 
              AvailableMethods="@AvailableModalMethods" 
              Terminals="@ModalTerminals" 
              OnConfirmed="@OnPaymentModalConfirmed" 
              OnCancelled="@OnPaymentModalCancelled" />

@code {
    private List<ProductDto> AllProducts = new();
    private List<PosCartItem> Cart = new();
    private bool IsDemoCatalog = false;
    private HeldSaleDto? _resumingHeldSale = null;

    private decimal Subtotal => Cart.Sum(item => item.Quantity * item.UnitPrice);
    private decimal DiscountAmount => Cart.Sum(item => item.Quantity * item.Discount);
    private decimal TaxAmount => Cart.Sum(item => {
        var lineTotal = item.Quantity * item.UnitPrice - item.Quantity * item.Discount;
        return item.TaxRate > 0 ? Math.Round(lineTotal * item.TaxRate / (100m + item.TaxRate), 2) : 0m;
    });
    private decimal TotalAmount => Subtotal - DiscountAmount;

    protected override async Task OnInitializedAsync()
    {
        if (PosAuthState.IsAuthenticated && PosAuthState.CashDeskId.HasValue)
        {
            HeartbeatService.Start(PosAuthState.CashDeskId.Value);
        }
        await LoadProductsAsync();
    }

private async Task LoadProductsAsync()
    {
        IsDemoCatalog = false;

        // Try to load from API if CashDeskId is set (endpoint is now anonymous)
        if (PosAuthState.CashDeskId.HasValue && PosAuthState.CashDeskId.Value != Guid.Empty)
        {
            try
            {
                Console.WriteLine($"[SellPage] Loading menu items for CashDeskId={PosAuthState.CashDeskId.Value}, BaseAddress={ApiClient.BaseAddress}");
                var items = await ApiClient.GetCashDeskMenuItemsAsync(PosAuthState.CashDeskId.Value);
                Console.WriteLine($"[SellPage] Menu API returned {items.Count()} items");
                if (items.Any())
                {
                    AllProducts = items
                        .Select(i => new ProductDto(
                            i.ProductId,
                            i.Name,
                            null,
                            null,
                            null,
                            0,
                            i.SalePrice,
                            null,
                            null,
                            null,
                            null,
                            null,
                            null,
                            i.TaxRate,
                            true))
                        .ToList();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SellPage] Menu API error: {ex}");
                Snackbar.Add($"Failed to load cash desk menu: {ex.Message}. Showing demo products (sales disabled).", Severity.Error);
            }
        }

        if (AllProducts.Count == 0)
        {
            AllProducts = GenerateDemoProducts();
            IsDemoCatalog = true;
            Snackbar.Add("Showing demo products - configure cash desk menu in ZEN.Web. Sales are DISABLED in demo mode.", Severity.Warning);
        }
    }

    private void AddToCart(ProductDto product)
    {
        var existingItem = Cart.FirstOrDefault(item => item.ProductId == product.Id);

        if (existingItem != null)
        {
            existingItem.Quantity += 1;
        }
        else
        {
            var cartItem = new PosCartItem
            {
                ProductId = product.Id,
                ProductName = product.Name,
                Quantity = 1,
                UnitPrice = product.SalePrice,
                TaxRate = product.TaxRate
            };
            Cart.Add(cartItem);
        }
    }

    private void IncrementCartItem(PosCartItem item)
    {
        item.Quantity += 1;
    }

    private void DecrementCartItem(PosCartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity -= 1;
        }
        else
        {
            Cart.Remove(item);
        }
    }

    private void RemoveCartItem(PosCartItem item)
    {
        Cart.Remove(item);
    }

    private void ClearCart()
    {
        Cart.Clear();
        Snackbar.Add("Cart cleared", Severity.Info);
    }

    private async Task HoldSale()
    {
        if (Cart.Count == 0)
        {
            Snackbar.Add("Cart is empty, nothing to hold", Severity.Warning);
            return;
        }

        if (!PosAuthState.StoreId.HasValue)
        {
            Snackbar.Add("No store assigned", Severity.Error);
            return;
        }

        try
        {
            // Serialize cart items
            var itemsJson = System.Text.Json.JsonSerializer.Serialize(Cart.Select(item => new
            {
                item.ProductId,
                item.Quantity,
                item.UnitPrice,
                item.Discount,
                item.TaxRate
            }));

            var request = new Application.DTOs.Sales.HoldSaleRequest(
                StoreId: PosAuthState.StoreId.Value,
                CustomerId: null,
                SerializedItems: itemsJson
            );

            var heldSale = await ApiClient.HoldSaleAsync(request);
            
            if (heldSale != null)
            {
                ClearCart();
                Snackbar.Add($"Sale held successfully (ID: {heldSale.Id})", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to hold sale", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error holding sale: {ex.Message}", Severity.Error);
        }
    }

    private async Task ResumeSale()
    {
        if (!PosAuthState.StoreId.HasValue)
        {
            Snackbar.Add("No store assigned", Severity.Error);
            return;
        }

        try
        {
            var heldSales = await ApiClient.GetHeldSalesAsync(PosAuthState.StoreId.Value);
            var activeHeldSales = heldSales.Where(h => h.CompletedAt == null).ToList();
            
            if (!activeHeldSales.Any())
            {
                Snackbar.Add("No held sales to resume", Severity.Info);
                return;
            }

            var parameters = new DialogParameters<SelectHeldSaleDialog>
            {
                { x => x.HeldSales, activeHeldSales }
            };

            var dialog = await DialogService.ShowAsync<SelectHeldSaleDialog>("Select Held Sale to Resume", parameters);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data is HeldSaleDto selectedHeldSale)
            {
                if (!string.IsNullOrEmpty(selectedHeldSale.SerializedItems))
                {
                    try
                    {
                        var items = System.Text.Json.JsonSerializer.Deserialize<List<HeldSaleItem>>(selectedHeldSale.SerializedItems);
                        if (items != null && items.Any())
                        {
                            Cart.Clear();
                            foreach (var item in items)
                            {
                                Cart.Add(new PosCartItem
                                {
                                    ProductId = item.ProductId,
                                    Quantity = item.Quantity,
                                    UnitPrice = item.UnitPrice,
                                    Discount = item.Discount,
                                    TaxRate = item.TaxRate
                                });
                            }
                            
                            _resumingHeldSale = selectedHeldSale;
                            Snackbar.Add($"Resumed held sale from {selectedHeldSale.HeldAt:g}", Severity.Success);
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Error resuming sale: {ex.Message}", Severity.Error);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading held sales: {ex.Message}", Severity.Error);
        }
    }

    private class HeldSaleItem
    {
        public Guid ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public decimal TaxRate { get; set; }
    }

    // Payment Modal State
    private bool ShowPaymentModal = false;
    private List<Domain.Enums.PaymentMethod> AvailableModalMethods = new();
    private List<ZEN.Application.DTOs.Admin.PaymentTerminalDto> ModalTerminals = new();
    private bool IsProcessingSale = false;

    private async Task ProcessPayment()
    {
        Console.WriteLine("=== ProcessPayment START ===");
        Console.WriteLine($"Cart count: {Cart.Count}");

        if (Cart.Count == 0)
        {
            Console.WriteLine("Cart is empty, showing warning");
            Snackbar.Add("Cart is empty", Severity.Warning);
            return;
        }

        // Guard: demo catalog products do not exist in the database and would cause
        // a FOREIGN KEY violation on SaleItems.ProductId.
        if (IsDemoCatalog)
        {
            Snackbar.Add("Demo mode: cannot complete a sale because these products are not in the database. Assign a menu with real products to this cash desk in ZEN.Web.", Severity.Error);
            return;
        }

        // Guard: StoreId must reference a real Store row (FK_Sales_Stores_StoreId).
        if (!PosAuthState.StoreId.HasValue || PosAuthState.StoreId.Value == Guid.Empty)
        {
            Snackbar.Add("Cannot complete sale: no store is assigned to this session. Assign the cash desk to a store in ZEN.Web and log in again.", Severity.Error);
            return;
        }

        // Guard: CashDeskId should be set for fiscal receipts
        if (!PosAuthState.CashDeskId.HasValue || PosAuthState.CashDeskId.Value == Guid.Empty)
        {
            Snackbar.Add("ERROR: No cash desk assigned to this session. Cannot process sales without a cash desk. Please log in with a cashier assigned to a cash desk.", Severity.Error);
            return;
        }

        // Auto-shift logic: Check for open shift on server, create one if needed
        Guid? shiftId = PosAuthState.ShiftId;
        if (!shiftId.HasValue && PosAuthState.StoreId.HasValue)
        {
            Console.WriteLine("No active shift in local state, checking server for open shift...");
            var existingShift = await ApiClient.GetCurrentShiftAsync(PosAuthState.StoreId.Value);
            if (existingShift != null)
            {
                shiftId = existingShift.Id;
                PosAuthState.SetShift(shiftId.Value);
                Console.WriteLine($"Found existing open shift on server: {existingShift.Number}");
            }
        }
        
        if (!shiftId.HasValue)
        {
            Console.WriteLine("No active shift found on server, attempting to auto-open shift...");
            Snackbar.Add("Opening shift...", Severity.Info);
            
            var newShift = await ApiClient.OpenShiftAsync(PosAuthState.CashDeskId.Value, 0);
            if (newShift == null)
            {
                Snackbar.Add("Failed to open shift. Please check store/cash desk configuration.", Severity.Error);
                return;
            }
            
            shiftId = newShift.Id;
            PosAuthState.SetShift(shiftId.Value);
            Snackbar.Add($"Shift opened: {newShift.Number}", Severity.Success);
        }

        try
        {
            Snackbar.Add("Processing payment...", Severity.Info);
            Console.WriteLine($"Creating sale request for StoreId: {PosAuthState.StoreId}, CashDeskId: {PosAuthState.CashDeskId}, ShiftId: {shiftId}");

            // Load available payment terminals for current cash desk
            var terminals = await ApiClient.GetPaymentTerminalsAsync(PosAuthState.CashDeskId.Value);
            var activeTerminals = terminals.Where(t => !t.IsDeleted && t.IsActive).ToList();
            
            Console.WriteLine($"Found {terminals.Count()} total terminals, {activeTerminals.Count} active");
            foreach (var t in terminals)
            {
                Console.WriteLine($"Terminal: {t.Name}, Type: {t.TerminalType}, Active: {t.IsActive}, CashDeskId: {t.CashDeskId}");
            }

            // Determine available payment methods based on terminal configuration
            var availableMethods = DetermineAvailablePaymentMethods(activeTerminals);
            Console.WriteLine($"Available methods: {string.Join(", ", availableMethods)}");

            // Show payment modal for payment selection (supports split payments)
            Console.WriteLine("About to show payment modal...");
            var paymentSelections = await ShowPaymentModalAsync(availableMethods, activeTerminals);
            Console.WriteLine($"Modal returned: {paymentSelections?.Count ?? 0} payments");
            
            if (paymentSelections == null || !paymentSelections.Any())
            {
                Snackbar.Add("Payment cancelled", Severity.Info);
                return;
            }

            // Validate total payments >= TotalAmount
            var totalPayments = paymentSelections.Sum(p => p.Amount);
            if (totalPayments < TotalAmount)
            {
                Snackbar.Add($"Total payments ({totalPayments:C}) must be at least the amount due ({TotalAmount:C})", Severity.Error);
                return;
            }

            // Build sale request with multiple payments
            var paymentRequests = paymentSelections.Select(p => 
                new Application.DTOs.Sales.CreateSalePaymentRequest(p.Method, p.Amount)).ToList();

            var request = new Application.DTOs.Sales.CreateSaleRequest(
                CustomerId: null,
                StoreId: PosAuthState.StoreId.Value,
                ShiftId: shiftId,
                CashDeskId: PosAuthState.CashDeskId,
                Items: Cart.Select(item => new Application.DTOs.Sales.CreateSaleItemRequest(
                    item.ProductId,
                    item.Quantity,
                    item.UnitPrice,
                    item.Discount,
                    item.TaxRate
                )),
                Payments: paymentRequests,
                LoyaltyPointsRedeemed: null
            );

            Console.WriteLine($"Request built. Total amount: {TotalAmount}, Items: {Cart.Count}, Payments: {paymentRequests.Count}");
            Console.WriteLine($"Calling ApiClient.CreateSaleWithResultAsync...");

            // Look up the fiscal printer timeout from cached printers
            int? fiscalTimeoutSeconds = null;
            try
            {
                var printers = await PrinterService.GetCachedAsync();
                var fiscalPrinter = printers.FirstOrDefault(p =>
                    string.Equals(p.PrinterType, "Fiscal", StringComparison.OrdinalIgnoreCase) && p.IsActive && !p.IsDeleted);
                fiscalTimeoutSeconds = fiscalPrinter?.FiscalCloudTimeoutSeconds;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SellPage] Error looking up fiscal printer timeout: {ex.Message}");
            }

            var fiscalTimeoutText = fiscalTimeoutSeconds.HasValue ? fiscalTimeoutSeconds.Value.ToString() : "default (120s)";
            Console.WriteLine($"[SellPage] Using fiscal timeout: {fiscalTimeoutText}");

            IsProcessingSale = true;
            StateHasChanged();

            var (sale, error) = await ApiClient.CreateSaleWithResultAsync(request, cancellationToken: default, timeoutSeconds: fiscalTimeoutSeconds);

            IsProcessingSale = false;
            StateHasChanged();

            Console.WriteLine($"API response received: {(sale != null ? $"Success - Receipt #{sale.Number}" : $"Failed - {error}")}");

            if (sale != null)
            {
                // Check if sale failed due to FiscalCloud
                if (sale.Status == Domain.Enums.SaleStatus.Failed)
                {
                    var errorMsg = sale.FiscalReceiptError ?? "Fiscal receipt failed";
                    Console.WriteLine($"Sale failed due to FiscalCloud: {errorMsg}");
                    Snackbar.Add($"Sale FAILED - Fiscal receipt error: {errorMsg}", Severity.Error);
                    
                    // Show specific guidance based on error
                    if (errorMsg.Contains("placeholder", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("YOUR_", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("REPLACE_WITH_ACTUAL_", StringComparison.OrdinalIgnoreCase))
                    {
                        Snackbar.Add("Action required: Configure actual FiscalCloud credentials in ZEN.Web > Equipments > Printers", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("not configured"))
                    {
                        Snackbar.Add("Action required: Add a FiscalCloud printer and link it to your cash desk in ZEN.Web", Severity.Warning);
                    }
                    else if (errorMsg.Contains("timed out") || errorMsg.Contains("timeout"))
                    {
                        Snackbar.Add("FiscalCloud agent may be slow or unreachable. Check if agent is running on port 50700.", Severity.Warning);
                        Snackbar.Add("Sale may still be processing on the server. Check fiscal receipts in ZEN.Web.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("authentication") || errorMsg.Contains("Unauthorized"))
                    {
                        Snackbar.Add("FiscalCloud authentication failed. Check ApiKey, ApiSecret, and DeviceId in printer settings.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("404"))
                    {
                        Snackbar.Add("FiscalCloud agent not found. Ensure agent is running on http://localhost:50700", Severity.Warning);
                    }
                    else if (errorMsg.Contains("No cash desk"))
                    {
                        Snackbar.Add("Action required: Assign a cash desk to your user in ZEN.Web", Severity.Warning);
                    }
                    
                    // Do NOT clear cart - user needs to retry or fix configuration
                    return;
                }

                Snackbar.Add($"Sale completed! Receipt #{sale.Number}", Severity.Success);

                if (sale.FiscalReceiptSent == true)
                {
                    Snackbar.Add("Fiscal receipt sent to FiscalCloud successfully.", Severity.Success);
                }
                else if (sale.FiscalReceiptSent == false)
                {
                    var errorMsg = sale.FiscalReceiptError ?? "Unknown fiscal error";
                    Console.WriteLine($"Fiscal receipt failed: {errorMsg}");
                    Snackbar.Add($"Sale saved, but fiscal receipt FAILED: {errorMsg}", Severity.Error);
                    
                    // Show specific guidance based on error
                    if (errorMsg.Contains("placeholder", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("YOUR_", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("REPLACE_WITH_ACTUAL_", StringComparison.OrdinalIgnoreCase))
                    {
                        Snackbar.Add("Action required: Configure actual FiscalCloud credentials in ZEN.Web > Equipments > Printers", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("not configured"))
                    {
                        Snackbar.Add("Action required: Add a FiscalCloud printer and link it to your cash desk in ZEN.Web", Severity.Warning);
                    }
                    else if (errorMsg.Contains("timed out") || errorMsg.Contains("timeout"))
                    {
                        Snackbar.Add("FiscalCloud agent may be slow or unreachable. Check if agent is running on port 50700.", Severity.Warning);
                        Snackbar.Add("Sale may still be processing on the server. Check fiscal receipts in ZEN.Web.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("authentication") || errorMsg.Contains("Unauthorized"))
                    {
                        Snackbar.Add("FiscalCloud authentication failed. Check ApiKey, ApiSecret, and DeviceId in printer settings.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("404"))
                    {
                        Snackbar.Add("FiscalCloud agent not found. Ensure agent is running on http://localhost:50700", Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add("Sale completed. Fiscal receipt status unknown.", Severity.Info);
                    }
                }

                // Calculate change due for cash overpayment
                var cashPayments = paymentSelections.Where(p => p.Method == Domain.Enums.PaymentMethod.Cash).Sum(p => p.Amount);
                var changeDue = cashPayments - TotalAmount;
                if (changeDue > 0)
                {
                    Snackbar.Add($"Change due: {changeDue:C}", Severity.Info);
                }

                // Complete held sale if we were resuming one
                if (_resumingHeldSale != null)
                {
                    try
                    {
                        var completed = await ApiClient.CompleteHeldSaleAsync(_resumingHeldSale.Id, PosAuthState.UserName ?? "POS");
                        if (completed)
                        {
                            Snackbar.Add("Held sale completed and removed from pending list", Severity.Success);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error completing held sale: {ex.Message}");
                    }
                    _resumingHeldSale = null;
                }

                ClearCart();
            }
            else
            {
                Snackbar.Add($"Failed to complete sale: {error ?? "unknown error"}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"=== EXCEPTION in ProcessPayment ===");
            Console.WriteLine($"Message: {ex.Message}");
            Console.WriteLine($"Type: {ex.GetType().Name}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
            Snackbar.Add($"Error processing payment: {ex.Message}", Severity.Error);
        }
        finally
        {
            Console.WriteLine("=== ProcessPayment END ===");
        }
    }

    private List<Domain.Enums.PaymentMethod> DetermineAvailablePaymentMethods(List<ZEN.Application.DTOs.Admin.PaymentTerminalDto> terminals)
    {
        var methods = new List<Domain.Enums.PaymentMethod> { Domain.Enums.PaymentMethod.Cash };

        if (terminals.Any(t => t.TerminalType.Equals("Card", StringComparison.OrdinalIgnoreCase) || 
                               t.TerminalType.Equals("POS", StringComparison.OrdinalIgnoreCase)))
        {
            methods.Add(Domain.Enums.PaymentMethod.CreditCard);
            methods.Add(Domain.Enums.PaymentMethod.DebitCard);
        }
        if (terminals.Any(t => t.TerminalType.Equals("Mobile", StringComparison.OrdinalIgnoreCase)))
        {
            methods.Add(Domain.Enums.PaymentMethod.Mobile);
        }
        if (terminals.Any(t => t.TerminalType.Equals("QRCode", StringComparison.OrdinalIgnoreCase) || 
                               t.TerminalType.Equals("QR", StringComparison.OrdinalIgnoreCase)))
        {
            methods.Add(Domain.Enums.PaymentMethod.QRCode);
        }

        // These methods don't require specific terminals
        methods.Add(Domain.Enums.PaymentMethod.GiftCard);
        methods.Add(Domain.Enums.PaymentMethod.StoreCredit);
        methods.Add(Domain.Enums.PaymentMethod.BankTransfer);

        return methods;
    }

    private record PaymentDialogSelection(Domain.Enums.PaymentMethod Method, decimal Amount, Guid? TerminalId = null);

    private TaskCompletionSource<List<PaymentDialogSelection>?>? _paymentModalTcs;

    private async Task<List<PaymentDialogSelection>?> ShowPaymentModalAsync(
        List<Domain.Enums.PaymentMethod> availableMethods, 
        List<ZEN.Application.DTOs.Admin.PaymentTerminalDto> terminals)
    {
        Console.WriteLine("ShowPaymentModalAsync: Showing modal...");
        
        // Initialize modal state - set terminals and methods FIRST
        AvailableModalMethods = availableMethods;
        ModalTerminals = terminals;
        ShowPaymentModal = true;
        StateHasChanged(); // Ensure modal renders immediately

        // Wait for user to confirm or cancel
        var tcs = new TaskCompletionSource<List<PaymentDialogSelection>?>();
        
        // Store the completion source so we can complete it from the modal callbacks
        _paymentModalTcs = tcs;
        
        var result = await tcs.Task;
        Console.WriteLine($"ShowPaymentModalAsync: Modal closed. Result: {result?.Count ?? 0} payments");
        return result;
    }

    private void OnPaymentModalConfirmed(List<PaymentModal.PaymentSelection> selections)
    {
        var result = selections.Select(s => new PaymentDialogSelection(s.Method, s.Amount, s.TerminalId)).ToList();
        _paymentModalTcs?.TrySetResult(result);
        _paymentModalTcs = null;
    }

    private void OnPaymentModalCancelled()
    {
        _paymentModalTcs?.TrySetResult(null);
        _paymentModalTcs = null;
    }

    private void HandleExit()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleSwitchToManager()
    {
        if (PosAuthState.IsManager || PosAuthState.IsAdmin)
        {
            Navigation.NavigateTo("/manager");
        }
    }

    public void Dispose()
    {
        HeartbeatService.Stop();
    }

private List<ProductDto> GenerateDemoProducts()
    {
        return new List<ProductDto>
        {
            new(Guid.NewGuid(), "Coffee", "Fresh coffee", "1001", "SKU001", 2.50m, 3.50m, null, null, null, null, null, null, 10m, true),
            new(Guid.NewGuid(), "Tea", "Hot tea", "1002", "SKU002", 2.00m, 3.00m, null, null, null, null, null, null, 10m, true),
            new(Guid.NewGuid(), "Sandwich", "Chicken sandwich", "1003", "SKU003", 5.00m, 8.00m, null, null, null, null, null, null, 10m, true),
            new(Guid.NewGuid(), "Salad", "Garden salad", "1004", "SKU004", 4.00m, 7.00m, null, null, null, null, null, null, 10m, true),
            new(Guid.NewGuid(), "Cake", "Chocolate cake", "1005", "SKU005", 3.00m, 5.00m, null, null, null, null, null, null, 10m, true),
            new(Guid.NewGuid(), "Water", "Bottled water", "1006", "SKU006", 1.00m, 2.00m, null, null, null, null, null, null, 0m, true),

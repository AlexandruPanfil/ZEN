@page "/sell"
@inject NavigationManager Navigation
@inject ZEN.Windows.Services.PosAuthState PosAuthState
@inject ISnackbar Snackbar
@inject ZEN.Windows.Services.Sync.SyncApiClient ApiClient

<PageTitle>Point of Sale - ZEN POS</PageTitle>

@if (!PosAuthState.IsAuthenticated)
{
    <MudText Typo="Typo.h5" Class="ma-4">Not authenticated. Redirecting to login...</MudText>
}
else
{
    <SellPageLayout UserName="@PosAuthState.UserName"
                    OnExit="HandleExit"
                    OnSwitchToManager="HandleSwitchToManager">
        <SidebarContent>
            <SellCartSidebar CartItems="Cart"
                            Subtotal="Subtotal"
                            DiscountAmount="DiscountAmount"
                            TaxAmount="TaxAmount"
                            TotalAmount="TotalAmount"
                            OnIncrement="IncrementCartItem"
                            OnDecrement="DecrementCartItem"
                            OnRemove="RemoveCartItem" />
        </SidebarContent>
        
        <ChildContent>
            <ProductGrid Products="AllProducts" OnProductSelected="AddToCart" />
        </ChildContent>
        
        <FooterContent>
            <SellActionBar CartEmpty="Cart.Count == 0"
                          CanProcessPayment="true"
                          ChangeDue="0"
                          OnNewSale="ClearCart"
                          OnHoldSale="HoldSale"
                          OnResumeSale="ResumeSale"
                          OnProcessPayment="ProcessPayment" />
        </FooterContent>
    </SellPageLayout>
}

@code {
    private List<ProductDto> AllProducts = new();
    private List<PosCartItem> Cart = new();
    private bool IsDemoCatalog = false;

    private decimal Subtotal => Cart.Sum(item => item.Quantity * item.UnitPrice);
    private decimal DiscountAmount => Cart.Sum(item => item.Quantity * item.Discount);
    private decimal TaxAmount => Cart.Sum(item => (item.Quantity * item.UnitPrice - item.Quantity * item.Discount) * (item.TaxRate / 100m));
    private decimal TotalAmount => Subtotal - DiscountAmount + TaxAmount;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

private async Task LoadProductsAsync()
    {
        IsDemoCatalog = false;

        // Try to load from API if CashDeskId is set (endpoint is now anonymous)
        if (PosAuthState.CashDeskId.HasValue && PosAuthState.CashDeskId.Value != Guid.Empty)
        {
            try
            {
                Console.WriteLine($"[SellPage] Loading menu items for CashDeskId={PosAuthState.CashDeskId.Value}, BaseAddress={ApiClient.BaseAddress}");
                var items = await ApiClient.GetCashDeskMenuItemsAsync(PosAuthState.CashDeskId.Value);
                Console.WriteLine($"[SellPage] Menu API returned {items.Count()} items");
                if (items.Any())
                {
                    AllProducts = items
                        .Select(i => new ProductDto(
                            i.ProductId,
                            i.Name,
                            null,
                            null,
                            null,
                            0,
                            i.SalePrice,
                            null,
                            null,
                            null,
                            null,
                            null,
                            null,
                            true))
                        .ToList();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SellPage] Menu API error: {ex}");
                Snackbar.Add($"Failed to load cash desk menu: {ex.Message}. Showing demo products (sales disabled).", Severity.Error);
            }
        }

        if (AllProducts.Count == 0)
        {
            AllProducts = GenerateDemoProducts();
            IsDemoCatalog = true;
            Snackbar.Add("Showing demo products - configure cash desk menu in ZEN.Web. Sales are DISABLED in demo mode.", Severity.Warning);
        }
    }

    private void AddToCart(ProductDto product)
    {
        var existingItem = Cart.FirstOrDefault(item => item.ProductId == product.Id);

        if (existingItem != null)
        {
            existingItem.Quantity += 1;
        }
        else
        {
            var cartItem = new PosCartItem
            {
                ProductId = product.Id,
                ProductName = product.Name,
                Quantity = 1,
                UnitPrice = product.SalePrice,
                TaxRate = 10m
            };
            Cart.Add(cartItem);
        }
    }

    private void IncrementCartItem(PosCartItem item)
    {
        item.Quantity += 1;
    }

    private void DecrementCartItem(PosCartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity -= 1;
        }
        else
        {
            Cart.Remove(item);
        }
    }

    private void RemoveCartItem(PosCartItem item)
    {
        Cart.Remove(item);
    }

    private void ClearCart()
    {
        Cart.Clear();
        Snackbar.Add("Cart cleared", Severity.Info);
    }

    private void HoldSale()
    {
        Snackbar.Add("Demo mode: Hold sale not available without database connection", Severity.Info);
    }

    private void ResumeSale()
    {
        Snackbar.Add("Demo mode: Resume sale not available without database connection", Severity.Info);
    }

    private async Task ProcessPayment()
    {
        Console.WriteLine("=== ProcessPayment START ===");
        Console.WriteLine($"Cart count: {Cart.Count}");

        if (Cart.Count == 0)
        {
            Console.WriteLine("Cart is empty, showing warning");
            Snackbar.Add("Cart is empty", Severity.Warning);
            return;
        }

        // Guard: demo catalog products do not exist in the database and would cause
        // a FOREIGN KEY violation on SaleItems.ProductId.
        if (IsDemoCatalog)
        {
            Snackbar.Add("Demo mode: cannot complete a sale because these products are not in the database. Assign a menu with real products to this cash desk in ZEN.Web.", Severity.Error);
            return;
        }

        // Guard: StoreId must reference a real Store row (FK_Sales_Stores_StoreId).
        if (!PosAuthState.StoreId.HasValue || PosAuthState.StoreId.Value == Guid.Empty)
        {
            Snackbar.Add("Cannot complete sale: no store is assigned to this session. Assign the cash desk to a store in ZEN.Web and log in again.", Severity.Error);
            return;
        }

        // Guard: CashDeskId should be set for fiscal receipts
        if (!PosAuthState.CashDeskId.HasValue || PosAuthState.CashDeskId.Value == Guid.Empty)
        {
            Snackbar.Add("ERROR: No cash desk assigned to this session. Cannot process sales without a cash desk. Please log in with a cashier assigned to a cash desk.", Severity.Error);
            return;
        }

        try
        {
            Snackbar.Add("Processing payment...", Severity.Info);
            Console.WriteLine($"Creating sale request for StoreId: {PosAuthState.StoreId}, CashDeskId: {PosAuthState.CashDeskId}");

            // Build sale request
            var request = new Application.DTOs.Sales.CreateSaleRequest(
                CustomerId: null,
                StoreId: PosAuthState.StoreId.Value,
                ShiftId: null,
                CashDeskId: PosAuthState.CashDeskId,
                Items: Cart.Select(item => new Application.DTOs.Sales.CreateSaleItemRequest(
                    item.ProductId,
                    item.Quantity,
                    item.UnitPrice,
                    item.Discount,
                    item.TaxRate
                )),
                Payments: new[]
                {
                    new Application.DTOs.Sales.CreateSalePaymentRequest(
                        Domain.Enums.PaymentMethod.Cash,
                        TotalAmount
                    )
                },
                LoyaltyPointsRedeemed: null
            );

            Console.WriteLine($"Request built. Total amount: {TotalAmount}, Items: {Cart.Count}");
            Console.WriteLine($"Calling ApiClient.CreateSaleWithResultAsync...");

            var (sale, error) = await ApiClient.CreateSaleWithResultAsync(request);

            Console.WriteLine($"API response received: {(sale != null ? $"Success - Receipt #{sale.Number}" : $"Failed - {error}")}");

            if (sale != null)
            {
                // Check if sale failed due to FiscalCloud
                if (sale.Status == Domain.Enums.SaleStatus.Failed)
                {
                    var errorMsg = sale.FiscalReceiptError ?? "Fiscal receipt failed";
                    Console.WriteLine($"Sale failed due to FiscalCloud: {errorMsg}");
                    Snackbar.Add($"Sale FAILED - Fiscal receipt error: {errorMsg}", Severity.Error);
                    
                    // Show specific guidance based on error
                    if (errorMsg.Contains("placeholder", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("YOUR_", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("REPLACE_WITH_ACTUAL_", StringComparison.OrdinalIgnoreCase))
                    {
                        Snackbar.Add("Action required: Configure actual FiscalCloud credentials in ZEN.Web > Equipments > Printers", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("not configured"))
                    {
                        Snackbar.Add("Action required: Add a FiscalCloud printer and link it to your cash desk in ZEN.Web", Severity.Warning);
                    }
                    else if (errorMsg.Contains("timed out") || errorMsg.Contains("timeout"))
                    {
                        Snackbar.Add("FiscalCloud agent may be slow or unreachable. Check if agent is running on port 50700.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("authentication") || errorMsg.Contains("Unauthorized"))
                    {
                        Snackbar.Add("FiscalCloud authentication failed. Check ApiKey, ApiSecret, and DeviceId in printer settings.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("404"))
                    {
                        Snackbar.Add("FiscalCloud agent not found. Ensure agent is running on http://localhost:50700", Severity.Warning);
                    }
                    else if (errorMsg.Contains("No cash desk"))
                    {
                        Snackbar.Add("Action required: Assign a cash desk to your user in ZEN.Web", Severity.Warning);
                    }
                    
                    // Do NOT clear cart - user needs to retry or fix configuration
                    return;
                }

                Snackbar.Add($"Sale completed! Receipt #{sale.Number}", Severity.Success);

                if (sale.FiscalReceiptSent == true)
                {
                    Snackbar.Add("Fiscal receipt sent to FiscalCloud successfully.", Severity.Success);
                }
                else if (sale.FiscalReceiptSent == false)
                {
                    var errorMsg = sale.FiscalReceiptError ?? "Unknown fiscal error";
                    Console.WriteLine($"Fiscal receipt failed: {errorMsg}");
                    Snackbar.Add($"Sale saved, but fiscal receipt FAILED: {errorMsg}", Severity.Error);
                    
                    // Show specific guidance based on error
                    if (errorMsg.Contains("placeholder", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("YOUR_", StringComparison.OrdinalIgnoreCase) ||
                        errorMsg.Contains("REPLACE_WITH_ACTUAL_", StringComparison.OrdinalIgnoreCase))
                    {
                        Snackbar.Add("Action required: Configure actual FiscalCloud credentials in ZEN.Web > Equipments > Printers", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("not configured"))
                    {
                        Snackbar.Add("Action required: Add a FiscalCloud printer and link it to your cash desk in ZEN.Web", Severity.Warning);
                    }
                    else if (errorMsg.Contains("timed out") || errorMsg.Contains("timeout"))
                    {
                        Snackbar.Add("FiscalCloud agent may be slow or unreachable. Check if agent is running on port 50700.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("authentication") || errorMsg.Contains("Unauthorized"))
                    {
                        Snackbar.Add("FiscalCloud authentication failed. Check ApiKey, ApiSecret, and DeviceId in printer settings.", Severity.Warning);
                    }
                    else if (errorMsg.Contains("not found") || errorMsg.Contains("404"))
                    {
                        Snackbar.Add("FiscalCloud agent not found. Ensure agent is running on http://localhost:50700", Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add("Sale completed. Fiscal receipt status unknown.", Severity.Info);
                }

                ClearCart();
            }
            else
            {
                Snackbar.Add($"Failed to complete sale: {error ?? "unknown error"}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"=== EXCEPTION in ProcessPayment ===");
            Console.WriteLine($"Message: {ex.Message}");
            Console.WriteLine($"Type: {ex.GetType().Name}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
            Snackbar.Add($"Error processing payment: {ex.Message}", Severity.Error);
        }
        finally
        {
            Console.WriteLine("=== ProcessPayment END ===");
        }
    }

    private void HandleExit()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleSwitchToManager()
    {
        if (PosAuthState.IsManager || PosAuthState.IsAdmin)
        {
            Navigation.NavigateTo("/manager");
        }
    }


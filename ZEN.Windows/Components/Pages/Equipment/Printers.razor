@page "/equipments/printers"
@using ZEN.Windows.Services
@using ZEN.Application.Services.Interfaces
@using ZEN.Application.DTOs.Admin
@using ZEN.Domain.Enums
@using MudBlazor
@inject PosPrinterService PrinterService
@inject IFiscalCloudService FiscalCloudService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PosAuthState PosAuthState

<PageTitle>Fiscal Printers - ZEN POS</PageTitle>

@if (!PosAuthState.IsManager && !PosAuthState.IsAdmin)
{
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h5" GutterBottom="true">Manager access required.</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Cashiers can elevate to Manager by entering a Manager or Admin PIN.</MudText>

        <MudTextField @bind-Value="_pin"
                      Label="Enter Manager/Admin PIN"
                      InputType="InputType.Password"
                      MaxLength="6"
                      Variant="Variant.Filled"
                      Class="mb-2"
                      @onkeypress="HandlePinKeyPress" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ValidatePin" Disabled="_isProcessing" Class="mt-3">
            @if (_isProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Validating...</span>
            }
            else
            {
                <span>Confirm</span>
            }
        </MudButton>
    </MudPaper>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Fiscal Printers</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Add Printer
            </MudButton>
        </div>

        <MudPaper Class="pa-2 mb-2" Outlined="true">
            <MudTextField T="string"
                          @bind-Value="_searchTerm"
                          Placeholder="Search printers..."
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="@HandleKeyDown"
                          Clearable="true"
                          OnClearButtonClick="LoadPrinters"
                          Margin="Margin.Dense" />
        </MudPaper>

        <MudTable T="PrinterDto" Items="@_printers" Hover="true" Striped="true" Outlined="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Fiscal Device Type</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="printer">
                <MudTd DataLabel="Name">@printer.Name</MudTd>
                <MudTd DataLabel="Type">@printer.PrinterType</MudTd>
                <MudTd DataLabel="Fiscal Device Type">@(printer.FiscalDeviceType ?? "-")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@(printer.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                        @(printer.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(printer))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePrinter(printer))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-3">No printers found.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudContainer>

    <MudDialog @bind-Visible="_isDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
        <TitleContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                <MudIcon Icon="@(_isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
                @(_isEditMode ? "Edit Printer" : "Add Printer")
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
                <MudGrid Spacing="2" Class="py-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Name" Variant="Variant.Outlined" @bind-Value="_editingPrinter.Name" Required="true" For="@(() => _editingPrinter.Name)" Margin="Margin.Dense" Style="font-size: 0.8rem;" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Printer Type" Variant="Variant.Outlined" @bind-Value="_editingPrinter.PrinterType" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;">
                            @foreach (var type in Enum.GetNames(typeof(PrinterType)))
                            {
                                <MudSelectItem T="string" Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                        <MudSwitch @bind-Value="_editingPrinter.IsActive" Color="Color.Primary" Label="Active" Dense="true" Style="font-size: 0.75rem;" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex align-center ps-1">
                        <MudSwitch @bind-Value="_editingPrinter.IsDefault" Color="Color.Primary" Label="Default Printer" Dense="true" Style="font-size: 0.75rem;" />
                    </MudItem>

                    @if (_editingPrinter.PrinterType == "Fiscal")
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2 font-weight-bold">Fiscal Device Configuration</MudText>
                            <MudSelect T="string" Label="Fiscal Device Type" Variant="Variant.Outlined" @bind-Value="_editingPrinter.FiscalDeviceType" AnchorOrigin="Origin.BottomLeft" Margin="Margin.Dense" Style="font-size: 0.8rem;" Required="true">
                                <MudSelectItem T="string" Value="@("FiscalCloud")">FiscalCloud</MudSelectItem>
                                <MudSelectItem T="string" Value="@("ISFiscalCloud")">IS Fiscal Cloud</MudSelectItem>
                                <MudSelectItem T="string" Value="@("SLFiscalRegister")">SL Fiscal Register</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Filled">
                                <MudText Typo="Typo.caption">
                                    <strong>Note:</strong> Use the "Configure" button below to set device-specific settings for the selected fiscal device type.
                                </MudText>
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenConfigureDialog" Size="Size.Small">
                                Configure @_editingPrinter.FiscalDeviceType
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseDialog" Size="Size.Small">Cancel</MudButton>
            @if (_isEditMode && _editingPrinter.PrinterType == "Fiscal" && !string.IsNullOrEmpty(_editingPrinter.ApiKey))
            {
                <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="TestFiscalCloudConnection" Size="Size.Small" Disabled="@_isTestingConnection">
                    @if (_isTestingConnection)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <text>Testing...</text>
                    }
                    else
                    {
                        <text>Test Connection</text>
                    }
                </MudButton>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SavePrinter())" Disabled="@(!_formIsValid)" Size="Size.Small">Save</MudButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_isConfigureDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
        <TitleContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                Configure @_editingPrinter.FiscalDeviceType
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @ref="_configureForm" @bind-IsValid="@_configureFormIsValid">
                <MudGrid Spacing="2" Class="py-1">
                    @switch (_editingPrinter.FiscalDeviceType)
                    {
                        case "FiscalCloud":
                        case "ISFiscalCloud":
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Filled">
                                        <MudText Typo="Typo.caption">
                                            <strong>Required:</strong> Obtain credentials from your @_editingPrinter.FiscalDeviceType portal.<br/>
                                            <strong>Default URL:</strong> http://localhost:50700 (local agent)<br/>
                                            <strong>Note:</strong> Replace placeholder values (YOUR_API_KEY, etc.) with actual credentials.
                                        </MudText>
                                    </MudAlert>
                                    <MudDivider />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="API Key" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ApiKey" Margin="Margin.Dense" Style="font-size: 0.8rem;" Required="true" HelperText="Get from FiscalCloud portal" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="API Secret" Variant="Variant.Outlined" @bind-Value="_editingPrinter.ApiSecret" InputType="InputType.Password" Margin="Margin.Dense" Style="font-size: 0.8rem;" Required="true" HelperText="Get from FiscalCloud portal" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="Device ID (GUID)" Variant="Variant.Outlined" @bind-Value="_editingPrinter.DeviceId" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="00000000-0000-0000-0000-000000000000" Required="true" HelperText="Device GUID from FiscalCloud" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="Point of Sale ID (GUID)" Variant="Variant.Outlined" @bind-Value="_editingPrinter.PointOfSaleId" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="Optional" HelperText="Optional POS identifier" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Label="Base URL" Variant="Variant.Outlined" @bind-Value="_editingPrinter.FiscalCloudBaseUrl" Margin="Margin.Dense" Style="font-size: 0.8rem;" Placeholder="http://localhost:50700" HelperText="Default: http://localhost:50700 (local agent)" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Wifi" OnClick="TestFiscalCloudConnectionFromModal" Size="Size.Small" Disabled="@_isTestingConnection">
                                        @if (_isTestingConnection)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <text>Testing...</text>
                                        }
                                        else
                                        {
                                            <text>Test Connection</text>
                                        }
                                    </MudButton>
                                </MudItem>
                                break;
                            }
                        case "SLFiscalRegister":
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Filled">
                                        <MudText Typo="Typo.body2">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                            <strong>Configuration Not Available:</strong> SL Fiscal Register device configuration is pending documentation. 
                                            Please check back later or contact support for setup instructions.
                                        </MudText>
                                    </MudAlert>
                                </MudItem>
                                break;
                            }
                        default:
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Filled">
                                        <MudText Typo="Typo.body2">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                            Select a Fiscal Device Type to configure device-specific settings.
                                        </MudText>
                                    </MudAlert>
                                </MudItem>
                                break;
                            }
                    }
                </MudGrid>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseConfigureDialog" Size="Size.Small">Close</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveConfigureDialog" Disabled="@(!_configureFormIsValid)" Size="Size.Small">Save Configuration</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private IEnumerable<PrinterDto> _printers = new List<PrinterDto>();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _isDialogOpen = false;
    private bool _isEditMode = false;
    private bool _formIsValid = false;
    private bool _isTestingConnection = false;
    private MudForm? _form;

    // Configure dialog
    private bool _isConfigureDialogOpen = false;
    private bool _configureFormIsValid = false;
    private MudForm? _configureForm;

    private PrinterFormModel _editingPrinter = new();

    private string _pin = string.Empty;
    private string? _error;
    private bool _isProcessing = false;
    private bool _dataLoaded = false;

    protected override async Task OnParametersSetAsync()
    {
        if ((PosAuthState.IsManager || PosAuthState.IsAdmin) && !_dataLoaded)
        {
            await LoadPrinters();
            _dataLoaded = true;
        }
    }

    private async Task LoadPrinters()
    {
        _isLoading = true;
        try
        {
            var cachedPrinters = await PrinterService.GetCachedAsync();
            _printers = FilterPrinters(cachedPrinters);

            try
            {
                var refreshedPrinters = await PrinterService.RefreshAsync(PosAuthState.StoreId);
                _printers = FilterPrinters(refreshedPrinters);
            }
            catch (HttpRequestException)
            {
                Snackbar.Add("Server unavailable. Showing locally cached printers.", Severity.Warning);
            }
            catch (TaskCanceledException)
            {
                Snackbar.Add("Server request timed out. Showing locally cached printers.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading printers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<PrinterDto> FilterPrinters(IEnumerable<PrinterDto> printers) =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? printers
            : printers.Where(p => p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadPrinters();
    }

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _editingPrinter = new PrinterFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(PrinterDto printer)
    {
        _isEditMode = true;
        _editingPrinter = new PrinterFormModel
        {
            Id = printer.Id,
            Name = printer.Name,
            PrinterType = printer.PrinterType,
            FiscalDeviceType = printer.FiscalDeviceType,
            IsDefault = printer.IsDefault,
            IsActive = printer.IsActive,
            ApiKey = printer.ApiKey,
            ApiSecret = printer.ApiSecret,
            DeviceId = printer.DeviceId,
            PointOfSaleId = printer.PointOfSaleId,
            FiscalCloudBaseUrl = printer.FiscalCloudBaseUrl
        };
        _isDialogOpen = true;
    }

    private void OpenConfigureDialog()
    {
        _isConfigureDialogOpen = true;
    }

    private void CloseConfigureDialog()
    {
        _isConfigureDialogOpen = false;
    }

    private async Task SaveConfigureDialog()
    {
        // The fields are already bound to _editingPrinter, so just close
        CloseConfigureDialog();
    }

    private async Task SavePrinter(bool closeDialog = true)
    {
        try
        {
            // Validate FiscalCloud fields for Fiscal printers
            if (_editingPrinter.PrinterType == "Fiscal")
            {
                var missingFields = new List<string>();
                if (string.IsNullOrWhiteSpace(_editingPrinter.FiscalDeviceType))
                {
                    missingFields.Add("Fiscal Device Type");
                }

                if (missingFields.Count > 0)
                {
                    Snackbar.Add($"Fiscal printer requires: {string.Join(", ", missingFields)}.", Severity.Error);
                    return;
                }

                // Validate FiscalCloud/ISFiscalCloud fields if selected
                if (_editingPrinter.FiscalDeviceType is "FiscalCloud" or "ISFiscalCloud")
                {
                    var missingFiscalFields = new List<string>();
                    if (string.IsNullOrWhiteSpace(_editingPrinter.ApiKey)) missingFiscalFields.Add("API Key");
                    if (string.IsNullOrWhiteSpace(_editingPrinter.ApiSecret)) missingFiscalFields.Add("API Secret");
                    if (string.IsNullOrWhiteSpace(_editingPrinter.DeviceId)) missingFiscalFields.Add("Device ID");

                    if (missingFiscalFields.Count > 0)
                    {
                        Snackbar.Add($"Fiscal printer ({_editingPrinter.FiscalDeviceType}) requires: {string.Join(", ", missingFiscalFields)}. Get these from your portal.", Severity.Error);
                        return;
                    }

                    // Check for placeholder values
                    var placeholderFields = new List<string>();
                    if (_editingPrinter.ApiKey?.Contains("YOUR_") == true) placeholderFields.Add("API Key");
                    if (_editingPrinter.ApiSecret?.Contains("YOUR_") == true) placeholderFields.Add("API Secret");
                    if (_editingPrinter.DeviceId?.Contains("YOUR_") == true) placeholderFields.Add("Device ID");
                    if (_editingPrinter.PointOfSaleId?.Contains("YOUR_") == true) placeholderFields.Add("Point of Sale ID");

                    if (placeholderFields.Count > 0)
                    {
                        Snackbar.Add($"Please replace placeholder values for: {string.Join(", ", placeholderFields)} with actual credentials.", Severity.Warning);
                    }
                }
            }

            if (_isEditMode)
            {
                var request = new UpdatePrinterRequest(
                    _editingPrinter.Id,
                    _editingPrinter.Name,
                    _editingPrinter.PrinterType,
                    _editingPrinter.FiscalDeviceType,
                    _editingPrinter.IsDefault,
                    _editingPrinter.IsActive,
                    _editingPrinter.ApiKey,
                    _editingPrinter.ApiSecret,
                    _editingPrinter.DeviceId,
                    _editingPrinter.PointOfSaleId,
                    _editingPrinter.FiscalCloudBaseUrl);
                await PrinterService.UpdateAsync(request);
                Snackbar.Add("Printer updated successfully.", Severity.Success);
            }
            else
            {
                var request = new CreatePrinterRequest(
                    _editingPrinter.Name,
                    _editingPrinter.PrinterType,
                    _editingPrinter.FiscalDeviceType,
                    _editingPrinter.IsDefault,
                    _editingPrinter.IsActive,
                    _editingPrinter.ApiKey,
                    _editingPrinter.ApiSecret,
                    _editingPrinter.DeviceId,
                    _editingPrinter.PointOfSaleId,
                    _editingPrinter.FiscalCloudBaseUrl);
                var created = await PrinterService.CreateAsync(request);
                // Keep editing the newly created printer so subsequent actions (e.g. test) target it
                _editingPrinter.Id = created.Id;
                _isEditMode = true;
                Snackbar.Add("Printer created successfully.", Severity.Success);
            }
            await LoadPrinters();
            if (closeDialog)
            {
                CloseDialog();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving printer: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestFiscalCloudConnection()
    {
        _isTestingConnection = true;
        try
        {
            // First, save the current changes so we test what the user just entered
            await SavePrinter(closeDialog: false);

            if (string.IsNullOrWhiteSpace(_editingPrinter.ApiKey) ||
                string.IsNullOrWhiteSpace(_editingPrinter.ApiSecret) ||
                string.IsNullOrWhiteSpace(_editingPrinter.DeviceId))
            {
                Snackbar.Add("FiscalCloud credentials (Api Key, Api Secret, Device Id) are required.", Severity.Warning);
                return;
            }

            var printer = new ZEN.Domain.Entities.Printer
            {
                Id = _editingPrinter.Id,
                ApiKey = _editingPrinter.ApiKey,
                ApiSecret = _editingPrinter.ApiSecret,
                DeviceId = _editingPrinter.DeviceId,
                PointOfSaleId = _editingPrinter.PointOfSaleId,
                FiscalCloudBaseUrl = _editingPrinter.FiscalCloudBaseUrl
            };

            var effectiveUrl = string.IsNullOrWhiteSpace(printer.FiscalCloudBaseUrl)
                ? "http://localhost:50700 (default)"
                : printer.FiscalCloudBaseUrl;

            var status = await FiscalCloudService.GetStatusAsync(printer);

            if (status.IsOnline && status.IsConnected)
            {
                Snackbar.Add($"FiscalCloud connection successful at {effectiveUrl}.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"FiscalCloud connection FAILED at {effectiveUrl}: {status.ErrorMessage ?? status.DeviceStatus ?? "unknown error"}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error testing connection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTestingConnection = false;
        }
    }

    private async Task TestFiscalCloudConnectionFromModal()
    {
        _isTestingConnection = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_editingPrinter.ApiKey) ||
                string.IsNullOrWhiteSpace(_editingPrinter.ApiSecret) ||
                string.IsNullOrWhiteSpace(_editingPrinter.DeviceId))
            {
                Snackbar.Add("FiscalCloud credentials (Api Key, Api Secret, Device Id) are required.", Severity.Warning);
                return;
            }

            var printer = new ZEN.Domain.Entities.Printer
            {
                Id = _editingPrinter.Id,
                ApiKey = _editingPrinter.ApiKey,
                ApiSecret = _editingPrinter.ApiSecret,
                DeviceId = _editingPrinter.DeviceId,
                PointOfSaleId = _editingPrinter.PointOfSaleId,
                FiscalCloudBaseUrl = _editingPrinter.FiscalCloudBaseUrl
            };

            var effectiveUrl = string.IsNullOrWhiteSpace(printer.FiscalCloudBaseUrl)
                ? "http://localhost:50700 (default)"
                : printer.FiscalCloudBaseUrl;

            var status = await FiscalCloudService.GetStatusAsync(printer);

            if (status.IsOnline && status.IsConnected)
            {
                Snackbar.Add($"FiscalCloud connection successful at {effectiveUrl}.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"FiscalCloud connection FAILED at {effectiveUrl}: {status.ErrorMessage ?? status.DeviceStatus ?? "unknown error"}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error testing connection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTestingConnection = false;
        }
    }

    private async Task DeletePrinter(PrinterDto printer)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Delete printer '{printer.Name}'?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            "Delete Printer",
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                if (await PrinterService.DeleteAsync(printer.Id))
                {
                    Snackbar.Add("Printer deleted successfully.", Severity.Success);
                    await LoadPrinters();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting printer: {ex.Message}", Severity.Error);
            }
        }
    }

    private void CloseDialog() => _isDialogOpen = false;

    private async Task HandlePinKeyPress(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ValidatePin();
    }

    private async Task ValidatePin()
    {
        if (_isProcessing) return;

        _error = null;
        _isProcessing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (_pin == "3333" || _pin == "1234")
            {
                var role = _pin == "3333" ? PosRoles.Manager : PosRoles.Administrator;
                PosAuthState.SignIn(PosAuthState.UserName ?? "user@zen.pos", role);
                await LoadPrinters();
                _dataLoaded = true;
            }
            else
            {
                _error = "Invalid PIN. Enter Manager PIN (3333) or Admin PIN (1234).";
            }
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class PrinterFormModel
    {
        public Guid Id { get; set; }

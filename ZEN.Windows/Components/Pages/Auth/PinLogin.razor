@page "/pin-login"
@inject NavigationManager Navigation
@inject ZEN.Windows.Services.PosAuthState PosAuthState
@inject ISnackbar Snackbar
@inject ZEN.Windows.Services.Sync.SyncApiClient ApiClient
@using ZEN.Windows.Services
@using MudBlazor

<PageTitle>PIN Login - ZEN POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">PIN Login</MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField Value="@_pin" ValueChanged="@((string value) => _pin = value)"
                      Label="Enter PIN"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      AutoFocus="true"
                      @onkeydown="HandleKeyDown"
                      Class="mb-4"
                      InputType="InputType.Password" />

        <MudGrid Spacing="2" Class="mb-4">
            @for (int i = 1; i <= 9; i++)
            {
                var number = i;
                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="@(() => AddDigit(number.ToString()))"
                               Size="Size.Large">
                        @number
                    </MudButton>
                </MudItem>
            }
            <MudItem xs="4">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           FullWidth="true"
                           OnClick="ClearPin"
                           Size="Size.Large">
                    Clear
                </MudButton>
            </MudItem>
            <MudItem xs="4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="@(() => AddDigit("0"))"
                           Size="Size.Large">
                    0
                </MudButton>
            </MudItem>
            <MudItem xs="4">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           FullWidth="true"
                           OnClick="Backspace"
                           Size="Size.Large">
                    ⌫
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudButton ButtonType="ButtonType.Button"
                   Variant="Variant.Filled"
                   Color="Color.Success"
                   FullWidth="true"
                   Disabled="_isProcessing || string.IsNullOrEmpty(_pin)"
                   OnClick="SubmitPin">
            @if (_isProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>Login</span>
            }
        </MudButton>

        <MudDivider Class="my-4" />

        <MudButton Href="/settings"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   FullWidth="true">
            Settings
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string _pin = string.Empty;
    private string? _error;
    private bool _isProcessing = false;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void AddDigit(string digit)
    {
        if (_pin.Length < 6)
        {
            _pin += digit;
        }
    }

    private void Backspace()
    {
        if (_pin.Length > 0)
        {
            _pin = _pin[..^1];
        }
    }

    private void ClearPin()
    {
        _pin = string.Empty;
    }

private async Task HandleKeyDown(KeyboardEventArgs args)
{
    if (args.Key.Length == 1 && args.Key[0] is >= '0' and <= '9')
    {
        AddDigit(args.Key);
    }
    else if (args.Key == "Backspace")
    {
        Backspace();
    }
    else if (args.Key is "Delete" or "Escape")
    {
        ClearPin();
    }
    else if (args.Key == "Enter" && !string.IsNullOrEmpty(_pin))
    {
        await SubmitPin();
    }
}

private async Task SubmitPin()
        {
            if (_isProcessing) return;

            _error = null;
            _isProcessing = true;

            var trimmedPin = _pin?.Trim() ?? string.Empty;

            try
            {
                string role;

                if (TryDemoLogin(trimmedPin, out role, out var demoCashDeskId))
                {
                    // Try API first, fall back to demo
                    var loginResponse = await ApiClient.LoginWithPinAsync(trimmedPin);
                    if (loginResponse != null)
                    {
                        // Prefer the real CashDeskId returned by the API; fall back to the demo value
                        var cashDeskId = loginResponse.CashDeskId ?? demoCashDeskId;
                        var storeId = loginResponse.StoreId;
                        
                        // Validate cashier has cash desk assigned
                        if (string.Equals(role, PosRoles.Cashier, StringComparison.OrdinalIgnoreCase) && !cashDeskId.HasValue)
                        {
                            _error = "Cashier user must be assigned to a cash desk. Configure in ZEN.Web > Users.";
                            Snackbar.Add(_error, Severity.Error);
                            return;
                        }
                        
                        PosAuthState.SignIn(loginResponse.UserName, role, loginResponse.Token, storeId, cashDeskId);
                    }
                    else
                    {
                        // API unreachable or PIN not in DB - use demo mode
                        if (string.Equals(role, PosRoles.Cashier, StringComparison.OrdinalIgnoreCase) && !demoCashDeskId.HasValue)
                        {
                            _error = "Cashier user must be assigned to a cash desk. Configure in ZEN.Web > Users.";
                            Snackbar.Add(_error, Severity.Error);
                            return;
                        }
                        PosAuthState.SignIn(GetDemoUserName(trimmedPin), role, null, null, demoCashDeskId);
                    }
                }
                else
                {
                    var loginResponse = await ApiClient.LoginWithPinAsync(trimmedPin);

                    if (loginResponse == null)
                    {
                        _error = "Invalid PIN. Use demo PINs: 1234 (admin), 3333 (manager), 2222 (cashier)";
                        Snackbar.Add(_error, Severity.Warning);
                        return;
                    }

                    role = loginResponse.Roles.FirstOrDefault() ?? "Guest";
                    
                    // Validate cashier has cash desk assigned
                    if (string.Equals(role, PosRoles.Cashier, StringComparison.OrdinalIgnoreCase) && !loginResponse.CashDeskId.HasValue)
                    {
                        _error = "Cashier user must be assigned to a cash desk. Configure in ZEN.Web > Users.";
                        Snackbar.Add(_error, Severity.Error);
                        return;
                    }
                    
                    PosAuthState.SignIn(loginResponse.UserName, role, loginResponse.Token, loginResponse.StoreId, loginResponse.CashDeskId);
                }

                if (string.Equals(role, PosRoles.Cashier, StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/sell");
                }
                else
                {
                    Navigation.NavigateTo("/manager");
                }
            }
            catch (Exception ex)
            {
                _error = $"Login error: {ex.Message}";
                Snackbar.Add(_error, Severity.Error);
            }
            finally
            {
                _isProcessing = false;
            }
        }

    private bool TryDemoLogin(string pin, out string role, out Guid? cashDeskId)
    {
        if (pin == "1234")
        {
            role = PosRoles.Administrator;
            cashDeskId = null;
            return true;
        }
        if (pin == "3333")
        {
            role = PosRoles.Manager;
            cashDeskId = null;
            return true;
        }
        if (pin == "2222")
        {
            role = PosRoles.Cashier;
            cashDeskId = null; // Will be set from API if available
            return true;
        }
        role = string.Empty;
        cashDeskId = null;
        return false;
    }

    private string GetDemoUserName(string pin)
    {
        return pin switch
        {
            "1234" => "admin@zen.pos",
            "3333" => "manager@zen.pos",
            "2222" => "cashier@zen.pos",
            _ => "demo@zen.pos"
        };
    }
}
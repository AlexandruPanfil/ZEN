@page "/"
@page "/pin-login"
@inject NavigationManager Navigation
@inject ZEN.Windows.Services.PosAuthState PosAuthState

<PageTitle>PIN Login - ZEN POS</PageTitle>

<div style="max-width:360px;margin:60px auto;padding:16px;border:1px solid #ddd;border-radius:8px;">
    <h3>PIN Login</h3>
    <p style="font-size:.85rem;color:#666;">Demo: admin PIN `1234`, cashier PIN `2222`</p>

    <input type="password" @bind="_pin" maxlength="6" style="width:100%;padding:8px;margin-top:12px;" placeholder="Enter PIN" />
    <button @onclick="SubmitPin" style="margin-top:12px;padding:8px 12px;">Login</button>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p style="color:#b00020;margin-top:10px;">@_error</p>
    }
</div>

@code {
    private string _pin = string.Empty;
    private string? _error;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && PosAuthState.IsAuthenticated)
            Navigation.NavigateTo("/sell");
    }

    private void SubmitPin()
    {
        _error = null;

        if (_pin == "1234")
        {
            PosAuthState.SignIn("admin@zen.pos", ZEN.Windows.Services.PosRoles.Administrator);
            Navigation.NavigateTo("/sell");
            return;
        }

        if (_pin == "2222")
        {
            PosAuthState.SignIn("cashier@zen.pos", ZEN.Windows.Services.PosRoles.Cashier);
            Navigation.NavigateTo("/sell");
            return;
        }

        _error = "Invalid PIN.";
    }
}

@page "/"
@page "/pin-login"
@inject NavigationManager Navigation
@inject ZEN.Windows.Services.PosAuthState PosAuthState
@inject ISnackbar Snackbar
@inject ZEN.Windows.Services.Sync.SyncApiClient ApiClient
@inject ZEN.Windows.Services.ServerSettingsService SettingsService
@using ZEN.Windows.Services
@using MudBlazor

<PageTitle>PIN Login - ZEN POS</PageTitle>

<MudPaper Class="pa-4" Elevation="4" MaxWidth="400px" Style="margin: 2rem auto;">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h4">PIN Login</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                        OnClick="OpenSettings" />
    </MudStack>
    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
        Demo: admin PIN <code>1234</code>, manager PIN <code>3333</code>, cashier PIN <code>2222</code>
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">Server: @SettingsService.ApiBaseUrl</MudText>

    <MudTextField @bind-Value="_pin"
                 Label="PIN"
                 InputType="InputType.Password"
                 MaxLength="6"
                 Variant="Variant.Filled"
                 Class="mb-4"
                 @onkeypress="HandleKeyPress" />

    <MudButton ButtonType="ButtonType.Button"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               FullWidth="true"
               Disabled="_isProcessing"
               OnClick="SubmitPin">
        @if (_isProcessing)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Logging in...</span>
        }
        else
        {
            <span>Login</span>
        }
    </MudButton>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _pin = string.Empty;
    private string? _error;
    private bool _isProcessing = false;
    
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleKeyPress(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SubmitPin();
    }

    private async Task SubmitPin()
    {
        if (_isProcessing) return;

        _error = null;
        _isProcessing = true;
        StateHasChanged();

        var trimmedPin = _pin?.Trim() ?? string.Empty;
        
        try
        {
            string role;
            
            if (TryDemoLogin(trimmedPin, out role))
            {
                PosAuthState.SignIn(GetDemoUserName(trimmedPin), role);
            }
            else
            {
                var loginResponse = await ApiClient.LoginWithPinAsync(trimmedPin);
                
                if (loginResponse == null)
                {
                    _error = "Invalid PIN. Use demo PINs: 1234 (admin), 3333 (manager), 2222 (cashier)";
                    Snackbar.Add(_error, Severity.Warning);
                    return;
                }

                role = loginResponse.Roles.FirstOrDefault() ?? "Guest";
                ApiClient.SetBearerToken(loginResponse.Token);
                PosAuthState.SignIn(loginResponse.UserName, role, loginResponse.Token, loginResponse.StoreId, loginResponse.CashDeskId);
            }

            // Ensure state is updated before navigation
            StateHasChanged();
            await InvokeAsync(StateHasChanged);
            
            if (string.Equals(role, PosRoles.Cashier, StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/sell");
            }
            else
            {
                Navigation.NavigateTo("/manager");
            }
        }
        catch (Exception ex)
        {
            _error = $"Login error: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private bool TryDemoLogin(string pin, out string role)
    {
        if (pin == "1234")
        {
            role = PosRoles.Administrator;
            return true;
        }
        if (pin == "3333")
        {
            role = PosRoles.Manager;
            return true;
        }
        if (pin == "2222")
        {
            role = PosRoles.Cashier;
            return true;
        }
        role = string.Empty;
        return false;
    }

    private string GetDemoUserName(string pin)
    {
        return pin switch
        {
            "1234" => "admin@zen.pos",
            "3333" => "manager@zen.pos",
            "2222" => "cashier@zen.pos",
            _ => "demo@zen.pos"
        };
    }

    private void OpenSettings()
    {
        Navigation.NavigateTo("/settings");
    }
}
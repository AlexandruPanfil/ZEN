@page "/admin/settings"
@inject ZEN.Windows.Services.PosAuthState PosAuthState

<h1>Settings</h1>

@if (!PosAuthState.IsAuthenticated)
{
    <p>Please login first.</p>
}
else if (!PosAuthState.IsAdmin)
{
    <p>Access denied. Administrator only.</p>
}
else
{
    <p>Manage store and system settings here.</p>
}

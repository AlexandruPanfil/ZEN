@using MudBlazor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ZEN.Windows.Services.PosAuthState PosAuthState
@inject ZEN.Windows.Services.Sync.SyncApiClient ApiClient
@implements IDisposable

<MudNavMenu>
    @if (PosAuthState.IsAuthenticated)
    {
        <MudNavLink Href="home" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
            Home
        </MudNavLink>

        <MudNavGroup Title="Sales" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
            <MudNavLink Href="sell" Icon="@Icons.Material.Filled.ShoppingCart">POS</MudNavLink>
            <MudNavLink Href="shifts" Icon="@Icons.Material.Filled.Schedule">Shifts</MudNavLink>
            <MudNavLink Href="held-sales" Icon="@Icons.Material.Filled.Pause">Held Sales</MudNavLink>
        </MudNavGroup>

        @if (PosAuthState.IsAdmin || PosAuthState.IsManager)
        {
            <MudNavGroup Title="Products" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
                <MudNavLink Href="admin/products" Icon="@Icons.Material.Filled.Category">Products</MudNavLink>
                <MudNavLink Href="admin/taxes" Icon="@Icons.Material.Filled.Percent">Taxes</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Inventory" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
                <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Inventory2">Stock</MudNavLink>
                <MudNavLink Href="stock-purchases" Icon="@Icons.Material.Filled.ReceiptLong">Stock Purchase</MudNavLink>
                <MudNavLink Href="warehouses" Icon="@Icons.Material.Filled.Store">Warehouses</MudNavLink>
                <MudNavLink Href="purchase-orders" Icon="@Icons.Material.Filled.ShoppingBag">Purchase Orders</MudNavLink>
                <MudNavLink Href="stock-transfers" Icon="@Icons.Material.Filled.LocalShipping">Stock Transfer</MudNavLink>
                <MudNavLink Href="inventory-counts" Icon="@Icons.Material.Filled.Checklist">Counts</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Reports" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
                <MudNavLink Href="manager/reports" Icon="@Icons.Material.Filled.TrendingUp">Sales Reports</MudNavLink>
                <MudNavLink Href="reports/inventory" Icon="@Icons.Material.Filled.Inventory">Inventory Reports</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Users</MudNavLink>
                <MudNavLink Href="admin/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">Roles</MudNavLink>
                <MudNavLink Href="admin/stores" Icon="@Icons.Material.Filled.Storefront">Stores</MudNavLink>
                <MudNavLink Href="admin/settings" Icon="@Icons.Material.Filled.Tune">Settings</MudNavLink>
                <MudNavLink Href="admin/audit-logs" Icon="@Icons.Material.Filled.History">Audit Logs</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Equipment" Icon="@Icons.Material.Filled.SettingsInputComponent" Expanded="false">
                <MudNavLink Href="equipments/printers" Icon="@Icons.Material.Filled.Print">Printers</MudNavLink>
                <MudNavLink Href="manager/equipments/terminals" Icon="@Icons.Material.Filled.Payment">Payment Terminals</MudNavLink>
                <MudNavLink Href="equipments/scanners" Icon="@Icons.Material.Filled.QrCodeScanner">Scanners</MudNavLink>
                <MudNavLink Href="equipments/customer-displays" Icon="@Icons.Material.Filled.DisplaySettings">Customer Displays</MudNavLink>
                 <MudNavLink Href="manager/equipments/cash-desks" Icon="@Icons.Material.Filled.PointOfSale">Cash Desks</MudNavLink>
                <MudNavLink Href="manager/equipments/cash-desk-menus" Icon="@Icons.Material.Filled.MenuBook">Cash Desk Menus</MudNavLink>
            </MudNavGroup>
        }

        <MudDivider Class="my-2" />

        <MudPaper Class="pa-2" Elevation="0">
            <MudButton Variant="Variant.Text" FullWidth="true" OnClick="Logout">Logout</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-2" Elevation="0">
            <MudButton Variant="Variant.Text" FullWidth="true" OnClick="GoToLogin">PIN Login</MudButton>
        </MudPaper>
    }
</MudNavMenu>

@code {
    private void GoToLogin() => Navigation.NavigateTo("/");

    private void Logout()
    {
        ApiClient.SetBearerToken(null);
        PosAuthState.SignOut();
        Snackbar.Add("Logged out successfully", Severity.Info);
        Navigation.NavigateTo("/");
    }

    protected override void OnInitialized()
    {
        PosAuthState.Changed += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PosAuthState.Changed -= OnAuthStateChanged;
    }
}
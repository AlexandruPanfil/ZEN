<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ZEN POS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (PosAuthState.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="home">Home</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sell">Sell</NavLink>
            </div>

            @if (PosAuthState.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/products">Products</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/equipments">Equipments</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/settings">Settings</NavLink>
                </div>
            }
        }

        <div class="nav-item px-3 mt-auto">
            <MudDivider Class="my-2" />
            @if (PosAuthState.IsAuthenticated)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" Class="nav-link text-danger">
                    Logout
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Lock" OnClick="GoToLogin" Class="nav-link">
                    PIN Login
                </MudButton>
            }
        </div>
    </nav>
</div>

@code {
    @inject NavigationManager Navigation
    @inject ISnackbar Snackbar
    @inject ZEN.Windows.Services.PosAuthState PosAuthState

    private void GoToLogin() => Navigation.NavigateTo("/pin-login");

    private void Logout()
    {
        PosAuthState.SignOut();
        Snackbar.Add("Logged out successfully", Severity.Info);
        Navigation.NavigateTo("/pin-login");
    }
}

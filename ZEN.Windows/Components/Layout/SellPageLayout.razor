@using MudBlazor

<div class="sell-page-layout @Class">
    <div class="sell-main-content">
        <MudPaper Elevation="2" Class="sell-sidebar">
            @SidebarContent
        </MudPaper>
        <div class="sell-content pa-3">
            @ChildContent
        </div>
    </div>

    <MudPaper Elevation="1" Class="sell-footer">
        @FooterContent
    </MudPaper>
</div>

@code {
    [Parameter] public string? UserName { get; set; }
    [Parameter] public RenderFragment? SidebarContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    [Parameter] public EventCallback OnSwitchToManager { get; set; }
    [Parameter] public string? Class { get; set; }
}
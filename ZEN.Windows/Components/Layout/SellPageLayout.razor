@using MudBlazor

<div class="sell-page-layout">
    <MudAppBar Color="Color.Primary" Fixed="false" Dense="true" Class="sell-header">
        <MudText Typo="Typo.h6" Class="ml-2">ZEN POS</MudText>
        <MudSpacer />
        @if (!string.IsNullOrEmpty(UserName))
        {
            <MudText Typo="Typo.body2" Class="mr-2">@UserName</MudText>
        }
        <MudIconButton Icon="@Icons.Material.Filled.SwitchAccount" Color="Color.Inherit" OnClick="OnSwitchToManager" />
    </MudAppBar>

    <div class="sell-main-content">
        <MudPaper Elevation="2" Class="sell-sidebar pa-3">
            @SidebarContent
        </MudPaper>
        <div class="sell-content pa-3">
            @ChildContent
        </div>
    </div>

    <MudPaper Elevation="1" Class="sell-footer">
        @FooterContent
    </MudPaper>
</div>

@code {
    [Parameter] public string? UserName { get; set; }
    [Parameter] public RenderFragment? SidebarContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    [Parameter] public EventCallback OnSwitchToManager { get; set; }
}